---
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-name" aria-hidden="true">
      <svg class="name-svg" viewBox="0 -5 555 105" preserveAspectRatio="xMidYMid meet" width="100%">
        <text x="0" y="85" font-family="'Instrument Serif', serif" font-size="105" letter-spacing="-2" fill="currentColor">Devin Alexander</text>
      </svg>
    </div>

    <div class="footer-meta">
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/work" class:list={['footer-link', { active: currentPath.startsWith('/work') }]}>Work</a>
        <a href="/about" class:list={['footer-link', { active: currentPath.startsWith('/about') }]}>About</a>
        <a href="/journal" class:list={['footer-link', { active: currentPath.startsWith('/journal') }]}>Journal</a>
        <a href="/contact" class:list={['footer-link', { active: currentPath.startsWith('/contact') }]}>Contact</a>
      </nav>

      <div class="footer-info">
        <span class="footer-copyright">&copy; {year}</span>
        <span class="footer-dot" aria-hidden="true">&middot;</span>
        <span class="footer-domain">devin.vc</span>
      </div>

      <button class="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" aria-label="Back to top">
        <span class="top-label">Back to top</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="10" x2="6" y2="2" />
          <polyline points="2.5,5.5 6,2 9.5,5.5" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-bg);
    padding: 0 clamp(1.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---- Giant single-line name pinned to bottom ---- */
  .footer-name {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    color: var(--color-text);
    opacity: 0.035;
    user-select: none;
    pointer-events: none;
    line-height: 0;
  }

  .name-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---- Meta row ---- */
  .footer-meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: clamp(4rem, 10vw, 8rem);
  }

  .footer-nav {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-link:hover,
  .footer-link.active {
    color: var(--color-accent);
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-copyright,
  .footer-domain {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .footer-dot {
    color: var(--color-text-muted);
    opacity: 0.3;
    font-size: 0.65rem;
  }

  .footer-domain {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    letter-spacing: 0;
    font-size: 0.8rem;
  }

  .back-to-top {
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    color: var(--color-text-muted);
    opacity: 0.5;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-to-top:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .top-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .footer-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>

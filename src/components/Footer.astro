---
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-name" aria-hidden="true">
      <svg class="name-svg" viewBox="0 -5 720 110" preserveAspectRatio="xMidYMid meet" width="100%">
        <text
          x="0"
          y="88"
          font-size="105"
          letter-spacing="-3"
          textLength="720"
          lengthAdjust="spacingAndGlyphs"
          fill="currentColor"
        >Devin Alexander</text>
      </svg>
    </div>

    <div class="footer-meta">
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/work" class:list={['footer-link', { active: currentPath.startsWith('/work') }]}>Work</a>
        <a href="/projects" class:list={['footer-link', { active: currentPath.startsWith('/projects') }]}>Projects</a>
        <a href="/tools" class:list={['footer-link', { active: currentPath.startsWith('/tools') }]}>Tools</a>
        <a href="/about" class:list={['footer-link', { active: currentPath.startsWith('/about') }]}>About</a>
        <a href="/journal" class:list={['footer-link', { active: currentPath.startsWith('/journal') }]}>Journal</a>
        <a href="/training" class:list={['footer-link', { active: currentPath.startsWith('/training') }]}>Training</a>
        <a href="/contact" class:list={['footer-link', { active: currentPath.startsWith('/contact') }]}>Contact</a>
      </nav>

      <div class="footer-info">
        <span class="footer-copyright">&copy; {year}</span>
        <span class="footer-dot" aria-hidden="true">&middot;</span>
        <span class="footer-domain">devin.vc</span>
        <span class="footer-dot" aria-hidden="true">&middot;</span>
        <a href="/privacy" class="footer-legal">Privacy</a>
        <span class="footer-dot" aria-hidden="true">&middot;</span>
        <a href="/terms" class="footer-legal">Terms</a>
      </div>

      <button class="back-to-top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" aria-label="Back to top">
        <span class="top-label">Back to top</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="10" x2="6" y2="2" />
          <polyline points="2.5,5.5 6,2 9.5,5.5" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-bg);
    padding: 0 var(--space-page-x);
    overflow: hidden;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---- Giant single-line name pinned to bottom ---- */
  .footer-name {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    color: var(--color-text);
    opacity: 0.035;
    user-select: none;
    pointer-events: none;
    line-height: 0;
    overflow: hidden;
  }

  .name-svg {
    display: block;
    width: 100%;
    height: auto;
    /* No overflow:visible — text is now sized via textLength to fit the
       viewBox exactly regardless of which font renders. */
  }

  /* SVG presentation attributes don't reliably resolve var() in all browsers.
     Apply font-family via CSS so Funnel Display actually renders. */
  .name-svg text {
    font-family: var(--font-display);
    font-weight: 500;
  }

  /* ---- Meta row ---- */
  .footer-meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: clamp(4rem, 10vw, 8rem);
  }

  .footer-nav {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-link.active {
    color: var(--color-accent-teal);
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-copyright,
  .footer-domain {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .footer-dot {
    color: color-mix(in oklab, var(--color-text-muted) 40%, transparent);
    font-size: var(--text-xs);
  }

  .footer-domain {
    font-family: var(--font-display);
    letter-spacing: 0;
    font-size: var(--text-sm);
  }

  .footer-legal {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .footer-legal:hover {
    color: var(--color-accent);
  }

  .back-to-top {
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0;
    color: var(--color-text-muted);
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .back-to-top:hover {
    color: var(--color-accent);
  }

  .top-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .footer-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding-top: clamp(3rem, 8vw, 5rem);
    }

    .footer-nav {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .footer-link {
      font-size: var(--text-xs);
    }

    .footer-name {
      opacity: 0.025;
    }

    .back-to-top {
      align-self: flex-end;
    }
  }
</style>

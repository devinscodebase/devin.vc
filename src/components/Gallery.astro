---
import { Image } from 'astro:assets';

import headshot from '../assets/gallery/headshot.jpg';
import speaking from '../assets/gallery/speaking.jpg';
import family from '../assets/gallery/family.jpg';
import portrait from '../assets/gallery/portrait.jpg';
import workshop from '../assets/gallery/workshop.jpg';

const images = [
  { src: headshot, alt: 'Devin Alexander headshot', widths: [320, 640] },
  { src: speaking, alt: 'Devin speaking on PR & Marketing', widths: [640, 1280] },
  { src: family, alt: 'Devin with his daughter', widths: [320, 640] },
  { src: portrait, alt: 'Devin portrait outdoors', widths: [320, 640] },
  { src: workshop, alt: 'Devin leading a workshop at Africa Week', widths: [320, 640] },
];
---

<section class="gallery">
  <div class="gallery-grid" id="gallery-grid">
    <div class="gallery-item item-1">
      <Image src={images[0].src} alt={images[0].alt} widths={images[0].widths} format="webp" quality={80} loading="lazy" />
    </div>
    <div class="gallery-item item-2">
      <Image src={images[1].src} alt={images[1].alt} widths={images[1].widths} format="webp" quality={80} loading="lazy" />
    </div>
    <div class="gallery-item item-3">
      <Image src={images[2].src} alt={images[2].alt} widths={images[2].widths} format="webp" quality={80} loading="lazy" />
    </div>
    <div class="gallery-item item-4">
      <Image src={images[3].src} alt={images[3].alt} widths={images[3].widths} format="webp" quality={80} loading="lazy" />
    </div>
    <div class="gallery-item item-5">
      <Image src={images[4].src} alt={images[4].alt} widths={images[4].widths} format="webp" quality={80} loading="lazy" />
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from 'motion';

  const grid = document.getElementById('gallery-grid');
  if (grid) {
    const items = grid.querySelectorAll('.gallery-item');
    items.forEach(item => { item.style.opacity = '0'; });

    inView(grid, () => {
      animate(items, {
        opacity: [0, 1],
        y: [30, 0],
        scale: [0.97, 1],
      }, {
        duration: 0.7,
        easing: [0.25, 1, 0.5, 1],
        delay: stagger(0.12),
      });
    }, { amount: 0.2 });
  }
</script>

<style>
  .gallery {
    background: var(--color-bg);
    padding: 0 clamp(1.5rem, 5vw, 3.5rem);
  }

  .gallery-grid {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 280px 280px;
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }

  .gallery-item {
    overflow: hidden;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.6) sepia(0.25) brightness(0.9) contrast(1.05);
    transition: filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover img {
    filter: grayscale(0) sepia(0.05) brightness(1) contrast(1);
  }

  /* Row 1: headshot (1 col) + speaking (2 cols) */
  .item-1 {
    grid-column: 1;
    grid-row: 1;
  }

  .item-2 {
    grid-column: 2 / 4;
    grid-row: 1;
  }

  /* Row 2: family + portrait + workshop */
  .item-3 {
    grid-column: 1;
    grid-row: 2;
  }

  .item-4 {
    grid-column: 2;
    grid-row: 2;
  }

  .item-5 {
    grid-column: 3;
    grid-row: 2;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 200px 200px 200px;
    }

    .item-1 {
      grid-column: 1;
      grid-row: 1;
    }

    .item-2 {
      grid-column: 2;
      grid-row: 1;
    }

    .item-3 {
      grid-column: 1;
      grid-row: 2;
    }

    .item-4 {
      grid-column: 2;
      grid-row: 2;
    }

    .item-5 {
      grid-column: 1 / 3;
      grid-row: 3;
    }
  }
</style>

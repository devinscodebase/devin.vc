---
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="py-24 px-6 sm:px-12 md:px-24 bg-mint">
  <div class="max-w-2xl mx-auto">
    <h2 class="font-display text-3xl sm:text-4xl text-rich-black mb-12">From the Journal</h2>
    <div class="space-y-10">
      {posts.map((post) => (
        <a href={`/journal/${post.id}`} class="block group">
          <time class="font-display text-sm text-dark-teal/60 tracking-wider">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h3 class="font-sans text-xl sm:text-2xl text-rich-black mt-1 group-hover:text-dark-teal transition-colors">
            {post.data.title}
          </h3>
          <p class="font-sans text-rich-black/60 mt-2 leading-relaxed">
            {post.data.description}
          </p>
        </a>
      ))}
    </div>
    <a href="/journal" class="inline-block mt-12 font-sans text-dark-teal hover:text-teal transition-colors underline underline-offset-4">
      Read the journal &rarr;
    </a>
  </div>
</section>

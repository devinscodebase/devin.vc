---
import { getCollection, render } from 'astro:content';

const nowEntries = await getCollection('now');
const nowEntry = nowEntries[0];
let Content = null;
if (nowEntry) {
  const rendered = await render(nowEntry);
  Content = rendered.Content;
}
---

<section class="py-28 sm:py-36 px-8 sm:px-16 md:px-24">
  <div class="max-w-3xl mx-auto">
    <div class="border-l-2 border-amber/60 pl-8 sm:pl-10">
      <h2 class="font-sans text-xs font-medium tracking-[0.2em] uppercase text-alloy mb-6">
        Right Now
      </h2>
      {Content && (
        <div class="prose">
          <Content />
        </div>
      )}
      <a
        href="/now"
        class="inline-block mt-8 text-xs font-medium tracking-[0.15em] uppercase text-alloy hover:text-burnt transition-colors duration-200"
      >
        More about now &rarr;
      </a>
    </div>
  </div>
</section>

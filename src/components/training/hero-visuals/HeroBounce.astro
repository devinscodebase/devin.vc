---
/*
  HeroBounce — land, then leave at once (kinetic).

  A browser (same chrome as Retargeting, for set cohesion) loads a page. A
  cursor arrives, and without scrolling or clicking anything, immediately
  taps Back — the page whips off to the right and is gone, leaving an empty
  frame. One visit, instant exit. That single-touch departure IS the bounce.
*/
---

<div class="kv kv-bn">
  <div class="br">
    <div class="br-bar">
      <button class="bn-back" type="button" aria-hidden="true" tabindex="-1">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3 L5 8 L10 13" />
        </svg>
      </button>
      <span class="br-url"><span class="br-site">yoursite.com</span></span>
    </div>

    <div class="br-body">
      {/* the page they land on */}
      <div class="bn-page">
        <span class="sk sk-head"></span>
        <span class="sk sk-line"></span>
        <span class="sk sk-line"></span>
        <span class="sk sk-line sk-short"></span>
        <span class="sk sk-block"></span>
      </div>

      {/* what's left after they bounce */}
      <div class="bn-empty" aria-hidden="true">
        <span class="bn-gone">Gone</span>
        <span class="bn-gone-k">left at once</span>
      </div>
    </div>
  </div>

  {/* the cursor that arrives and immediately leaves */}
  <div class="bn-cursor" aria-hidden="true">
    <svg viewBox="0 0 16 19" fill="var(--color-text)" stroke="var(--color-bg)" stroke-width="1" stroke-linejoin="round">
      <path d="M0 0 L0 17 L4.4 12.8 L7.4 19 L9.6 18 L6.6 12 L12 12 Z" />
    </svg>
  </div>
</div>

<style>
  .kv {
    /* synced to the rotator's 7.2s dwell */
    --bn-loop: 7.2s;
    position: relative;
    width: 100%;
    height: 340px;
  }

  /* ─── Browser window (shared language with Retargeting) ─── */
  .br {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 22%, transparent);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: color-mix(in oklab, var(--color-text) 3%, transparent);
  }
  .br-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 16%, transparent);
  }
  .bn-back {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    flex: none;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    color: var(--color-text-muted);
    cursor: default;
    animation: bn-back var(--bn-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite;
  }
  .bn-back svg { width: 60%; height: 60%; }
  .br-url {
    display: flex;
    align-items: center;
    flex: 1;
    height: 1.7rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    overflow: hidden;
  }
  .br-site {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-muted);
  }

  .br-body {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* the loaded page */
  .bn-page {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    justify-content: center;
    padding: 1.4rem 1.6rem;
    animation: bn-page var(--bn-loop) var(--ease-in-out-smooth, cubic-bezier(0.65,0,0.35,1)) infinite;
  }
  .sk {
    display: block;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--color-text-muted) 18%, transparent);
  }
  .sk-line { height: 11px; }
  .sk-short { width: 48%; }
  .sk-head { height: 18px; width: 60%; background: color-mix(in oklab, var(--color-text) 22%, transparent); }
  .sk-block { height: 80px; margin-top: 0.4rem; background: color-mix(in oklab, var(--color-text-muted) 13%, transparent); }

  /* the empty frame after the bounce */
  .bn-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    opacity: 0;
    animation: bn-empty var(--bn-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite;
  }
  .bn-gone {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--words-accent, var(--color-accent));
  }
  .bn-gone-k {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ─── Cursor ─── */
  .bn-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 19px;
    opacity: 0;
    filter: drop-shadow(0 2px 3px color-mix(in oklab, var(--color-text) 22%, transparent));
    animation: bn-cursor var(--bn-loop) var(--ease-in-out-smooth, cubic-bezier(0.65,0,0.35,1)) infinite;
  }
  .bn-cursor svg { width: 100%; height: 100%; display: block; }

  /* ─── Timeline ─── */
  /* page lands, holds a beat, then whips off to the right */
  @keyframes bn-page {
    0%   { transform: translateX(22px); opacity: 0; }
    8%   { transform: translateX(0); opacity: 1; }
    30%  { transform: translateX(0); opacity: 1; }
    44%  { transform: translateX(420px); opacity: 0; }
    100% { transform: translateX(420px); opacity: 0; }
  }
  /* cursor arrives, taps Back almost immediately, then leaves */
  @keyframes bn-cursor {
    0%   { transform: translate(170px, 300px); opacity: 0; }
    8%   { opacity: 1; }
    22%  { transform: translate(28px, 26px); opacity: 1; }
    26%  { transform: translate(28px, 29px); opacity: 1; }
    30%  { transform: translate(28px, 26px); opacity: 1; }
    44%  { transform: translate(150px, 300px); opacity: 0; }
    100% { transform: translate(150px, 300px); opacity: 0; }
  }
  /* Back button flashes on the tap */
  @keyframes bn-back {
    0%, 24%  { background: color-mix(in oklab, var(--color-text-muted) 12%, transparent); color: var(--color-text-muted); }
    28%      { background: var(--words-accent, var(--color-accent)); color: var(--color-bg); }
    40%      { background: color-mix(in oklab, var(--color-text-muted) 12%, transparent); color: var(--color-text-muted); }
    100%     { background: color-mix(in oklab, var(--color-text-muted) 12%, transparent); color: var(--color-text-muted); }
  }
  /* empty state fades in once the page is gone */
  @keyframes bn-empty {
    0%, 46%  { opacity: 0; }
    56%      { opacity: 1; }
    92%      { opacity: 1; }
    100%     { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-page, .bn-cursor, .bn-back, .bn-empty { animation: none; }
    .bn-page { opacity: 0; transform: translateX(420px); }
    .bn-empty { opacity: 1; }
  }
</style>

---
/*
  HeroFrequency — the same ad, again (kinetic).

  One viewer on the left. The SAME ad card (the shoe ad, reused from
  Retargeting for set cohesion) flies in and stacks in front of them — once,
  twice, three, four times. The deck grows toward the person; a counter
  accrues ×1 → ×4. Frequency = one person, reached repeatedly.

  Each card's stagger is baked into its own keyframe (not animation-delay)
  so the deck re-accumulates cleanly on every loop.
*/
const cards = ['cards-1', 'cards-2', 'cards-3', 'cards-4'];
---

<div class="kv kv-fq">
  {/* the viewer being targeted */}
  <div class="fq-viewer" aria-hidden="true">
    <svg viewBox="0 0 48 52" fill="currentColor">
      <circle cx="24" cy="16" r="11" />
      <path d="M4 52 Q4 30 24 30 Q44 30 44 52 Z" />
    </svg>
  </div>

  {/* the deck of identical ads piling onto them */}
  <div class="fq-deck" aria-hidden="true">
    {cards.map((c, i) => (
      <div class={`fq-card ${c}`} style={`z-index: ${i + 1};`}>
        <span class="fq-tag">Ad</span>
        <span class="fq-art">
          <svg viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 13 L3 8 Q3 7 4 7 L9 7 L14 11 L26 11 Q29 11 29 13 L29 13 Q29 14 28 14 L4 14 Q3 14 3 13 Z" />
            <path d="M9 7 L11 10" />
          </svg>
        </span>
        <span class="fq-cta">Still want these?</span>
      </div>
    ))}
  </div>

  <div class="fq-readout">
    <span class="fq-num"></span>
    <span class="fq-key">same viewer</span>
  </div>
</div>

<style>
  @property --fq-n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 4;
  }

  .kv {
    /* synced to the rotator's 7.2s dwell */
    --fq-loop: 7.2s;
    position: relative;
    width: 100%;
    height: 340px;
  }

  /* ─── Viewer ─── */
  .fq-viewer {
    position: absolute;
    left: 4%;
    top: 50%;
    transform: translateY(-50%);
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    background: color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 20%, transparent);
    animation: fq-react var(--fq-loop) var(--ease-out-back, cubic-bezier(0.34,1.56,0.64,1)) infinite;
  }
  .fq-viewer svg { width: 52%; height: 52%; }

  /* ─── Deck of ads ─── */
  .fq-deck {
    position: absolute;
    left: 30%;
    top: 50%;
    width: 152px;
    height: 188px;
    transform: translateY(-50%);
  }
  .fq-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.8rem;
    border: 1px solid color-mix(in oklab, var(--words-accent, var(--color-accent)) 55%, transparent);
    border-radius: var(--radius-md);
    /* opaque fill (bg-based) so each new card cleanly occludes the one behind */
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 11%, var(--color-bg));
    box-shadow: var(--shadow-md);
    transform-origin: center;
    opacity: 0;
  }
  .cards-1 { animation: fq-c1 var(--fq-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite; }
  .cards-2 { animation: fq-c2 var(--fq-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite; }
  .cards-3 { animation: fq-c3 var(--fq-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite; }
  .cards-4 { animation: fq-c4 var(--fq-loop) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) infinite; }

  .fq-tag {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--words-accent, var(--color-accent));
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    line-height: 1.3;
  }
  .fq-art {
    display: grid;
    place-items: center;
    height: 72px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 15%, transparent);
    color: var(--words-accent, var(--color-accent));
  }
  .fq-art svg { width: 70%; height: auto; }
  .fq-cta {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  /* Entry: fly from the right, settle onto the deck at a stacked offset.
     Offsets pile up-left, toward the viewer. */
  @keyframes fq-c1 {
    0%, 5%  { transform: translate(120px, 0) scale(0.94); opacity: 0; }
    13%     { transform: translate(0, 0) scale(1); opacity: 1; }
    100%    { transform: translate(0, 0) scale(1) rotate(-4deg); opacity: 1; }
  }
  @keyframes fq-c2 {
    0%, 27% { transform: translate(120px, 0) scale(0.94); opacity: 0; }
    35%     { transform: translate(-10px, -10px) scale(1) rotate(2deg); opacity: 1; }
    100%    { transform: translate(-10px, -10px) scale(1) rotate(2deg); opacity: 1; }
  }
  @keyframes fq-c3 {
    0%, 49% { transform: translate(120px, 0) scale(0.94); opacity: 0; }
    57%     { transform: translate(-20px, -20px) scale(1) rotate(-2deg); opacity: 1; }
    100%    { transform: translate(-20px, -20px) scale(1) rotate(-2deg); opacity: 1; }
  }
  @keyframes fq-c4 {
    0%, 71% { transform: translate(120px, 0) scale(0.94); opacity: 0; }
    79%     { transform: translate(-30px, -30px) scale(1) rotate(3deg); opacity: 1; }
    100%    { transform: translate(-30px, -30px) scale(1) rotate(3deg); opacity: 1; }
  }

  /* viewer flinches a touch on each impact */
  @keyframes fq-react {
    0%, 11%  { transform: translateY(-50%) scale(1); }
    14%      { transform: translateY(-50%) scale(1.07); }
    18%, 33% { transform: translateY(-50%) scale(1); }
    36%      { transform: translateY(-50%) scale(1.07); }
    40%, 55% { transform: translateY(-50%) scale(1); }
    58%      { transform: translateY(-50%) scale(1.07); }
    62%, 77% { transform: translateY(-50%) scale(1); }
    80%      { transform: translateY(-50%) scale(1.07); }
    84%, 100% { transform: translateY(-50%) scale(1); }
  }

  /* ─── Counter ─── */
  .fq-readout {
    position: absolute;
    right: 4%;
    bottom: 6%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }
  .fq-num {
    counter-reset: fq-n var(--fq-n);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 0.9;
    letter-spacing: var(--tracking-tight);
    color: var(--words-accent, var(--color-accent));
    font-variant-numeric: tabular-nums;
    animation: fq-count var(--fq-loop) steps(1, end) infinite;
  }
  .fq-num::after { content: '\00d7' counter(fq-n); }
  .fq-key {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  @keyframes fq-count {
    0%, 12%  { --fq-n: 1; }
    34%      { --fq-n: 2; }
    56%      { --fq-n: 3; }
    78%      { --fq-n: 4; }
    100%     { --fq-n: 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fq-card, .fq-viewer, .fq-num { animation: none; }
    .fq-card { opacity: 1; }
    .cards-1 { transform: none; }
    .cards-2 { transform: translate(-10px, -10px) rotate(2deg); }
    .cards-3 { transform: translate(-20px, -20px) rotate(-2deg); }
    .cards-4 { transform: translate(-30px, -30px) rotate(3deg); }
  }
</style>

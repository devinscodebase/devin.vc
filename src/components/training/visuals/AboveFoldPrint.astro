---
/*
  Above the Fold (Print) visual — a folded newspaper with the above-fold area highlighted.
*/
---

<div class="afp">
  <div class="paper-wrap">
    <div class="paper">
      <!-- Above-fold half -->
      <div class="half above">
        <div class="masthead">
          <span class="masthead-name">DAILY TRIBUNE</span>
          <span class="masthead-meta">Saturday · 25¢</span>
        </div>
        <div class="lead-head">
          <span class="head-line"></span>
          <span class="head-line short"></span>
        </div>
        <div class="lead-photo" aria-hidden="true">
          <svg viewBox="0 0 80 40" preserveAspectRatio="none">
            <rect x="0" y="0" width="80" height="40" fill="currentColor" opacity="0.18"/>
            <circle cx="55" cy="20" r="8" fill="currentColor" opacity="0.55"/>
            <path d="M0,32 Q20,18 40,28 T80,22 L80,40 L0,40 Z" fill="currentColor" opacity="0.4"/>
          </svg>
        </div>
        <div class="lead-body">
          <span class="body-line"></span>
          <span class="body-line"></span>
          <span class="body-line short"></span>
        </div>
        <span class="zone-tag tag-above">Above the fold</span>
      </div>

      <!-- Fold line -->
      <div class="fold-line" aria-hidden="true">
        <span class="fold-mark left"></span>
        <span class="fold-mark right"></span>
      </div>

      <!-- Below-fold half -->
      <div class="half below">
        <div class="below-cols">
          <div class="col">
            <span class="head-line tiny"></span>
            <span class="body-line"></span>
            <span class="body-line short"></span>
          </div>
          <div class="col">
            <span class="head-line tiny"></span>
            <span class="body-line"></span>
            <span class="body-line short"></span>
          </div>
        </div>
      </div>
    </div>
    <span class="paper-label">Newsstand view</span>
  </div>

  <div class="explainer">
    <p class="explainer-text">
      <span class="hi">The top half</span> is what's visible when the paper sits folded on the newsstand. It's the most expensive ad space in any newspaper because it's the first thing every reader sees.
    </p>
  </div>
</div>

<style>
  .afp {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.25rem;
    align-items: center;
  }
  @media (max-width: 580px) { .afp { grid-template-columns: 1fr; } }

  .paper-wrap { display: flex; flex-direction: column; gap: 0.45rem; align-items: center; }

  .paper {
    width: 200px;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 18%, transparent);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px color-mix(in oklab, black 8%, transparent);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .half {
    padding: 0.5rem 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .half.above {
    flex: 1;
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 8%, transparent);
    border-bottom: 1px dashed color-mix(in oklab, var(--words-accent, var(--color-accent)) 50%, transparent);
    position: relative;
  }
  .half.below { flex: 1; opacity: 0.55; }

  .masthead {
    display: flex; justify-content: space-between; align-items: baseline;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text) 25%, transparent);
    padding-bottom: 0.25rem;
  }
  .masthead-name {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.05em;
  }
  .masthead-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .lead-head { display: flex; flex-direction: column; gap: 0.2rem; }
  .head-line { height: 6px; background: color-mix(in oklab, var(--color-text) 65%, transparent); border-radius: var(--radius-full); }
  .head-line.short { width: 70%; }
  .head-line.tiny { height: 4px; width: 70%; }

  .lead-photo {
    height: 40px;
    color: var(--words-accent, var(--color-accent));
    border-radius: 2px;
    overflow: hidden;
  }
  .lead-photo svg { width: 100%; height: 100%; display: block; }

  .lead-body { display: flex; flex-direction: column; gap: 0.18rem; }
  .body-line { height: 2px; background: color-mix(in oklab, var(--color-text-muted) 40%, transparent); border-radius: var(--radius-full); }
  .body-line.short { width: 65%; }

  .zone-tag {
    /* Horizontal chip pinned to the top-right corner of the above-fold
       half — readable, no rotation, no clipping. */
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 0.18rem 0.5rem;
    background: var(--words-accent, var(--color-accent));
    color: var(--color-bg);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    line-height: 1;
    box-shadow: 0 2px 4px color-mix(in oklab, black 12%, transparent);
  }

  .fold-line {
    position: relative;
    height: 1px;
    background: color-mix(in oklab, var(--color-text-muted) 30%, transparent);
  }
  .fold-mark {
    position: absolute;
    top: -3px;
    width: 6px; height: 6px;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 50%, transparent);
    border-right: 1px solid color-mix(in oklab, var(--color-text-muted) 50%, transparent);
    transform: rotate(45deg);
  }
  .fold-mark.left { left: -3px; }
  .fold-mark.right { right: -3px; transform: rotate(-135deg); }

  .below-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }
  .col { display: flex; flex-direction: column; gap: 0.2rem; }

  .paper-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .explainer {
    align-self: center;
  }
  .explainer-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }
  .hi { color: var(--color-text); font-weight: var(--weight-medium); }
</style>

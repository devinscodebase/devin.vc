---
/*
  Bleed visual — three properly nested concentric zones.
  Uses absolute positioning so each zone explicitly nests inside the
  previous one, and tags are placed at distinct corners so they never
  collide.
*/
---

<div class="bleed">
  <div class="grid">
    <div class="page-stack">
      <!-- Outer bleed zone -->
      <div class="zone bleed-zone">
        <span class="zone-tag tag-bleed">Bleed area</span>

        <!-- Trim line zone -->
        <div class="zone trim-zone">
          <span class="zone-tag tag-trim">Trim line</span>

          <!-- Safe zone -->
          <div class="zone safe-zone">
            <span class="zone-tag tag-safe">Safe zone</span>
            <div class="safe-content">
              <span class="content-line"></span>
              <span class="content-line short"></span>
              <span class="content-line tiny"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ul class="legend">
      <li class="legend-row row-bleed">
        <span class="legend-swatch swatch-bleed"></span>
        <span class="legend-text">
          <span class="legend-name">Bleed area</span>
          <span class="legend-desc">Color runs past the trim. Trimmed off.</span>
        </span>
      </li>
      <li class="legend-row row-trim">
        <span class="legend-swatch swatch-trim"></span>
        <span class="legend-text">
          <span class="legend-name">Trim line</span>
          <span class="legend-desc">Where the printer cuts the page.</span>
        </span>
      </li>
      <li class="legend-row row-safe">
        <span class="legend-swatch swatch-safe"></span>
        <span class="legend-text">
          <span class="legend-name">Safe zone</span>
          <span class="legend-desc">Keep all content inside this margin.</span>
        </span>
      </li>
    </ul>
  </div>
</div>

<style>
  .bleed {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }
  .grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; gap: 1.5rem; } }

  .page-stack { display: grid; place-items: center; }

  /* ─── Zones — properly nested with explicit insets ─── */
  .zone {
    position: relative;
    box-sizing: border-box;
    border-radius: 2px;
  }

  .bleed-zone {
    width: 220px;
    aspect-ratio: 3 / 4;
    background: color-mix(in oklab, var(--color-error) 22%, transparent);
  }

  .trim-zone {
    position: absolute;
    inset: 16px;
    background: var(--color-surface);
    border: 1.5px dashed var(--words-accent, var(--color-accent));
  }

  .safe-zone {
    position: absolute;
    inset: 18px;
    background: color-mix(in oklab, var(--color-success) 12%, transparent);
    border: 1px dashed color-mix(in oklab, var(--color-success) 65%, transparent);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem;
  }

  /* ─── Tags — each at a distinct position so they never collide ─── */
  .zone-tag {
    position: absolute;
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    line-height: 1.2;
  }
  /* Outer bleed tag — top-left, sitting above the outer edge */
  .tag-bleed {
    top: -10px;
    left: 8px;
    color: var(--color-error);
    border: 1px solid color-mix(in oklab, var(--color-error) 45%, transparent);
  }
  /* Trim tag — top-right of the trim zone */
  .tag-trim {
    top: -10px;
    right: 8px;
    color: var(--words-accent, var(--color-accent));
    border: 1px solid color-mix(in oklab, var(--words-accent, var(--color-accent)) 55%, transparent);
  }
  /* Safe tag — bottom-center, inside the safe zone */
  .tag-safe {
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-success);
    border: 1px solid color-mix(in oklab, var(--color-success) 55%, transparent);
  }

  /* ─── Mock content inside the safe zone ─── */
  .safe-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 78%;
    align-items: center;
    /* Push above the bottom-positioned safe tag */
    margin-bottom: 1.4rem;
  }
  .content-line {
    height: 4px;
    width: 100%;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-text) 35%, transparent);
  }
  .content-line.short { width: 70%; }
  .content-line.tiny  { width: 35%; height: 3px; background: color-mix(in oklab, var(--color-text-muted) 35%, transparent); }

  /* ─── Legend ─── */
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .legend-row {
    display: grid;
    grid-template-columns: 18px 1fr;
    align-items: start;
    gap: 0.65rem;
  }
  .legend-swatch {
    width: 14px; height: 14px;
    border-radius: var(--radius-sm);
    margin-top: 0.15rem;
    flex-shrink: 0;
  }
  .swatch-bleed { background: color-mix(in oklab, var(--color-error) 28%, transparent); }
  .swatch-trim  {
    background: var(--color-surface);
    border: 1.5px dashed var(--words-accent, var(--color-accent));
  }
  .swatch-safe  { background: color-mix(in oklab, var(--color-success) 22%, transparent); }

  .legend-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .legend-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  .legend-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>

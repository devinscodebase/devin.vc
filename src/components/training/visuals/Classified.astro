---
/*
  Classified visual — a grid of small text-only ads under a category header.
*/

const classifieds = [
  { title: '2018 Honda Civic',     body: 'Low miles. Clean title. $12,400 OBO.' },
  { title: 'Help Wanted: Bartender', body: 'Friday/Sat nights. Apply in person.' },
  { title: '2 BR Apartment',        body: 'Quiet block. $1,200/mo + utilities.' },
  { title: 'Free Piano',            body: 'You haul. Upright, decent shape.' },
  { title: 'Lost Tabby Cat',        body: 'Last seen Maple St. Reward offered.' },
  { title: 'Garage Sale Sat 8am',   body: '47 Linden Ave. Tools, books, kid stuff.' },
];
---

<div class="classified">
  <header class="cls-header">
    <span class="cls-line"></span>
    <span class="cls-tag">Classifieds — Saturday Edition</span>
    <span class="cls-line"></span>
  </header>
  <div class="cls-grid">
    {classifieds.map((c) => (
      <div class="cls-item">
        <span class="cls-title">{c.title}</span>
        <span class="cls-body">{c.body}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .classified {
    display: flex; flex-direction: column; gap: 0.85rem;
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }
  .cls-header { display: flex; align-items: center; gap: 0.6rem; }
  .cls-line {
    flex: 1; height: 1px;
    background: color-mix(in oklab, var(--color-text-muted) 25%, transparent);
  }
  .cls-tag {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-transform: uppercase;
  }
  .cls-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.15rem;
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    padding: 1px;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
  }
  @media (max-width: 540px) { .cls-grid { grid-template-columns: 1fr 1fr; } }

  .cls-item {
    background: var(--color-surface);
    padding: 0.65rem 0.7rem;
    display: flex; flex-direction: column; gap: 0.1rem;
    min-height: 50px;
  }
  .cls-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .cls-body {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.3;
  }
</style>

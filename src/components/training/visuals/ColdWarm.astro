---
/*
  Cold vs Warm Audience visual — a gradient bar from cold to hot with
  stage markers showing example user journeys.
*/

const stages = [
  { label: 'Cold',    pos: 8,  desc: 'Never heard of you',         tone: 'cold' },
  { label: 'Aware',   pos: 32, desc: 'Saw an ad or post once',     tone: 'aware' },
  { label: 'Warm',    pos: 60, desc: 'Visited the site, watched a video', tone: 'warm' },
  { label: 'Hot',     pos: 90, desc: 'Added to cart, started signup',     tone: 'hot' },
];
---

<div class="temp">
  <div class="bar-wrap">
    <!-- Gradient bar -->
    <div class="bar" aria-hidden="true">
      <div class="bar-fill"></div>
    </div>

    <!-- Stage markers -->
    <div class="markers">
      {stages.map((s) => (
        <div class={`marker tone-${s.tone}`} style={`left: ${s.pos}%`}>
          <span class="marker-dot"></span>
          <span class="marker-label">{s.label}</span>
        </div>
      ))}
    </div>

    <!-- Axis labels -->
    <div class="axis" aria-hidden="true">
      <span class="axis-end">Don't know you exist</span>
      <span class="axis-end">About to convert</span>
    </div>
  </div>

  <div class="cards">
    {stages.map((s) => (
      <div class={`card tone-${s.tone}`}>
        <span class="card-label">{s.label}</span>
        <span class="card-desc">{s.desc}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .temp {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 1.1rem;
  }

  .bar-wrap { position: relative; padding: 1rem 0.5rem 0; }
  .bar {
    height: 14px;
    border-radius: var(--radius-full);
    overflow: hidden;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-accent-teal) 70%, transparent) 0%,
      color-mix(in oklab, var(--color-accent-teal) 40%, transparent) 25%,
      color-mix(in oklab, var(--words-accent, var(--color-accent)) 70%, transparent) 55%,
      color-mix(in oklab, var(--color-accent-rust) 85%, transparent) 90%,
      var(--color-accent-rust) 100%
    );
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1);
  }
  .bar-fill { display: none; }

  .markers { position: absolute; top: 0; left: 0.5rem; right: 0.5rem; bottom: 0; }
  .marker {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .marker-dot {
    width: 12px; height: 12px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    border: 2px solid var(--marker-color, var(--color-text-muted));
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    z-index: 1;
    margin-top: 12px;
  }
  .marker-label {
    margin-top: -2px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marker-color, var(--color-text-muted));
  }

  .tone-cold  { --marker-color: var(--color-accent-teal); }
  .tone-aware { --marker-color: color-mix(in oklab, var(--color-accent-teal) 60%, var(--words-accent, var(--color-accent))); }
  .tone-warm  { --marker-color: var(--words-accent, var(--color-accent)); }
  .tone-hot   { --marker-color: var(--color-accent-rust); }

  .axis {
    display: flex; justify-content: space-between;
    margin-top: 0.85rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }
  @media (max-width: 580px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  .card {
    padding: 0.6rem 0.7rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--marker-color, var(--color-text-muted)) 30%, transparent);
    border-left: 2px solid var(--marker-color, var(--color-text-muted));
    border-radius: var(--radius-sm);
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .card-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marker-color, var(--color-text-muted));
  }
  .card-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text);
    line-height: 1.4;
  }
</style>

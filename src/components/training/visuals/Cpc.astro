---
/*
  CPC — simple horizontal formula with real lucide icons.
  spend ÷ clicks = cost per click
*/
import LucideIcon from "./LucideIcon.astro";
---

<div class="cpc">
  <div class="row">
    <div class="cell">
      <span class="cell-icon">
        <LucideIcon name="dollar-sign" />
      </span>
      <span class="cell-num">$100</span>
      <span class="cell-label">Ad spend</span>
    </div>

    <span class="op" aria-hidden="true">÷</span>

    <div class="cell">
      <span class="cell-icon">
        <LucideIcon name="mouse-pointer-click" />
      </span>
      <span class="cell-num">50</span>
      <span class="cell-label">Clicks</span>
    </div>

    <span class="op" aria-hidden="true">=</span>

    <div class="cell cell-result">
      <span class="result-tag">Cost per click</span>
      <span class="result-num">$2.00</span>
      <span class="result-sub">per click</span>
    </div>
  </div>

  <p class="note">Pay-per-click means you only pay when someone clicks. Cheaper CPC = more clicks for the same budget.</p>
</div>

<style>
  .cpc {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1.2fr;
    align-items: stretch;
    gap: 0.75rem;
  }
  @media (max-width: 600px) {
    .row { grid-template-columns: 1fr; }
    .op { justify-self: center; padding: 0.2rem 0; }
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
  }
  .cell-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    color: var(--color-text-muted);
  }
  .cell-icon :global(svg) { width: 18px; height: 18px; }

  .cell-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
  .cell-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* Result cell — accent */
  .cell-result {
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 9%, transparent);
    border-color: color-mix(in oklab, var(--words-accent, var(--color-accent)) 38%, transparent);
  }
  .result-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--words-accent, var(--color-accent));
  }
  .result-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
  .result-sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .op {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-subtle);
    user-select: none;
  }

  .note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
</style>

---
/*
  CPM — "cost per 1,000 impressions". Same formula card pattern as
  CPC/CPA, with the "M = 1,000" relationship called out explicitly so
  the term itself makes sense.
*/
import LucideIcon from "./LucideIcon.astro";
---

<div class="cpm">
  <div class="row">
    <div class="cell">
      <span class="cell-icon">
        <LucideIcon name="dollar-sign" />
      </span>
      <span class="cell-num">$12</span>
      <span class="cell-label">Ad spend</span>
    </div>

    <span class="op" aria-hidden="true">per</span>

    <div class="cell impressions">
      <span class="cell-icon">
        <LucideIcon name="eye" />
      </span>
      <span class="cell-num">1,000</span>
      <span class="cell-label">Impressions <span class="mille">("M")</span></span>
    </div>

    <span class="op" aria-hidden="true">=</span>

    <div class="cell cell-result">
      <span class="result-tag">Cost per thousand</span>
      <span class="result-num">$12</span>
      <span class="result-sub">per 1,000 impressions</span>
    </div>
  </div>

  <div class="explainer">
    <span class="explainer-key">M</span>
    <span class="explainer-text">
      From the Roman numeral for 1,000 — short for <em>mille</em>, Latin for "thousand". CPM lets you compare the cost of reaching audiences across different platforms.
    </span>
  </div>
</div>

<style>
  .cpm {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto 1.1fr auto 1.2fr;
    align-items: stretch;
    gap: 0.6rem;
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; }
    .op { justify-self: center; padding: 0.2rem 0; }
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
  }
  .cell-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    color: var(--color-text-muted);
  }
  .cell-icon :global(svg) { width: 18px; height: 18px; }

  .cell-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
  .cell-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .mille {
    font-family: var(--font-mono);
    text-transform: none;
    letter-spacing: 0;
    color: var(--words-accent, var(--color-accent));
  }

  .cell-result {
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 9%, transparent);
    border-color: color-mix(in oklab, var(--words-accent, var(--color-accent)) 38%, transparent);
  }
  .result-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--words-accent, var(--color-accent));
  }
  .result-num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
  }
  .result-sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .op {
    display: grid;
    place-items: center;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    user-select: none;
  }

  .explainer {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.85rem;
    align-items: start;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .explainer-key {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 14%, transparent);
    color: var(--words-accent, var(--color-accent));
    font-family: var(--font-display);
    font-size: var(--text-md);
  }
  .explainer-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .explainer-text em {
    font-style: italic;
    color: var(--color-text);
  }
</style>

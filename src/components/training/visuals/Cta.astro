---
/*
  CTA visual — three CTA buttons compared from weak to strong, each
  with a star rating reflecting how compelling the wording is.
*/

const ctas = [
  { tier: 'weak',   label: 'Submit',                rating: 1, note: 'Generic, no value. Submit what?' },
  { tier: 'okay',   label: 'Get the guide',         rating: 3, note: 'Names the thing. Misses the win.' },
  { tier: 'strong', label: 'Get the free guide',    rating: 5, note: 'Free. Specific. Costs nothing to try.' },
];
---

<div class="cta">
  <div class="rows">
    {ctas.map((c) => (
      <div class={`row tier-${c.tier}`}>
        <button type="button" class={`btn btn-${c.tier}`} tabindex="-1">{c.label}</button>
        <div class="meta">
          <div class="stars" aria-label={`${c.rating} of 5`}>
            {Array.from({ length: 5 }, (_, i) => (
              <svg viewBox="0 0 24 24" class={i < c.rating ? 'on' : 'off'} aria-hidden="true">
                <polygon points="12,3 14.5,9 21,9.5 16,13.5 17.5,20 12,16.5 6.5,20 8,13.5 3,9.5 9.5,9" fill="currentColor"/>
              </svg>
            ))}
          </div>
          <span class="note">{c.note}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="legend" aria-hidden="true">
    <span class="legend-bracket"></span>
    <span class="legend-text">Stronger CTAs convert 2–4× better in real campaigns</span>
    <span class="legend-bracket"></span>
  </div>
</div>

<style>
  .cta {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 0.85rem;
  }

  .rows { display: flex; flex-direction: column; gap: 0.5rem; }
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.7rem 0.85rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
  }
  @media (max-width: 540px) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; }
  }

  .btn {
    padding: 0.6rem 1.1rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: default;
    justify-self: start;
    pointer-events: none;
  }
  .btn-weak {
    color: var(--color-text-muted);
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    border-color: color-mix(in oklab, var(--color-text-muted) 18%, transparent);
  }
  .btn-okay {
    color: var(--color-text);
    background: color-mix(in oklab, var(--color-text) 8%, transparent);
    border-color: color-mix(in oklab, var(--color-text) 25%, transparent);
  }
  .btn-strong {
    color: var(--color-bg);
    background: var(--words-accent, var(--color-accent));
    box-shadow: 0 4px 14px color-mix(in oklab, var(--words-accent, var(--color-accent)) 30%, transparent);
  }

  .meta { display: flex; flex-direction: column; gap: 0.25rem; }
  .stars { display: flex; gap: 2px; align-items: center; }
  .stars svg { width: 12px; height: 12px; }
  .stars .on { color: var(--words-accent, var(--color-accent)); }
  .stars .off { color: color-mix(in oklab, var(--color-text-muted) 18%, transparent); }

  .note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .legend {
    display: flex; align-items: center; gap: 0.55rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .legend-bracket {
    flex: 1; height: 1px;
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 30%, transparent);
  }
  .legend-text {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>

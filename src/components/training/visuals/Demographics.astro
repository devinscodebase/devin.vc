---
/*
  Demographics visual — three persona cards with the standard targeting fields.
*/

const personas = [
  {
    name: 'Maya',
    age: 28,
    gender: 'F',
    income: '$72k',
    location: 'Brooklyn, NY',
    language: 'English',
  },
  {
    name: 'David',
    age: 41,
    gender: 'M',
    income: '$118k',
    location: 'Austin, TX',
    language: 'English, Spanish',
  },
  {
    name: 'Linh',
    age: 34,
    gender: 'F',
    income: '$94k',
    location: 'Vancouver, BC',
    language: 'English, Vietnamese',
  },
];
---

<div class="demo">
  <div class="grid">
    {personas.map((p) => (
      <article class="persona">
        <div class="avatar" aria-hidden="true">
          <span class="avatar-letter">{p.name[0]}</span>
        </div>
        <h5 class="persona-name">{p.name}</h5>
        <dl class="fields">
          <div class="field">
            <dt>Age</dt>
            <dd>{p.age}</dd>
          </div>
          <div class="field">
            <dt>Gender</dt>
            <dd>{p.gender}</dd>
          </div>
          <div class="field">
            <dt>Income</dt>
            <dd>{p.income}</dd>
          </div>
          <div class="field">
            <dt>Location</dt>
            <dd>{p.location}</dd>
          </div>
          <div class="field">
            <dt>Language</dt>
            <dd>{p.language}</dd>
          </div>
        </dl>
      </article>
    ))}
  </div>
</div>

<style>
  .demo {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }
  @media (max-width: 580px) { .grid { grid-template-columns: 1fr; } }

  .persona {
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .avatar {
    width: 32px; height: 32px;
    border-radius: var(--radius-full);
    background:
      linear-gradient(135deg,
        color-mix(in oklab, var(--words-accent, var(--color-accent)) 28%, transparent),
        color-mix(in oklab, var(--words-accent, var(--color-accent)) 12%, transparent));
    display: grid; place-items: center;
  }
  .avatar-letter {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--words-accent, var(--color-accent));
  }

  .persona-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-text);
    margin: 0;
  }

  .fields {
    margin: 0;
    display: flex; flex-direction: column;
    gap: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .field {
    /* Stack label above value — long labels like LOCATION and LANGUAGE
       can't collide with their values that way, and the rhythm reads
       more like a real profile card. */
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 8%, transparent);
  }
  .field:last-child { border-bottom: 0; }

  .field dt {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .field dd {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text);
    margin: 0;
  }
</style>

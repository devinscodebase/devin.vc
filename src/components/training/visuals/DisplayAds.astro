---
/*
  Display Ads visual — webpage wireframe with three ad slot types
  highlighted: top leaderboard, in-article medium rectangle, sidebar
  skyscraper. All slots are clearly labeled inside themselves so the
  diagram works as a quick reference.
*/
---

<div class="display">
  <div class="browser">
    <span class="dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="url-bar">runnersworld.com/best-shoes-2025</span>
  </div>

  <div class="page">
    <!-- Leaderboard -->
    <div class="ad-slot leaderboard">
      <span class="slot-tag">Leaderboard</span>
      <span class="slot-size">728 × 90</span>
    </div>

    <!-- Article body + sidebar -->
    <div class="content">
      <div class="article">
        <div class="article-head" aria-hidden="true">
          <span class="title"></span>
          <span class="title short"></span>
          <span class="meta"></span>
        </div>

        <div class="body-block" aria-hidden="true">
          <span class="body-line"></span>
          <span class="body-line"></span>
          <span class="body-line short"></span>
        </div>

        <!-- In-article medium rectangle -->
        <div class="ad-slot mpu">
          <span class="slot-tag">Medium rectangle</span>
          <span class="slot-size">300 × 250</span>
        </div>

        <div class="body-block" aria-hidden="true">
          <span class="body-line"></span>
          <span class="body-line short"></span>
        </div>
      </div>

      <aside class="sidebar">
        <div class="ad-slot skyscraper">
          <span class="slot-tag">Skyscraper</span>
          <span class="slot-size">160 × 600</span>
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  .display {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── Browser chrome ─── */
  .browser {
    display: flex; align-items: center; gap: 0.55rem;
    padding: 0.5rem 0.7rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-bottom: 0;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .dots { display: flex; gap: 0.25rem; }
  .dots span {
    width: 8px; height: 8px; border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-text-muted) 20%, transparent);
  }
  .url-bar {
    flex: 1;
    padding: 0.2rem 0.55rem;
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ─── Page ─── */
  .page {
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-top: 0;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  /* ─── Ad slot common ─── */
  .ad-slot {
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 9%, transparent);
    border: 1px dashed color-mix(in oklab, var(--words-accent, var(--color-accent)) 50%, transparent);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.15rem;
    padding: 0.55rem 0.5rem;
  }
  .slot-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--words-accent, var(--color-accent));
    line-height: 1.2;
  }
  .slot-size {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--words-accent, var(--color-accent)) 80%, transparent);
  }

  /* Leaderboard — wide, short */
  .leaderboard {
    aspect-ratio: 728 / 90;
    width: 100%;
  }

  /* ─── Article column + sidebar ─── */
  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 110px;
    gap: 0.85rem;
  }
  @media (max-width: 560px) {
    .content { grid-template-columns: 1fr; }
    .sidebar { display: flex; justify-content: center; }
    .skyscraper { aspect-ratio: 4 / 1 !important; width: 70% !important; }
  }

  .article { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.2rem; }

  .article-head { display: flex; flex-direction: column; gap: 0.3rem; }
  .title { height: 10px; border-radius: var(--radius-full); background: color-mix(in oklab, var(--color-text) 30%, transparent); }
  .title.short { width: 60%; }
  .meta { height: 4px; width: 35%; border-radius: var(--radius-full); background: color-mix(in oklab, var(--color-text-muted) 22%, transparent); }

  .body-block { display: flex; flex-direction: column; gap: 0.25rem; }
  .body-line { height: 4px; border-radius: var(--radius-full); background: color-mix(in oklab, var(--color-text-muted) 22%, transparent); }
  .body-line.short { width: 65%; }

  /* MPU — fits inside the article column */
  .mpu {
    aspect-ratio: 300 / 250;
    width: 70%;
    align-self: center;
    margin: 0.35rem auto;
  }

  /* Skyscraper — fills sidebar column at correct aspect */
  .sidebar { display: flex; align-items: stretch; }
  .skyscraper {
    aspect-ratio: 160 / 600;
    width: 100%;
  }
</style>

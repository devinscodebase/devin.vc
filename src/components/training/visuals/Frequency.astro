---
/*
  Frequency visual — one person with stacked "ad views" showing how many
  times they saw the same ad.
*/
---

<div class="freq">
  <div class="diagram">
    <!-- Person silhouette -->
    <div class="person" aria-hidden="true">
      <svg viewBox="0 0 60 70" fill="none">
        <circle cx="30" cy="18" r="11" fill="currentColor"/>
        <path d="M8,68 Q8,38 30,38 Q52,38 52,68 Z" fill="currentColor"/>
      </svg>
    </div>

    <!-- Stack of ad views -->
    <div class="stack">
      <span class="stack-label">Saw the same ad</span>
      {[1, 2, 3, 4, 5, 6, 7].map((n) => (
        <div class="view" style={`--i: ${n - 1}`}>
          <span class="view-time">Day {n}</span>
          <span class="view-bar"></span>
        </div>
      ))}
    </div>
  </div>

  <div class="readout">
    <div class="readout-row">
      <span class="value">7×</span>
      <span class="key">frequency</span>
    </div>
    <p class="note">Frequency is how many times the average person saw the same ad. Below ~3 it doesn't stick. Above ~10 they tune it out.</p>
  </div>
</div>

<style>
  .freq {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 0.85rem;
  }

  .diagram {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 0.5rem 0;
  }
  @media (max-width: 460px) {
    .diagram { grid-template-columns: 60px 1fr; gap: 0.8rem; }
  }

  .person { color: color-mix(in oklab, var(--color-text-muted) 35%, transparent); }
  .person svg { width: 100%; height: auto; }

  .stack { display: flex; flex-direction: column; gap: 0.35rem; }
  .stack-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 0.15rem;
  }
  .view {
    display: grid;
    grid-template-columns: 56px 1fr;
    align-items: center;
    gap: 0.6rem;
    opacity: calc(0.55 + var(--i, 0) * 0.06);
  }
  .view-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .view-bar {
    height: 6px;
    background: var(--words-accent, var(--color-accent));
    border-radius: var(--radius-full);
    width: calc(45% + var(--i, 0) * 8%);
  }

  .readout {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding-top: 0.55rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .readout-row { display: flex; align-items: baseline; gap: 0.5rem; }
  .value {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--words-accent, var(--color-accent));
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }
  .key {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>

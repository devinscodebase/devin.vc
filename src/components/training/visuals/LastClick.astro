---
/*
  Last-Click Attribution visual — same 4-touch journey, last touchpoint
  gets 100% credit, all others dimmed.
*/

const touches = [
  { label: 'TV ad',         credit: 0,    last: false },
  { label: 'Facebook ad',   credit: 0,    last: false },
  { label: 'Google search', credit: 0,    last: false },
  { label: 'Google ad',     credit: 100,  last: true  },
];
---

<div class="lc">
  <div class="header">
    <span class="header-label">Last-click model</span>
    <span class="header-note">100% credit → final touchpoint</span>
  </div>

  <div class="row">
    {touches.map((t) => (
      <div class={`touch ${t.last ? 'credit' : 'dim'}`}>
        <span class="touch-name">{t.label}</span>
        <div class="touch-bar-wrap">
          <span class="touch-bar" style={`width: ${t.credit}%`}></span>
        </div>
        <span class="touch-pct">{t.credit}%</span>
      </div>
    ))}
  </div>

  <div class="winner">
    <span class="winner-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </span>
    <span class="winner-text">Google ad takes all the credit, even though TV planted the idea.</span>
  </div>
</div>

<style>
  .lc {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 0.85rem;
  }

  .header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; }
  .header-label {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--color-text);
  }
  .header-note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-subtle);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .touch {
    display: grid;
    grid-template-columns: 110px 1fr 50px;
    gap: 0.7rem;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
  }
  .touch.dim { opacity: 0.4; }
  .touch.credit {
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 9%, transparent);
    border-color: color-mix(in oklab, var(--words-accent, var(--color-accent)) 35%, transparent);
  }

  .touch-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .touch-bar-wrap {
    height: 6px;
    background: color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .touch-bar {
    display: block;
    height: 100%;
    background: var(--words-accent, var(--color-accent));
    border-radius: var(--radius-full);
  }
  .touch-pct {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .touch.credit .touch-pct { color: var(--words-accent, var(--color-accent)); font-weight: 600; }

  .winner {
    display: flex; align-items: center; gap: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .winner-icon {
    width: 16px; height: 16px; color: var(--words-accent, var(--color-accent));
    flex-shrink: 0;
  }
  .winner-icon svg { width: 100%; height: 100%; }
</style>

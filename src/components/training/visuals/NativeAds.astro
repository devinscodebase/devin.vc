---
/*
  Native Ads visual — social feed with one item that's actually the native ad.

  The challenge is recognition: the ad looks identical to organic posts
  except for a tiny "Sponsored" label. Tag the ad with an accent border
  arrow pointing to the label so the recognition moment lands.
*/

const posts = [
  { user: 'morning_routines',  handle: '@morning_routines',  body: 'Day 47 of waking up at 5am. The hardest part is going to bed early.',           ad: false },
  { user: 'Rest Studio',       handle: '@reststudio',        body: 'Most "sleep tips" don\'t work because the mattress was the problem all along.', ad: true  },
  { user: 'nora.travels',      handle: '@nora.travels',      body: 'Found this little cafe in Lisbon. The pastries here are unreal.',               ad: false },
];
---

<div class="native">
  <div class="feed">
    {posts.map((p) => (
      <article class={`post ${p.ad ? 'ad' : ''}`}>
        <div class="avatar" aria-hidden="true"></div>
        <div class="post-body">
          <div class="post-head">
            <span class="user">{p.user}</span>
            <span class="handle">{p.handle}</span>
            {p.ad && (
              <span class="sponsored-tag">
                <span class="sponsored-dot"></span>
                Sponsored
              </span>
            )}
          </div>
          <p class="text">{p.body}</p>
          <div class="actions" aria-hidden="true">
            <span class="action">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </span>
            <span class="action">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </span>
            <span class="action">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="caption">
    <span class="caption-arrow" aria-hidden="true">↑</span>
    The ad blends in. Only the "Sponsored" tag gives it away — that's the whole point.
  </p>
</div>

<style>
  .native {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .feed { display: flex; flex-direction: column; gap: 0.4rem; }

  .post {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.7rem;
    padding: 0.8rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
  }
  .post.ad {
    border-color: color-mix(in oklab, var(--words-accent, var(--color-accent)) 35%, transparent);
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 4%, transparent);
  }

  .avatar {
    width: 36px; height: 36px;
    border-radius: var(--radius-full);
    background:
      linear-gradient(135deg,
        color-mix(in oklab, var(--color-text-muted) 30%, transparent),
        color-mix(in oklab, var(--color-text-muted) 18%, transparent));
  }
  .post.ad .avatar {
    background:
      linear-gradient(135deg,
        color-mix(in oklab, var(--words-accent, var(--color-accent)) 35%, transparent),
        color-mix(in oklab, var(--words-accent, var(--color-accent)) 18%, transparent));
  }

  .post-body { display: flex; flex-direction: column; gap: 0.35rem; }
  .post-head { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }
  .user {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }
  .handle {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .sponsored-tag {
    display: inline-flex; align-items: center; gap: 0.3rem;
    margin-left: auto;
    padding: 0.1rem 0.4rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--words-accent, var(--color-accent));
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 12%, transparent);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklab, var(--words-accent, var(--color-accent)) 30%, transparent);
  }
  .sponsored-dot {
    width: 5px; height: 5px;
    background: var(--words-accent, var(--color-accent));
    border-radius: var(--radius-full);
  }

  .text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text);
    margin: 0;
  }

  .actions { display: flex; gap: 1rem; padding-top: 0.2rem; }
  .action {
    width: 16px; height: 16px;
    color: var(--color-text-subtle);
  }
  .action svg { width: 100%; height: 100%; }

  .caption {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    padding-left: 0.3rem;
  }
  .caption-arrow {
    color: var(--words-accent, var(--color-accent));
    font-weight: 600;
    padding-right: 0.25rem;
  }
</style>

---
/*
  Out-of-Home visual — three OOH formats side by side at consistent
  panel height. Each illustration is built inside a fixed 4:3 frame so
  all three columns align cleanly and captions land at the same baseline.
*/
---

<div class="ooh">
  <div class="row">
    <!-- Billboard -->
    <figure class="format">
      <div class="art">
        <svg viewBox="0 0 120 90" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <!-- Billboard face -->
          <rect x="14" y="14" width="92" height="46" rx="2"
                fill="color-mix(in oklab, currentColor 16%, transparent)"
                stroke="currentColor" stroke-width="1.2"/>
          <!-- Headline line -->
          <rect x="22" y="28" width="58" height="5" rx="1.5" fill="currentColor"/>
          <rect x="22" y="38" width="38" height="3" rx="1.5" fill="currentColor" opacity="0.7"/>
          <!-- Brand mark -->
          <circle cx="92" cy="42" r="6" fill="currentColor" opacity="0.85"/>
          <!-- Posts -->
          <rect x="36" y="60" width="2" height="24" fill="currentColor" opacity="0.55"/>
          <rect x="82" y="60" width="2" height="24" fill="currentColor" opacity="0.55"/>
          <!-- Ground -->
          <line x1="20" y1="84" x2="100" y2="84" stroke="currentColor" stroke-opacity="0.3" stroke-width="0.8"/>
        </svg>
      </div>
      <figcaption>
        <span class="cap-name">Billboard</span>
        <span class="cap-desc">Highway, downtown</span>
      </figcaption>
    </figure>

    <!-- Bus stop -->
    <figure class="format">
      <div class="art">
        <svg viewBox="0 0 120 90" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <!-- Canopy -->
          <rect x="34" y="18" width="52" height="4" rx="1" fill="currentColor" opacity="0.55"/>
          <!-- Glass panel with the ad -->
          <rect x="44" y="22" width="32" height="50" rx="1.5"
                fill="color-mix(in oklab, currentColor 16%, transparent)"
                stroke="currentColor" stroke-width="1.2"/>
          <!-- Ad headline -->
          <rect x="48" y="40" width="24" height="3.5" rx="1" fill="currentColor"/>
          <rect x="48" y="46" width="16" height="2.5" rx="1" fill="currentColor" opacity="0.7"/>
          <!-- CTA chip -->
          <rect x="48" y="58" width="14" height="5" rx="1.5" fill="currentColor"/>
          <!-- Support frame + bench -->
          <line x1="44" y1="22" x2="44" y2="78" stroke="currentColor" stroke-opacity="0.45" stroke-width="0.8"/>
          <line x1="76" y1="22" x2="76" y2="78" stroke="currentColor" stroke-opacity="0.45" stroke-width="0.8"/>
          <rect x="40" y="78" width="40" height="3" rx="1" fill="currentColor" opacity="0.45"/>
          <!-- Ground -->
          <line x1="20" y1="84" x2="100" y2="84" stroke="currentColor" stroke-opacity="0.3" stroke-width="0.8"/>
        </svg>
      </div>
      <figcaption>
        <span class="cap-name">Bus stop</span>
        <span class="cap-desc">Sidewalk · transit</span>
      </figcaption>
    </figure>

    <!-- Transit wrap -->
    <figure class="format">
      <div class="art">
        <svg viewBox="0 0 120 90" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <!-- Bus body -->
          <rect x="10" y="34" width="100" height="32" rx="3"
                fill="color-mix(in oklab, currentColor 14%, transparent)"
                stroke="currentColor" stroke-width="1.2"/>
          <!-- Windows -->
          <rect x="16" y="40" width="60" height="10" rx="1" fill="currentColor" opacity="0.35"/>
          <line x1="32" y1="40" x2="32" y2="50" stroke="color-mix(in oklab, currentColor 60%, var(--color-surface))" stroke-width="0.7"/>
          <line x1="48" y1="40" x2="48" y2="50" stroke="color-mix(in oklab, currentColor 60%, var(--color-surface))" stroke-width="0.7"/>
          <line x1="64" y1="40" x2="64" y2="50" stroke="color-mix(in oklab, currentColor 60%, var(--color-surface))" stroke-width="0.7"/>
          <!-- Door -->
          <rect x="80" y="40" width="22" height="20" rx="1" fill="currentColor" opacity="0.25"/>
          <!-- Ad wrap on lower half -->
          <rect x="14" y="54" width="92" height="10" rx="1" fill="currentColor"/>
          <rect x="20" y="57" width="40" height="3" rx="1" fill="var(--color-surface)" opacity="0.85"/>
          <!-- Wheels -->
          <circle cx="32" cy="68" r="5" fill="#161310"/>
          <circle cx="88" cy="68" r="5" fill="#161310"/>
          <circle cx="32" cy="68" r="2" fill="color-mix(in oklab, currentColor 50%, transparent)"/>
          <circle cx="88" cy="68" r="2" fill="color-mix(in oklab, currentColor 50%, transparent)"/>
          <!-- Ground -->
          <line x1="14" y1="78" x2="106" y2="78" stroke="currentColor" stroke-opacity="0.3" stroke-width="0.8"/>
        </svg>
      </div>
      <figcaption>
        <span class="cap-name">Transit wrap</span>
        <span class="cap-desc">Moving inventory</span>
      </figcaption>
    </figure>
  </div>
</div>

<style>
  .ooh {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 580px) {
    .row { grid-template-columns: 1fr; }
  }

  /* Force every figure to allocate the same row height so captions align. */
  .format {
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.65rem;
  }

  .art {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-radius: var(--radius-md);
    color: var(--words-accent, var(--color-accent));
    padding: 0.45rem;
    overflow: hidden;
  }
  .art svg { width: 100%; height: 100%; display: block; }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: center;
    text-align: center;
  }
  .cap-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  .cap-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-subtle);
  }
</style>

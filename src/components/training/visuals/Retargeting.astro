---
/*
  Retargeting visual — vertical sequence showing the user journey:
    1. Visit brand site → cookie placed
    2. Leave
    3. Same product ad appears on 3 other sites afterward
  Each step is a full-width row so cards have actual room to breathe.
*/

const followSites = [
  { initial: 'N', url: 'news-site.com' },
  { initial: 'W', url: 'weather.com' },
  { initial: 'S', url: 'social.app' },
];
---

<div class="retarget">
  <!-- Step 1: visit brand site -->
  <div class="step">
    <div class="step-tag">
      <span class="step-num">1</span>
      <span class="step-label">User visits the brand site</span>
    </div>
    <article class="card brand-card">
      <header class="card-bar">
        <span class="favicon brand-favicon">B</span>
        <span class="card-url">brandsite.com</span>
      </header>
      <div class="card-body">
        <div class="product">
          <span class="product-art" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="9" width="14" height="12" rx="1.5"/>
              <path d="M9 9V7a3 3 0 0 1 6 0v2"/>
            </svg>
          </span>
          <div class="product-meta">
            <span class="product-name">Trail Runner Pro</span>
            <span class="product-price">$148</span>
          </div>
        </div>
        <span class="cookie-tag">
          <span class="cookie-dot"></span>
          Cookie placed — brand can now follow this user
        </span>
      </div>
    </article>
  </div>

  <!-- Connector -->
  <div class="connector" aria-hidden="true">
    <span class="connector-line"></span>
    <span class="connector-label">User leaves without buying</span>
    <span class="connector-line"></span>
  </div>

  <!-- Step 2: same product appears on other sites -->
  <div class="step">
    <div class="step-tag">
      <span class="step-num">2</span>
      <span class="step-label">Same product follows them across the web</span>
    </div>
    <div class="follow-grid">
      {followSites.map((s) => (
        <article class="card follow-card">
          <header class="card-bar">
            <span class="favicon">{s.initial}</span>
            <span class="card-url">{s.url}</span>
          </header>
          <div class="card-body">
            <div class="article-skeleton" aria-hidden="true">
              <span class="line"></span>
              <span class="line short"></span>
            </div>
            <div class="ad-slot">
              <span class="ad-art" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="9" width="14" height="12" rx="1.5"/>
                  <path d="M9 9V7a3 3 0 0 1 6 0v2"/>
                </svg>
              </span>
              <div class="ad-text">
                <span class="ad-headline">Trail Runner Pro</span>
                <span class="ad-cta">Shop now</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .retarget {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* ─── Step header ─── */
  .step { display: flex; flex-direction: column; gap: 0.65rem; }
  .step-tag { display: flex; align-items: center; gap: 0.55rem; }
  .step-num {
    width: 22px; height: 22px;
    border-radius: var(--radius-full);
    background: var(--words-accent, var(--color-accent));
    color: var(--color-bg);
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .step-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  /* ─── Card chrome ─── */
  .card {
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 14%, transparent);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: color-mix(in oklab, var(--color-text-muted) 6%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .favicon {
    width: 18px; height: 18px;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--color-text-muted) 25%, transparent);
    color: var(--color-text);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1;
    flex-shrink: 0;
  }
  .brand-favicon {
    background: var(--words-accent, var(--color-accent));
    color: var(--color-bg);
  }
  .card-url {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  /* ─── Brand site product row ─── */
  .product {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--words-accent, var(--color-accent)) 25%, transparent);
    border-radius: var(--radius-sm);
  }
  .product-art {
    width: 28px; height: 28px;
    color: var(--words-accent, var(--color-accent));
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .product-art svg { width: 100%; height: 100%; }
  .product-meta { display: flex; flex-direction: column; gap: 0.1rem; flex: 1; }
  .product-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .product-price {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--words-accent, var(--color-accent));
  }

  .cookie-tag {
    display: inline-flex; align-items: center; gap: 0.45rem;
    align-self: flex-start;
    padding: 0.3rem 0.55rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    color: var(--color-text);
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 14%, transparent);
    border-radius: var(--radius-sm);
  }
  .cookie-dot {
    width: 7px; height: 7px;
    border-radius: var(--radius-full);
    background: var(--words-accent, var(--color-accent));
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--words-accent, var(--color-accent)) 22%, transparent);
  }

  /* ─── Connector ─── */
  .connector {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.25rem 0;
    color: var(--color-text-subtle);
  }
  .connector-line {
    flex: 1;
    height: 1px;
    background: color-mix(in oklab, var(--color-text-muted) 18%, transparent);
  }
  .connector-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ─── Follow grid — three cards across, each with enough room ─── */
  .follow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }
  @media (max-width: 580px) {
    .follow-grid { grid-template-columns: 1fr; }
  }

  .article-skeleton {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }
  .line {
    height: 4px;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--color-text-muted) 22%, transparent);
  }
  .line.short { width: 65%; }

  .ad-slot {
    display: flex;
    gap: 0.55rem;
    padding: 0.55rem;
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 9%, transparent);
    border: 1px dashed color-mix(in oklab, var(--words-accent, var(--color-accent)) 40%, transparent);
    border-radius: var(--radius-sm);
    align-items: center;
  }
  .ad-art {
    width: 22px; height: 22px;
    color: var(--words-accent, var(--color-accent));
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .ad-art svg { width: 100%; height: 100%; }
  .ad-text { display: flex; flex-direction: column; gap: 0.18rem; flex: 1; min-width: 0; }
  .ad-headline {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    line-height: 1.2;
  }
  .ad-cta {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--words-accent, var(--color-accent));
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
</style>

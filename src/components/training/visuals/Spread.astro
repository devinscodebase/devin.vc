---
/*
  Spread visual — a single continuous ad rendered across two facing
  magazine pages. The art and copy span the binding so the spread
  reads as one unified canvas, not two unrelated halves.
*/
---

<div class="spread">
  <div class="pages">
    <!-- Page bezel sits behind everything -->
    <div class="page left" aria-hidden="true"></div>
    <div class="binding" aria-hidden="true"></div>
    <div class="page right" aria-hidden="true"></div>

    <!-- Single ad image spans the full width, dimmed where the binding falls -->
    <div class="ad-art">
      <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sp-grad" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="currentColor" stop-opacity="0.45"/>
            <stop offset="1" stop-color="currentColor" stop-opacity="0.1"/>
          </linearGradient>
        </defs>
        <rect width="320" height="200" fill="url(#sp-grad)"/>
        <!-- Subject — placed across the binding so it visually bridges both pages -->
        <circle cx="170" cy="78" r="28" fill="currentColor" opacity="0.7"/>
        <!-- Horizon -->
        <path d="M0,160 Q80,120 160,138 T320,124 L320,200 L0,200 Z" fill="currentColor" opacity="0.55"/>
      </svg>
    </div>

    <!-- Ad copy on the left half -->
    <div class="ad-copy">
      <span class="ad-eyebrow">Spring Collection</span>
      <h5 class="ad-headline">The whole world<br/>fits on two pages.</h5>
    </div>

    <!-- Brand mark on the right half -->
    <div class="ad-brand">
      <span class="brand-mark">TerraDrive</span>
      <span class="brand-cta">terradrive.com</span>
    </div>

    <!-- Binding shadow overlay sits ABOVE the art so the gutter is visible -->
    <div class="binding-shadow" aria-hidden="true"></div>
  </div>

  <div class="caption">
    <span class="cap-bracket"></span>
    <span class="cap-text">One ad, two facing pages — runs to the binding from both sides</span>
    <span class="cap-bracket"></span>
  </div>
</div>

<style>
  .spread {
    padding: 1.5rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .pages {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 32 / 20;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 10px 24px color-mix(in oklab, black 10%, transparent);
    background: var(--color-surface);
    color: var(--words-accent, var(--color-accent));
  }

  /* Page panels (background bezels) — purely decorative, sit below the ad */
  .page {
    position: absolute;
    top: 0; bottom: 0;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 14%, transparent);
  }
  .page.left  { left: 0;  width: 50%; border-right: 0; border-radius: var(--radius-sm) 0 0 var(--radius-sm); }
  .page.right { right: 0; width: 50%; border-left: 0;  border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .binding {
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    background: color-mix(in oklab, var(--color-text-muted) 25%, transparent);
  }

  /* The ad art fills both pages */
  .ad-art {
    position: absolute;
    inset: 6px;
    z-index: 1;
  }
  .ad-art svg { width: 100%; height: 100%; display: block; border-radius: 2px; }

  /* Binding shadow — a soft darkening band over the center */
  .binding-shadow {
    position: absolute;
    top: 6px; bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 18px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0,0,0,0.18) 40%,
      rgba(0,0,0,0.28) 50%,
      rgba(0,0,0,0.18) 60%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 3;
  }

  /* Ad text — sits on top of the art on the left half */
  .ad-copy {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 22px;
    max-width: 42%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #f5f0e7;
    text-shadow: 0 1px 3px rgba(0,0,0,0.25);
  }
  .ad-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--words-accent, var(--color-accent));
    text-shadow: 0 1px 2px rgba(0,0,0,0.4);
  }
  .ad-headline {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    line-height: 1.1;
    color: #f5f0e7;
    margin: 0;
  }

  /* Brand mark — bottom-right of the spread */
  .ad-brand {
    position: absolute;
    z-index: 2;
    bottom: 22px;
    right: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    color: #f5f0e7;
    text-shadow: 0 1px 3px rgba(0,0,0,0.25);
  }
  .brand-mark {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: #f5f0e7;
    letter-spacing: 0.02em;
  }
  .brand-cta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: rgba(245, 240, 231, 0.7);
    letter-spacing: 0.04em;
  }

  /* ─── Caption ─── */
  .caption {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 520px;
  }
  .cap-bracket {
    flex: 1;
    height: 1px;
    background: color-mix(in oklab, var(--words-accent, var(--color-accent)) 35%, transparent);
  }
  .cap-text {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>

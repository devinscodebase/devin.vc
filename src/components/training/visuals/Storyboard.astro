---
/*
  Storyboard visual — 4 panels showing the structure of a video ad.

  Hook → Setup → Value → CTA. Each panel has a glyph illustrating the
  beat and a frame-time tag below it.
*/

const beats = [
  { num: '01', title: 'Hook',  time: '0:00–0:03', desc: 'Stop the scroll',     glyph: 'eye' },
  { num: '02', title: 'Setup', time: '0:03–0:10', desc: 'Name the problem',    glyph: 'frown' },
  { num: '03', title: 'Value', time: '0:10–0:22', desc: 'Show the solution',   glyph: 'star' },
  { num: '04', title: 'CTA',   time: '0:22–0:30', desc: 'Tell them what to do', glyph: 'arrow' },
];
---

<div class="storyboard">
  <div class="strip">
    {beats.map((b) => (
      <figure class="panel">
        <div class="panel-frame">
          <span class="panel-num">{b.num}</span>
          <span class="panel-glyph" aria-hidden="true">
            {b.glyph === 'eye' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>
                <circle cx="12" cy="12" r="2.5" fill="currentColor"/>
              </svg>
            )}
            {b.glyph === 'frown' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="12" cy="12" r="9"/>
                <path d="M8 15.5c1.2-1.6 2.5-2.2 4-2.2s2.8 0.6 4 2.2"/>
                <circle cx="9" cy="10" r="0.8" fill="currentColor"/>
                <circle cx="15" cy="10" r="0.8" fill="currentColor"/>
              </svg>
            )}
            {b.glyph === 'star' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <polygon points="12,3 14.5,9 21,9.5 16,13.5 17.5,20 12,16.5 6.5,20 8,13.5 3,9.5 9.5,9"/>
              </svg>
            )}
            {b.glyph === 'arrow' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="12" x2="20" y2="12"/>
                <polyline points="14 6 20 12 14 18"/>
              </svg>
            )}
          </span>
        </div>
        <figcaption class="panel-meta">
          <span class="panel-title">{b.title}</span>
          <span class="panel-desc">{b.desc}</span>
          <span class="panel-time">{b.time}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
  .storyboard {
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.65rem;
    align-items: start;
  }
  @media (max-width: 560px) {
    .strip { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
  }

  .panel { margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }

  .panel-frame {
    position: relative;
    /* 16:10 frame — feels like a real video still, not a tall blank card. */
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 14%, transparent);
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .panel-num {
    position: absolute;
    top: 0.35rem;
    left: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--color-text-subtle);
  }
  .panel-glyph {
    width: 28%;
    height: auto;
    aspect-ratio: 1;
    color: var(--words-accent, var(--color-accent));
    display: grid;
    place-items: center;
  }
  .panel-glyph svg { width: 100%; height: 100%; }

  .panel-meta { display: flex; flex-direction: column; gap: 0.15rem; }
  .panel-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.1;
  }
  .panel-desc {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.3;
  }
  .panel-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-subtle);
    margin-top: 0.1rem;
  }
</style>

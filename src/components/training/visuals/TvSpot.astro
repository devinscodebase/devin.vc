---
/*
  TV Spot visual — three proportional timeline bars for 15s, 30s, 60s.
  30s is marked "most common".
*/

const spots = [
  { duration: 15, width: 25,  label: '15s', note: 'Tight reminder spot' },
  { duration: 30, width: 50,  label: '30s', note: 'Most common length', primary: true },
  { duration: 60, width: 100, label: '60s', note: 'Storytelling spot' },
];
---

<div class="tv-spot">
  <div class="ruler" aria-hidden="true">
    <span>0s</span><span>15</span><span>30</span><span>45</span><span>60</span>
  </div>
  <div class="bars">
    {spots.map((s) => (
      <div class={`row ${s.primary ? 'primary' : ''}`}>
        <span class="duration">{s.label}</span>
        <div class="bar-wrap">
          <div class="bar" style={`width: ${s.width}%`}>
            <span class="bar-tick start"></span>
            <span class="bar-tick end"></span>
          </div>
        </div>
        <span class="note">{s.note}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .tv-spot {
    display: flex; flex-direction: column; gap: 0.85rem;
    padding: 1.25rem;
    background: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    border-radius: var(--radius-lg);
  }
  .ruler {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: baseline;
  }
  .ruler::after {
    content: '';
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    padding: 0;
  }
  .ruler {
    display: flex;
    padding-left: 48px;
    gap: 0;
    justify-content: space-between;
    padding-right: 116px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .bars { display: flex; flex-direction: column; gap: 0.55rem; }
  .row {
    display: grid;
    grid-template-columns: 48px 1fr 100px;
    align-items: center;
    gap: 0.85rem;
  }
  .duration {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .bar-wrap {
    height: 22px;
    background: color-mix(in oklab, var(--color-text-muted) 6%, transparent);
    border-radius: var(--radius-sm);
    position: relative;
  }
  .bar {
    height: 100%;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-text-muted) 22%, transparent),
      color-mix(in oklab, var(--color-text-muted) 28%, transparent)
    );
    border-radius: var(--radius-sm);
    position: relative;
  }
  .row.primary .bar {
    background: linear-gradient(
      90deg,
      var(--words-accent, var(--color-accent)),
      color-mix(in oklab, var(--words-accent, var(--color-accent)) 80%, transparent)
    );
  }
  .bar-tick {
    position: absolute;
    top: -4px; bottom: -4px;
    width: 1px;
    background: var(--color-text-subtle);
  }
  .bar-tick.start { left: 0; }
  .bar-tick.end { right: 0; }
  .note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .row.primary .note { color: var(--color-text); font-weight: var(--weight-medium); }

  @media (max-width: 520px) {
    .ruler { padding-right: 0; padding-left: 36px; }
    .row { grid-template-columns: 36px 1fr; }
    .note { grid-column: 2; font-size: var(--text-xs); padding-top: 0.15rem; }
  }
</style>

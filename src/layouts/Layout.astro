---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.svelte';
import ScrollProgress from '../components/ScrollProgress.svelte';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.svelte';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  noIndex?: boolean;
  hideScrollProgress?: boolean;
}

const siteName = 'Devin Alexander';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://devinalexander.com';

const {
  title = siteName,
  description = 'Marketing, Operations, Design & Development, GTM, A decade of executive leadership.',
  image,
  type = 'website',
  publishedDate,
  noIndex = false,
  hideScrollProgress = false,
} = Astro.props;

const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImagePath = image || '/og/default.png';
const ogImage = `${siteUrl}${ogImagePath.startsWith('/') ? ogImagePath : `/${ogImagePath}`}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe7d6" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', stored || 'light');
        // Mark JS as ready so CSS can pre-hide animation candidates
        // before the browser paints them. Prevents the visible→invisible
        // flash that happens when JS sets opacity:0 post-render.
        document.documentElement.classList.add('js-ready');
      })();
    </script>
    <link rel="preload" href="/fonts/DMSans-Variable-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <title>{title}</title>

    <script is:inline>
      // ────────────────────────────────────────────────────────────────
      // SCROLL REVEAL — one global IntersectionObserver for the entire site.
      // Any element with class `reveal` fades up when it enters the
      // viewport. The animation tokens live in global.css (.reveal rules).
      // ────────────────────────────────────────────────────────────────
      (function () {
        if (!('IntersectionObserver' in window)) {
          // No IO support → reveal everything immediately
          document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.reveal').forEach(function (el) {
              el.classList.add('is-visible');
            });
          });
          return;
        }

        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-visible');
              io.unobserve(entries[i].target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0 });

        function observeAll() {
          document.querySelectorAll('.reveal:not(.is-visible)').forEach(function (el) {
            io.observe(el);
          });
        }

        function revealAllNow() {
          document.querySelectorAll('.reveal:not(.is-visible)').forEach(function (el) {
            el.classList.add('is-visible');
          });
        }

        // Initial run + after every Astro page-load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observeAll);
        } else {
          observeAll();
        }
        document.addEventListener('astro:page-load', observeAll);

        // View transitions: skip entrance animations entirely
        document.addEventListener('astro:before-swap', function () {
          window.__vtNav = true;
        });
        document.addEventListener('astro:after-swap', function () {
          if (window.__vtNav) {
            revealAllNow();
            // Also clean up legacy inline opacity:0 hooks
            document.querySelectorAll('[style*="opacity: 0"], [style*="transform: scale"], [style*="width: 0"]').forEach(function (el) {
              el.removeAttribute('style');
            });
            window.__vtNav = false;
          }
        });
      })();
    </script>
  </head>
  <body>
    <Nav client:load transition:persist />
    {!hideScrollProgress && <ScrollProgress client:load />}
    <slot />
    <Footer />
    <CookieConsent client:load />
  </body>
</html>

---
// ────────────────────────────────────────────────────────────────
// Site.astro — shared page chrome. The head boilerplate, skip
// link, and main#main skeleton live here; the visible chrome is
// React: Navbar.tsx and Footer.tsx are server-rendered static
// components (no directive, zero shipped JS), MobileMenu.tsx
// (burger + overlay) and ConsentBanner.tsx hydrate as client:idle
// islands. MobileMenu is passed as Navbar's child so the burger
// renders inside .navbar_actions — client: directives only exist
// in .astro templates, and a static React parent can receive a
// hydrated island as a slotted child. Every page renders through
// this shell via <Site>...</Site>; the page's own sections are
// passed as the default slot (rendered inside <main>).
//
// The inline scripts below are framework-neutral bootstrap, not
// UI — hydration timing cannot replicate them without FOUC or
// dead windows: the html.js gate, the navbar is-stuck toggle, the
// [data-reveal] IntersectionObserver, and the synchronous
// window.devinVcConsent global. All other markup and behavior
// lives in the React components.
// ────────────────────────────────────────────────────────────────
import '../styles/global.css';

import Navbar from '../components/Navbar';
import MobileMenu from '../components/MobileMenu';
import Footer from '../components/Footer';
import ConsentBanner from '../components/ConsentBanner';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Devin Alexander · Human-made marketing',
  description = 'A human-made marketing agency for owners who are done paying agencies to guess.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/DMSans-Variable-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page-wrapper">
      <a class="skip_link" href="#main">Skip to content</a>

      <!-- ── Navbar + mobile menu ───────────────────────
           The menu overlay itself is portaled to document.body by
           MobileMenu once hydrated; only the burger renders here. -->
      <Navbar>
        <MobileMenu client:idle />
      </Navbar>

      <main id="main" class="main-wrapper">
        <slot />
      </main>

      <Footer />

      <!-- ── Cookie consent notice ─────────────────────
           A small sheet, not a bar; SSR'd hidden (no flash), and
           ConsentBanner decides on mount whether to show it (see
           the second script block below for the localStorage
           contract). Forward-looking infrastructure only: nothing
           on this site sets tracking cookies today (see /privacy),
           so there is no live analytics call to gate yet. -->
      <ConsentBanner client:idle />
    </div>

    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');

        /* ── navbar tightens once the page leaves the top ── */
        var navbar = document.getElementById('navbar');
        var onScroll = function () {
          navbar.classList.toggle('is-stuck', window.scrollY > 8);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        /* ── scroll reveal ── */
        var reveals = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.style.setProperty('--m-delay', (el.dataset.revealDelay || '0') + 'ms');
              el.classList.add(el.dataset.revealMotion || 'motion-fade-up', 'is-revealed');
              io.unobserve(el);
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
          reveals.forEach(function (el) { io.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
        }
      })();
    </script>

    <!-- ── Cookie consent global ─────────────────────────
         Own script block, separate from the chrome script above:
         this is site-wide feature state (localStorage), not page
         layout behavior. The banner UI and its show/answer wiring
         live in ConsentBanner.tsx; this script only defines the
         global, synchronously, so gating code never races island
         hydration and the hook exists even when the banner never
         shows.

         Contract for any future analytics code:
           localStorage key   'devin-vc-consent'
           values             'accepted' | 'declined'
           Absence of a stored 'accepted' value (key never set, or
           any other value) MUST be treated as non-consent by
           anything that gates on this — decline-by-default.
         window.devinVcConsent is the hook point: future code
         checks window.devinVcConsent.hasConsent() rather than
         reading localStorage directly. Nothing on this site reads
         it yet — no analytics is wired today (see /privacy) — this
         is forward-looking infrastructure only. -->
    <script is:inline>
      (function () {
        var CONSENT_KEY = 'devin-vc-consent';

        var readConsent = function () {
          try { return localStorage.getItem(CONSENT_KEY); }
          catch (e) { return null; }
        };
        window.devinVcConsent = {
          get: readConsent,
          hasConsent: function () { return readConsent() === 'accepted'; }
        };
      })();
    </script>
  </body>
</html>

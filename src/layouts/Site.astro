---
import '../styles/global.css';

import Navbar from '../components/Navbar';
import MobileMenu from '../components/MobileMenu';
import Footer from '../components/Footer';
import ConsentBanner from '../components/ConsentBanner';
import PostHog from '../components/posthog.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ThemeSwitch from '../components/ThemeSwitch';
import { navItems } from '../config/nav';
import { getAvatar } from '../lib/avatar';

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Devin Alexander · The marketing course',
  description = 'A full marketing course for CEOs, owners, and marketing executives.',
  minimal = false,
  image = '/og.png',
  imageAlt = 'Master the entire marketing subject. Devin Alexander, devin.vc',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const avatar = await getAvatar();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Devin Alexander" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/DMSans-Variable-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var theme = 'light';
        try { if (localStorage.getItem('devin-vc-theme') === 'dark') theme = 'dark'; }
        catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class:list={["page-wrapper", { "is-screen": minimal }]}>
      <a class="skip_link" href="#main">Skip to content</a>

      <Navbar avatar={avatar}>
        <ThemeSwitch client:load />
        {navItems.length > 0 && <MobileMenu client:idle avatar={avatar} />}
      </Navbar>

      <main id="main" class="main-wrapper">
        <slot />
      </main>

      {!minimal && <Footer avatar={avatar} />}

      <ConsentBanner client:idle />
    </div>

    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');

        var navbar = document.getElementById('navbar');
        if (navbar) {
          var onScroll = function () {
            navbar.classList.toggle('is-stuck', window.scrollY > 8);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        var reveals = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          var onHit = function (entries, obs) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.style.setProperty('--m-delay', (el.dataset.revealDelay || '0') + 'ms');
              el.classList.add(el.dataset.revealMotion || 'motion-fade-up', 'is-revealed');
              obs.unobserve(el);
            });
          };
          var io = new IntersectionObserver(onHit, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
          var lineIOs = {};
          reveals.forEach(function (el) {
            var margin = el.dataset.revealMargin;
            if (!margin) { io.observe(el); return; }
            if (!lineIOs[margin]) {
              lineIOs[margin] = new IntersectionObserver(onHit, { rootMargin: '0px 0px ' + margin + ' 0px', threshold: 0 });
            }
            lineIOs[margin].observe(el);
          });
        } else {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
        }
      })();
    </script>

    <script is:inline>
      (function () {
        var CONSENT_KEY = 'devin-vc-consent';

        var readConsent = function () {
          try { return localStorage.getItem(CONSENT_KEY); }
          catch (e) { return null; }
        };
        window.devinVcConsent = {
          get: readConsent,
          hasConsent: function () { return readConsent() === 'accepted'; }
        };
      })();
    </script>

    <PostHog />
    <GoogleAnalytics />
  </body>
</html>

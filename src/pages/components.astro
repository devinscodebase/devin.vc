                            <span class="dropdown_mark" aria-hidden="true">&#x2715;</span>
                          </li>
                          <li class="dropdown_option" role="option" aria-selected="false" data-value="5k-15k">
                            <span>5k to 15k</span>
                            <span class="dropdown_mark" aria-hidden="true">&#x2715;</span>
                          </li>
                          <li class="dropdown_option" role="option" aria-selected="false" data-value="15k-up">
                            <span>15k and up</span>
                            <span class="dropdown_mark" aria-hidden="true">&#x2715;</span>
                          </li>
                          <li class="dropdown_option" role="option" aria-selected="false" data-value="strategy">

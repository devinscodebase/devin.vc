    <script is:inline>
      (function () {
        var cp = document.getElementById('cp');

        var probe = document.createElement('span');
        probe.style.display = 'none';
        cp.appendChild(probe);
        var cnv = document.createElement('canvas');
        cnv.width = cnv.height = 1;
        var ctx = cnv.getContext('2d', { willReadFrequently: true });

        function resolveVar(varName) {
          probe.style.color = 'var(' + varName + ')';
          var resolved = getComputedStyle(probe).color;
          ctx.clearRect(0, 0, 1, 1);
          ctx.fillStyle = resolved;
          ctx.fillRect(0, 0, 1, 1);
          var d = ctx.getImageData(0, 0, 1, 1).data;
          return [d[0], d[1], d[2], d[3] / 255];
        }

        function chan(v) {
          v /= 255;
          return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        }

        function oklchCss(c) {
          var r = chan(c[0]), g = chan(c[1]), b = chan(c[2]);
          var l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
          var m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
          var s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
          var L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
          var a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
          var bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
          var C = Math.sqrt(a * a + bb * bb);
          var H = Math.atan2(bb, a) * 180 / Math.PI;
          if (H < 0) H += 360;
          if (C < 0.0005) H = 0;
          return 'oklch(' + (L * 100).toFixed(1) + '% ' + C.toFixed(3) + ' ' + H.toFixed(1) + ')';
        }

        function blend(fg, bg) {
          var a = fg[3];
          return [
            fg[0] * a + bg[0] * (1 - a),
            fg[1] * a + bg[1] * (1 - a),
            fg[2] * a + bg[2] * (1 - a),
            1
          ];
        }

        function luminance(c) {
          return 0.2126 * chan(c[0]) + 0.7152 * chan(c[1]) + 0.0722 * chan(c[2]);
        }

        function contrast(fg, bg) {
          var l1 = luminance(fg);
          var l2 = luminance(bg);
          var hi = Math.max(l1, l2);
          var lo = Math.min(l1, l2);
          return (hi + 0.05) / (lo + 0.05);
        }

        function oklchCssAlpha(c) {
          var s = oklchCss(c);
          if (c[3] < 0.995) {
            s = s.slice(0, -1) + ' / ' + c[3].toFixed(2) + ')';
          }
          return s;
        }
        function refreshSwatches() {
          document.querySelectorAll('[data-swatch]').forEach(function (el) {
            el.textContent = oklchCssAlpha(resolveVar(el.getAttribute('data-swatch')));
          });
        }

        var PAIRS = [
          ['Ink on paper', '--m-ink', '--m-paper', 4.5],
          ['Muted ink on paper', '--m-ink-muted', '--m-paper', 4.5],
          ['Ink on surface', '--m-ink', '--m-surface', 4.5],
          ['Muted ink on surface', '--m-ink-muted', '--m-surface', 4.5],
          ['Button ink on accent', '--m-on-accent', '--m-accent', 4.5],
          ['Error on paper', '--m-error', '--m-paper', 4.5],
          ['Success on paper', '--m-success', '--m-paper', 4.5],
          ['Warning on paper', '--m-warning', '--m-paper', 4.5],
          ['Info on paper', '--m-info', '--m-paper', 4.5],
          ['Focus ring on paper', '--m-focus', '--m-paper', 3],
          ['Strong line on paper', '--m-line-strong', '--m-paper', 3]
        ];
        var aaBox = document.getElementById('aa');

        function renderAA() {
          if (!aaBox) return;
          var rows = PAIRS.map(function (pair) {
            var bg = resolveVar(pair[2]);
            var fg = blend(resolveVar(pair[1]), bg);
            var ratio = contrast(fg, bg);
            var pass = ratio >= pair[3];
            return '<tr>' +
              '<td>' + pair[0] + '</td>' +
              '<td><span class="aa-sample" style="background:' + oklchCss(bg) + ';color:' + oklchCss(fg) + '">Ag</span></td>' +
              '<td class="is-numeric">' + ratio.toFixed(2) + ':1</td>' +
              '<td class="is-numeric">' + pair[3] + ':1</td>' +
              '<td><span class="aa-verdict ' + (pass ? 'pass' : 'fail') + '">' + (pass ? 'PASS' : 'FAIL') + '</span></td>' +
              '</tr>';
          }).join('');
          aaBox.innerHTML =
            '<div class="table_wrapper"><table class="table"><thead><tr>' +
            '<th>Pair</th><th>Sample</th><th class="is-numeric">Measured</th><th class="is-numeric">Target</th><th>Verdict</th>' +
            '</tr></thead><tbody>' + rows + '</tbody></table></div>';
        }

        var stage = document.getElementById('motionStage');
        var motionCards = document.getElementById('motionCards');
        var motionClasses = ['motion-fade-up', 'motion-fade-in', 'motion-slide-in'];
        function playMotion() {
          if (stage) {
            stage.classList.remove('is-playing');
            void stage.offsetWidth;
            stage.classList.add('is-playing');
          }
          if (motionCards) {
            var chips = motionCards.querySelectorAll('.motion_chip');
            chips.forEach(function (chip, idx) {
              var cls = motionClasses[idx % motionClasses.length];
              chip.classList.remove(cls);
              chip.style.removeProperty('--m-delay');
              void chip.offsetWidth;
              chip.style.setProperty('--m-delay', idx * 90 + 'ms');
              chip.classList.add(cls);
            });
          }
        }
        var playBtn = document.getElementById('motionPlay');
        if (playBtn) playBtn.addEventListener('click', playMotion);

        document.querySelectorAll('.dropdown').forEach(function (dd, ddIndex) {
          var trigger = dd.querySelector('.dropdown_trigger');
          var panel = dd.querySelector('.dropdown_panel');
          var valueEl = dd.querySelector('.dropdown_value');
          var hidden = dd.querySelector('input[type="hidden"]');
          var options = Array.prototype.slice.call(dd.querySelectorAll('.dropdown_option'));
          var active = -1;

          options.forEach(function (opt, i) {
            if (!opt.id) opt.id = 'dd' + ddIndex + '-opt' + i;
          });

          function selectedIndex() {
            return options.findIndex(function (o) { return o.classList.contains('is-selected'); });
          }

          function setActive(i) {
            active = (i + options.length) % options.length;
            options.forEach(function (o, j) {
              o.classList.toggle('is-active', j === active);
            });
            trigger.setAttribute('aria-activedescendant', options[active].id);
            options[active].scrollIntoView({ block: 'nearest' });
          }

          function open() {
            dd.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
            var sel = selectedIndex();
            setActive(sel >= 0 ? sel : 0);
          }

          function close() {
            dd.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
            trigger.removeAttribute('aria-activedescendant');
            options.forEach(function (o) { o.classList.remove('is-active'); });
            active = -1;
          }

          function isOpen() {
            return dd.classList.contains('is-open');
          }

          function select(i) {
            options.forEach(function (o, j) {
              o.classList.toggle('is-selected', j === i);
              o.setAttribute('aria-selected', j === i ? 'true' : 'false');
            });
            valueEl.textContent = options[i].querySelector('span:first-child').textContent;
            valueEl.classList.remove('is-empty');
            dd.classList.add('is-filled');
            if (hidden) hidden.value = options[i].getAttribute('data-value') || '';
            close();
            trigger.focus();
          }

          if (selectedIndex() >= 0) dd.classList.add('is-filled');

          trigger.addEventListener('click', function () {
            isOpen() ? close() : open();
          });

          trigger.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              e.preventDefault();
              if (!isOpen()) { open(); return; }
              setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
            } else if (e.key === 'Home' && isOpen()) {
              e.preventDefault();
              setActive(0);
            } else if (e.key === 'End' && isOpen()) {
              e.preventDefault();
              setActive(options.length - 1);
            } else if ((e.key === 'Enter' || e.key === ' ') && isOpen()) {
              e.preventDefault();
              select(active);
            } else if (e.key === 'Escape' && isOpen()) {
              e.preventDefault();
              close();
            }
          });

          options.forEach(function (opt, i) {
            opt.addEventListener('mousemove', function () {
              if (active !== i) setActive(i);
            });
            opt.addEventListener('click', function () {
              select(i);
            });
          });

          document.addEventListener('click', function (e) {
            if (isOpen() && !dd.contains(e.target)) close();
          });
        });

        var themeSwitch = document.querySelector('.theme-switch');
        function setTheme(mode) {
          document.documentElement.setAttribute('data-theme', mode);
          themeSwitch.querySelectorAll('[data-theme-choice]').forEach(function (b) {
            b.setAttribute('aria-checked', b.dataset.themeChoice === mode ? 'true' : 'false');
          });
          refreshSwatches();
          renderAA();
        }
        themeSwitch.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-theme-choice]');
          if (btn) setTheme(btn.dataset.themeChoice);
        });
        themeSwitch.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          e.preventDefault();
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          setTheme(next);
          themeSwitch.querySelector('[data-theme-choice="' + next + '"]').focus();
        });

        document.querySelectorAll('.tag:not(.is-static)').forEach(function (tag) {
          if (tag.tagName !== 'BUTTON' && tag.tagName !== 'A') return;
          tag.addEventListener('click', function (e) {
            if (tag.tagName === 'A') e.preventDefault();
            var on = tag.classList.toggle('is-active');
            tag.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        });

        var leadForm = document.getElementById('lead-form');
        if (leadForm) {
          leadForm.addEventListener('submit', function (e) {
            e.preventDefault();
            if (leadForm.querySelector('.alert')) return;
            var note = document.createElement('div');
            note.className = 'alert is-success';
            note.innerHTML = '<strong>Approved</strong> Your message is on its way. A human reads it next.';
            leadForm.appendChild(note);
          });
        }

        var menu = document.getElementById('siteMenu');
        var menuOpen = document.getElementById('menuOpen');
        var menuClose = document.getElementById('menuClose');
        if (menu && menuOpen) {
          menuOpen.addEventListener('click', function () {
            menu.classList.add('is-open');
            menuClose.focus();
          });
          var closeMenu = function () {
            menu.classList.remove('is-open');
            menuOpen.focus();
          };
          menuClose.addEventListener('click', closeMenu);
          menu.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeMenu();
          });
          menu.querySelectorAll('.menu_link').forEach(function (l) {
            l.addEventListener('click', closeMenu);
          });
        }

        document.querySelectorAll('[data-tabs]').forEach(function (root) {
          var tabs = Array.from(root.querySelectorAll('.tab'));
          var panels = Array.from(root.querySelectorAll('.tab_panel'));
          var activate = function (i, focus) {
            tabs.forEach(function (t, j) {
              t.classList.toggle('is-active', j === i);
              t.setAttribute('aria-selected', j === i ? 'true' : 'false');
              t.tabIndex = j === i ? 0 : -1;
              panels[j].hidden = j !== i;
            });
            if (focus) tabs[i].focus();
          };
          tabs.forEach(function (t, i) {
            t.addEventListener('click', function () { activate(i, false); });
            t.addEventListener('keydown', function (e) {
              var n = null;
              if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
              if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
              if (e.key === 'Home') n = 0;
              if (e.key === 'End') n = tabs.length - 1;
              if (n !== null) { e.preventDefault(); activate(n, true); }
            });
          });
        });

        var accReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        document.querySelectorAll('.acc_item').forEach(function (item) {
          var summary = item.querySelector('.acc_summary');
          var accAnim = null;
          summary.addEventListener('click', function (e) {
            if (accReduced.matches) return;
            e.preventDefault();
            var willOpen = !item.open || item.classList.contains('is-closing');
            var startH = item.offsetHeight;
            if (accAnim) accAnim.cancel();
            item.classList.add('is-animating');
            item.classList.toggle('is-closing', !willOpen);
            item.open = true;
            var endH;
            if (willOpen) {
              endH = item.offsetHeight;
            } else {
              item.open = false;
              endH = item.offsetHeight;
              item.open = true;
            }
            var a = item.animate(
              [{ height: startH + 'px' }, { height: endH + 'px' }],
              { duration: 350, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
            );
            accAnim = a;
            a.onfinish = function () {
              if (!willOpen) {
                item.open = false;
                item.classList.remove('is-closing');
              }
              item.classList.remove('is-animating');
              a.cancel();
              if (accAnim === a) accAnim = null;
            };
          });
        });

        var dialog = document.getElementById('demoDialog');
        var dialogOpen = document.getElementById('dialogOpen');
        if (dialog && dialogOpen) {
          dialogOpen.addEventListener('click', function () { dialog.showModal(); });
          dialog.querySelectorAll('[data-dialog-close]').forEach(function (b) {
            b.addEventListener('click', function () { dialog.close(); });
          });
        }

        var rack = document.getElementById('toastRack');
        var toastCopy = {
          brand: '<strong>Noted</strong> Saved to the system. It ships with the next build.',
          success: '<strong>Approved</strong> The change shipped. A human checked it first.',
          error: '<strong>Corrected</strong> That did not save. The details are still here.',
        };
        document.querySelectorAll('[data-toast]').forEach(function (b) {
          b.addEventListener('click', function () {
            var kind = b.dataset.toast;
            var t = document.createElement('div');
            t.className = 'alert toast is-' + kind;
            t.innerHTML = toastCopy[kind];
            rack.appendChild(t);
            setTimeout(function () {
              t.classList.add('is-leaving');
              t.addEventListener('animationend', function () { t.remove(); });
            }, 5000);
          });
        });

        var fileDemo = document.getElementById('fileDemo');
        if (fileDemo) {
          var fileInput = fileDemo.querySelector('input[type="file"]');
          var fileName = document.getElementById('f-brief-name');
          fileInput.addEventListener('change', function () {
            var f = fileInput.files[0];
            fileName.textContent = f ? f.name : 'Nothing attached yet';
            fileDemo.classList.toggle('is-filled', !!f);
          });
        }

        var stepper = document.getElementById('stepperDemo');
        if (stepper) {
          var count = stepper.querySelector('input');
          stepper.querySelectorAll('.stepper_button').forEach(function (b) {
            b.addEventListener('click', function () {
              var v = (parseInt(count.value, 10) || 0) + parseInt(b.dataset.step, 10);
              var min = parseInt(count.min, 10);
              var max = parseInt(count.max, 10);
              count.value = Math.min(max, Math.max(min, v));
            });
          });
        }

        var rangeDemo = document.getElementById('rangeDemo');
        if (rangeDemo) {
          var range = rangeDemo.querySelector('input');
          var rangeOut = document.getElementById('f-spend-out');
          var paintRange = function () {
            var pct = ((range.value - range.min) / (range.max - range.min)) * 100;
            range.style.setProperty('--range-fill', pct + '%');
            rangeOut.textContent = Number(range.value).toLocaleString('en-US') + ' USD a month';
          };
          range.addEventListener('input', paintRange);
          paintRange();
        }

        var searchDemo = document.getElementById('searchDemo');
        if (searchDemo) {
          var searchInput = searchDemo.querySelector('input');
          var searchClear = searchDemo.querySelector('.field_search_clear');
          var paintSearch = function () {
            searchDemo.classList.toggle('is-filled', searchInput.value.length > 0);
          };
          searchInput.addEventListener('input', paintSearch);
          searchClear.addEventListener('click', function () {
            searchInput.value = '';
            paintSearch();
            searchInput.focus();
          });
        }

        var loadingBtn = document.getElementById('loadingDemo');
        if (loadingBtn) {
          loadingBtn.addEventListener('click', function () {
            if (loadingBtn.classList.contains('is-loading')) return;
            var label = loadingBtn.textContent;
            loadingBtn.classList.add('is-loading');
            loadingBtn.textContent = 'Sending';
            setTimeout(function () {
              loadingBtn.classList.remove('is-loading');
              loadingBtn.textContent = label;
            }, 2400);
          });
        }

        refreshSwatches();
        renderAA();
        playMotion();
      })();
    </script>
  </body>
</html>

---
import '../styles/global.css';

import iconArrowRight from '../icons/freehand/arrow-right.svg?raw';
import iconArrowUpRight from '../icons/freehand/arrow-up-right.svg?raw';
import iconCheck from '../icons/freehand/check.svg?raw';
import iconClose from '../icons/freehand/close.svg?raw';
import iconMenu from '../icons/freehand/menu.svg?raw';
import iconMail from '../icons/freehand/mail.svg?raw';
import iconPhone from '../icons/freehand/phone.svg?raw';
import iconCalendar from '../icons/freehand/calendar.svg?raw';
import iconSearch from '../icons/freehand/search.svg?raw';
import iconChat from '../icons/freehand/chat.svg?raw';
import iconPen from '../icons/freehand/pen.svg?raw';
import iconDownload from '../icons/freehand/download.svg?raw';
import iconChevronDown from '../icons/freehand/chevron-down.svg?raw';
import iconAsterisk from '../icons/freehand/asterisk.svg?raw';
import iconCheckDouble from '../icons/freehand/check-double.svg?raw';
import iconEmailUnread from '../icons/freehand/email-unread.svg?raw';
import iconUser from '../icons/freehand/user.svg?raw';
import iconLocation from '../icons/freehand/location.svg?raw';
import iconLink from '../icons/freehand/link.svg?raw';
import iconMoney from '../icons/freehand/money.svg?raw';
import iconBuilding from '../icons/freehand/building.svg?raw';
import iconMessage from '../icons/freehand/message.svg?raw';
import iconInfo from '../icons/freehand/info.svg?raw';
import iconThemeSun from '../icons/freehand/theme-sun.svg?raw';
import iconThemeMoon from '../icons/freehand/theme-moon.svg?raw';
import iconLogoMeteor from '../icons/freehand/logo-meteor.svg?raw';
import iconTarget from '../icons/freehand/target.svg?raw';
import iconHandshake from '../icons/freehand/handshake.svg?raw';
import imgWorkshop from '../assets/gallery/workshop.jpg';

const icons = [
  { name: 'arrow-right', svg: iconArrowRight },
  { name: 'arrow-up-right', svg: iconArrowUpRight },
  { name: 'check', svg: iconCheck },
  { name: 'close', svg: iconClose },
  { name: 'menu', svg: iconMenu },
  { name: 'mail', svg: iconMail },
  { name: 'phone', svg: iconPhone },
  { name: 'calendar', svg: iconCalendar },
  { name: 'search', svg: iconSearch },
  { name: 'chat', svg: iconChat },
  { name: 'pen', svg: iconPen },
  { name: 'download', svg: iconDownload },
  { name: 'chevron-down', svg: iconChevronDown },
  { name: 'asterisk', svg: iconAsterisk },
  { name: 'check-double', svg: iconCheckDouble },
];

const principles = [
  {
    title: 'Variables first',
    body: 'Every value resolves to a Marker variable. A raw number in markup is a defect; the root is the only ruler.',
  },
  {
    title: 'Two inks, one wheel',
    body: 'Ink reads, yellow marks. Semantic hues sit on the brand’s warm axis, and nothing strays off it.',
  },
  {
    title: 'One class, both modes',
    body: 'Color is authored in oklch and flipped by mode variables. A dark: variant for system color is never written.',
  },
  {
    title: 'Motion plays once',
    body: 'An entrance resolves to its end state and rests there. Reduced motion arrives at that state instantly.',
  },
  {
    title: 'No glow, no dividers',
    body: 'Elevation is neutral ink and surface shifts. Separation is space and scale; a line only ever draws a box.',
  },
  {
    title: 'Labels are not headings',
    body: 'Kickers and eyebrows are .label on a p or span. They carry no weight in the document outline.',
  },
  {
    title: 'Nothing decorative',
    body: 'Every mark carries information or it is removed. No index numbers, no ornament for its own sake.',
  },
  {
    title: 'Semantics before style',
    body: 'A specimen declares its element and its classes as two separate, deliberate decisions.',
  },
];

const inkSwatches = [
  { cls: 'bg-paper', name: 'paper', v: '--m-paper' },
  { cls: 'bg-surface', name: 'surface', v: '--m-surface' },
  { cls: 'bg-ink', name: 'ink', v: '--m-ink' },
  { cls: 'bg-ink-muted', name: 'ink-muted', v: '--m-ink-muted' },
  { cls: 'bg-accent', name: 'accent', v: '--m-accent' },
  { cls: 'bg-accent-strong', name: 'accent-strong', v: '--m-accent-strong' },
  { cls: 'bg-block', name: 'block', v: '--m-block' },
];

const semantics = [
  { name: 'error', chip: 'bg-error', tintChip: 'bg-error-tint', text: 'text-error', sample: 'Corrected.' },
  { name: 'success', chip: 'bg-success', tintChip: 'bg-success-tint', text: 'text-success', sample: 'Approved.' },
  { name: 'warning', chip: 'bg-warning', tintChip: 'bg-warning-tint', text: 'text-warning', sample: 'Flagged.' },
  { name: 'info', chip: 'bg-info', tintChip: 'bg-info-tint', text: 'text-info', sample: 'Noted.' },
];

const lineScale = ['line-subtle', 'line', 'line-strong'];

const spacingSizes = [
  ['tiny', '0.25rem', 'w-tiny'],
  ['xxsmall', '0.5rem', 'w-xxsmall'],
  ['xsmall', '0.75rem', 'w-xsmall'],
  ['small', '1rem', 'w-small'],
  ['medium', '1.5rem', 'w-medium'],
  ['large', '2rem', 'w-large'],
  ['xlarge', '3rem', 'w-xlarge'],
  ['xxlarge', '4rem', 'w-xxlarge'],
  ['huge', '6rem', 'w-huge'],
  ['xxhuge', '8rem', 'w-xxhuge'],
];

const structureSpacing = [
  ['global', 'clamp(1.5rem, 5vw, 3.5rem)', 'w-global'],
  ['section-sm', 'clamp(3rem, 6vw, 5rem)', 'w-section-sm'],
  ['section-md', 'clamp(4rem, 8vw, 6rem)', 'w-section-md'],
  ['section-lg', 'clamp(8rem, 20vh, 14rem)', 'w-section-lg'],
];

const containers = [
  ['sm', '48rem', 'max-w-sm'],
  ['md', '64rem', 'max-w-md'],
  ['lg', '80rem', 'max-w-lg'],
  ['measure-sm', '56ch', 'max-w-measure-sm'],
  ['measure-md', '62ch', 'max-w-measure-md'],
  ['measure-lg', '68ch', 'max-w-measure-lg'],
];

const ledger = [
  { move: 'Captivate', deliverable: 'Brand identity', owner: 'Studio', cost: '4,800' },
  { move: 'Connect', deliverable: 'Email program', owner: 'Studio', cost: '2,400' },
  { move: 'Convert', deliverable: 'Funnel build', owner: 'Studio', cost: '6,200' },
  { move: 'Close', deliverable: 'Sales assets', owner: 'Studio', cost: '3,600' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Components · Devin Alexander</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/DMSans-Variable-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div id="cp" class="page-wrapper">
      <a class="skip_link" href="#main">Skip to the components</a>
      <header class="mast_wrapper px-global">
        <div class="mast_id">
          <a class="logo" href="#main"><span class="logo_mark" aria-hidden="true" set:html={iconLogoMeteor} />Devin Alexander</a>
          <nav class="crumbs" aria-label="Breadcrumb">
            <span class="crumb">Marker</span>
            <span class="crumb" aria-current="page">Components</span>
          </nav>
        </div>
        <div class="theme-switch" role="radiogroup" aria-label="Color theme">
          <span class="theme-switch_marker" aria-hidden="true"></span>
          <button
            class="theme-switch_option"
            type="button"
            role="radio"
            aria-checked="true"
            data-theme-choice="light"
          >
            <span class="icon" aria-hidden="true" set:html={iconThemeSun} />
            <span>Light</span>
          </button>
          <button
            class="theme-switch_option"
            type="button"
            role="radio"
            aria-checked="false"
            data-theme-choice="dark"
          >
            <span class="icon" aria-hidden="true" set:html={iconThemeMoon} />
            <span>Dark</span>
          </button>
        </div>
      </header>

      <main id="main" class="main-wrapper">
        <header class="section_layout is-intro">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-large">
              <div class="section_head">
                  <p class="eyebrow">Source of truth</p>
                  <h1 class="text-h1">Components.</h1>
                  <p class="section_lead text-body-lg text-ink-muted max-w-measure-sm">
                  Every piece of the Marker system, designed here first and
                  shipped everywhere after. If it is not on this page, it is
                  not in the system.
                  </p>
              </div>
              </div>
            </div>
          </div>
        </header>

        <header class="section_layout is-part">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-large">
              <div class="section_head">
                  <p class="eyebrow">Part One</p>
                  <h2 class="text-h2">Foundations.</h2>
                  <p class="section_lead text-body-md text-ink-muted max-w-measure-md">
                  The raw material every component is built from: color, type, space, motion, and the hand-drawn icon set.
                  </p>
              </div>
              </div>
            </div>
          </div>
        </header>

        <section class="section_layout" id="principles">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Principles</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  The eight rules the whole system answers to. If a
                  component breaks one of these, the component is wrong,
                  not the rule.
                  </p>
              </div>
              <div class="section_body">
                  <ul class="principles_grid">
                    {principles.map((p) => (
                      <li class="principle">
                        <h3 class="principle_title text-h6">{p.title}</h3>
                        <p class="principle_body text-small text-ink-muted">{p.body}</p>
                      </li>
                    ))}
                  </ul>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="colors">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Colors</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  A two-ink print system: ink reads, highlighter marks.
                  Values below are read live from the rendered page and
                  re-resolve when the mode flips. Semantics fan out from the
                  brand's warm axis: error 30, warning 65, success 137,
                  info 200.
                  </p>
              </div>
              <div class="section_body">
                  <h3 class="text-h5 mb-small">Inks and papers</h3>
                  <div class="swatch_grid">
                    {inkSwatches.map((s) => (
                      <div class="swatch_tile">
                        <div class={`swatch_chip ${s.cls}`}></div>
                        <span class="swatch_name">{s.name}</span>
                        <span class="swatch_val" data-swatch={s.v}></span>
                      </div>
                    ))}
                    <div class="swatch_tile">
                      <div class="swatch_chip bg-accent"><span class="text-on-accent">Ag</span></div>
                      <span class="swatch_name">on-accent</span>
                      <span class="swatch_val" data-swatch="--m-on-accent"></span>
                    </div>
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Semantics</h3>
                  <div class="swatch_grid">
                    {semantics.map((s) => (
                      <div class="swatch_tile">
                        <div class={`swatch_chip ${s.chip}`}></div>
                        <span class="swatch_name">{s.name}</span>
                        <span class="swatch_val" data-swatch={`--m-${s.name}`}></span>
                      </div>
                    ))}
                    {semantics.map((s) => (
                      <div class="swatch_tile">
                        <div class={`swatch_chip ${s.tintChip}`}>
                          <strong class={`${s.text} text-small`}>{s.sample}</strong>
                        </div>
                        <span class="swatch_name">{s.name}-tint</span>
                        <span class="swatch_val" data-swatch={`--m-${s.name}-tint`}></span>
                      </div>
                    ))}
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Lines and focus</h3>
                  <div class="swatch_grid">
                    {lineScale.map((l) => (
                      <div class="swatch_tile">
                        <div class="swatch_chip bg-paper" style={`border: 0.125rem solid var(--m-${l})`}></div>
                        <span class="swatch_name">{l}</span>
                        <span class="swatch_val" data-swatch={`--m-${l}`}></span>
                      </div>
                    ))}
                    <div class="swatch_tile">
                      <div class="swatch_chip bg-paper"><span class="swatch_ring"></span></div>
                      <span class="swatch_name">focus</span>
                      <span class="swatch_val" data-swatch="--m-focus"></span>
                    </div>
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="type">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Type scale</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  Funnel Display carries every heading, H1 through H6, at
                  weight 600. Tracking tightens as size grows; leading opens
                  as size shrinks. Each text-* utility is one complete
                  typographic decision. The label below the scale is NOT a
                  heading and never takes an h tag.
                  </p>
              </div>
              <div class="section_body">
                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">text-display</span>
                      <span class="spec_info">56→176, 11vw between · 600 · lh 0.92 · ls -0.03em · the front-page voice above h1, viewport-relative the way award-page heroes run (measured 176-327px in the wild) · one use per page, and only on a page's opening statement</span>
                    </div>
                    <p class="text-display font-display">Ink reads.</p>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h1 · text-h1</span>
                      <span class="spec_info">64→120 · 600 · lh 1.02 · ls -0.025em</span>
                    </div>
                    <h1 class="text-h1">Marketing that earns its invoice.</h1>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h2 · text-h2</span>
                      <span class="spec_info">48→76 · 600 · lh 1.05 · ls -0.025em</span>
                    </div>
                    <h2 class="text-h2">Four moves, aimed at one number.</h2>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h3 · text-h3</span>
                      <span class="spec_info">34→48 · 600 · lh 1.08 · ls -0.025em</span>
                    </div>
                    <h3 class="text-h3">Humans speak to humans.</h3>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h4 · text-h4</span>
                      <span class="spec_info">26→34 · 600 · lh 1.15 · ls -0.02em</span>
                    </div>
                    <h4 class="text-h4">The unglamorous work, done properly.</h4>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h5 · text-h5</span>
                      <span class="spec_info">20→24 · 600 · lh 1.25 · ls -0.01em</span>
                    </div>
                    <h5 class="text-h5">Real research, never a prompt.</h5>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">h6 · text-h6</span>
                      <span class="spec_info">18 · 600 · lh 1.35 · ls -0.005em</span>
                    </div>
                    <h6 class="text-h6">Interviews before ideas, always.</h6>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">p · label</span>
                      <span class="spec_info">mono 0.8rem · 500 · lh 1.4 · ls +0.12em · uppercase · not a heading</span>
                    </div>
                    <p class="label">The Marker system</p>
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="paragraphs">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-small">
              <div class="section_head">
                  <p class="eyebrow">Paragraphs</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  DM Sans at weight 400. Three sizes, one job each: large
                  opens a page, medium opens a section, regular carries the
                  reading. Muted ink is a color utility, not a size. Measures
                  cap with max-w-measure-*.
                  </p>
              </div>
              <div class="section_body">
                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">p · text-body-lg</span>
                      <span class="spec_info">20→24 · 400 · lh 1.55 · max-w-measure-sm</span>
                    </div>
                    <p class="text-body-lg max-w-measure-sm">
                      We are a human-made agency. Real research, human copy,
                      human design, and websites built by hand, for owners who
                      are done paying agencies to guess.
                    </p>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">p · text-body-md</span>
                      <span class="spec_info">19→21 · 400 · lh 1.6 · max-w-measure-md</span>
                    </div>
                    <p class="text-body-md max-w-measure-md">
                      Every engagement runs the same four moves in order:
                      captivate, connect, convert, close. Each one feeds the
                      next, and together they compound into the only metric
                      that matters.
                    </p>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">p · text-body</span>
                      <span class="spec_info">18 · 400 · lh 1.65 · max-w-measure-lg</span>
                    </div>
                    <p class="text-body max-w-measure-lg">
                      Most marketing fails quietly. The ad gets scrolled past,
                      the email goes unopened, the site visit ends without a
                      trace, and the invoice arrives anyway. We build the
                      unglamorous machinery that turns attention into revenue,
                      and we show our work at every step.
                    </p>
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="spacing">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Spacing and containers</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  Client-First size words, generated:, gap-medium,
                  p-large. Structure tokens carry the page: px-global for the
                  gutter, py-section-sm/md/lg for rhythm. Containers cap
                  layout; measures cap reading.
                  </p>
              </div>
              <div class="section_body">
                  <h3 class="text-h5 mb-small">Sizes</h3>
                  <div>
                    {spacingSizes.map(([name, val, cls]) => (
                      <div class="bar_row">
                        <span class="bar_name">{name}</span>
                        <div class="bar_track"><div class={`bar ${cls}`}></div></div>
                        <span class="bar_val">{val}</span>
                      </div>
                    ))}
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Structure</h3>
                  <div>
                    {structureSpacing.map(([name, val, cls]) => (
                      <div class="bar_row">
                        <span class="bar_name">{name}</span>
                        <div class="bar_track"><div class={`bar ${cls}`}></div></div>
                        <span class="bar_val">{val}</span>
                      </div>
                    ))}
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Containers and measures</h3>
                  <div>
                    {containers.map(([name, val, cls]) => (
                      <div class="bar_row">
                        <span class="bar_name">{name}</span>
                        <div class="bar_track"><div class={`bar is-block w-full ${cls}`}></div></div>
                        <span class="bar_val">{val}</span>
                      </div>
                    ))}
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="motion">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Motion</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  Motion plays once, then rests on its end state. Two
                  easings do all the work:
                  out-expo for entrances and interaction, in-out-smooth for
                  color and mode changes. Reduced motion gets end states
                  immediately.
                  </p>
              </div>
              <div class="section_body">
                  <h3 class="text-h5 mb-small">Easings</h3>
                  <p class="text-small text-ink-muted max-w-measure-md mb-medium">
                    Two curves carry everything. Out-expo for entrances
                    and interaction; in-out-smooth for color and mode
                    changes.
                  </p>
                  <div id="motionStage">
                    <div class="motion_row">
                      <span class="motion_name">ease-out-expo</span>
                      <div class="motion_bar"><div class="motion_fill is-expo"></div></div>
                      <span class="motion_val">0.16, 1, 0.3, 1</span>
                    </div>
                    <div class="motion_row">
                      <span class="motion_name">ease-in-out-smooth</span>
                      <div class="motion_bar"><div class="motion_fill is-smooth"></div></div>
                      <span class="motion_val">0.65, 0, 0.35, 1</span>
                    </div>
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Entrance patterns</h3>
                  <p class="text-small text-ink-muted max-w-measure-md mb-medium">
                    The named entrances content arrives on. Each is a
                    utility, plays once, and rests on its end state.
                  </p>
                  <div class="motion_cards" id="motionCards">
                    <div class="motion_card">
                      <div class="motion_stage"><span class="motion_chip motion-fade-up">motion-fade-up</span></div>
                      <span class="motion_caption">Section and card entrances</span>
                    </div>
                    <div class="motion_card">
                      <div class="motion_stage"><span class="motion_chip motion-fade-in">motion-fade-in</span></div>
                      <span class="motion_caption">Text and quiet reveals</span>
                    </div>
                    <div class="motion_card">
                      <div class="motion_stage"><span class="motion_chip motion-slide-in">motion-slide-in</span></div>
                      <span class="motion_caption">Lists, staggered by --m-delay</span>
                    </div>
                  </div>
                  <div class="demo_row mt-medium">
                    <button class="button is-secondary is-small" type="button" id="motionPlay">Replay all</button>
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Interaction motion</h3>
                  <p class="text-small text-ink-muted max-w-measure-md mb-medium">
                    Built into the components themselves. Hover a button
                    to feel the lift and offset; the field sweep, dropdown
                    unfold, and menu open all run the same out-expo curve.
                  </p>
                  <div class="demo_row">
                    <button class="button" type="button">Hover me</button>
                    <button class="button is-secondary" type="button">And me</button>
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="icons">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Icons</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  Streamline Freehand: hand-drawn line icons, the controlled
                  dose of the human hand. One set, never mixed. Every icon is
                  inked in currentColor, so it takes whatever ink its text
                  has, and sized in em, so it scales with the type beside it.
                  </p>
              </div>
              <div class="section_body">
                  <div class="icons_grid">
                    {icons.map((i) => (
                      <div class="icon_tile">
                        <div class="icon_frame"><span class="icon" set:html={i.svg} /></div>
                        <span class="icon_name">{i.name}</span>
                      </div>
                    ))}
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Sizes</h3>
                  <p class="text-small text-ink-muted max-w-measure-md mb-medium">
                    Bare, an icon scales with its text. Standalone, pick a
                    step: is-tiny, is-small, the default, is-large.
                  </p>
                  <div class="flex flex-wrap items-end gap-large">
                    <div class="flex flex-col items-center gap-small">
                      <span class="icon is-tiny" set:html={iconCalendar} />
                      <span class="icon_name">is-tiny</span>
                    </div>
                    <div class="flex flex-col items-center gap-small">
                      <span class="icon is-small" set:html={iconCalendar} />
                      <span class="icon_name">is-small</span>
                    </div>
                    <div class="flex flex-col items-center gap-small">
                      <span class="icon" set:html={iconCalendar} />
                      <span class="icon_name">icon</span>
                    </div>
                    <div class="flex flex-col items-center gap-small">
                      <span class="icon is-large" set:html={iconCalendar} />
                      <span class="icon_name">is-large</span>
                    </div>
                  </div>

                  <h3 class="text-h5 mt-xlarge mb-small">Inside display type</h3>
                  <p class="text-small text-ink-muted max-w-measure-md mb-medium">
                    is-inline, for an icon set inside running display copy.
                    The default 1.25em is calibrated for body text, whose line
                    box is about 1.5em; display type runs a 1.05 line-height,
                    so there a default icon is taller than its own line box and
                    forces the paragraph's leading open unevenly. Measured at
                    text-h2: line gaps went from one uniform step to
                    95 / 87 / 88 / 87 / 88px. is-inline is 0.8em, which fits
                    the line box and sits near the cap height.
                  </p>
                  <p class="text-h3 font-display max-w-measure-md">
                    Set with <span class="icon is-inline" set:html={iconCalendar} /> the
                    default, then <span class="icon" set:html={iconCalendar} /> without
                    is-inline.
                  </p>

                  <h3 class="text-h5 mt-xlarge mb-small">In use</h3>
                  <div class="demo_row">
                    <button class="button" type="button">
                      <span class="icon" set:html={iconCalendar} /> Book a strategy call
                    </button>
                    <button class="button is-secondary" type="button">
                      Download the deck <span class="icon" set:html={iconDownload} />
                    </button>
                    <span class="text-error text-small icon_inline">
                      <span class="icon" set:html={iconClose} /> Corrected in red ink
                    </span>
                    <span class="text-success text-small icon_inline">
                      <span class="icon" set:html={iconCheck} /> Approved in green
                    </span>
                  </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <header class="section_layout is-part">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-large">
              <div class="section_head">
                  <p class="eyebrow">Part Two</p>
                  <h2 class="text-h2">Components.</h2>
                  <p class="section_lead text-body-md text-ink-muted max-w-measure-md">
                  The assembled parts. Each is specified with its markup, its full set of states, and the behavior a team can rely on.
                  </p>
              </div>
              </div>
            </div>
          </div>
        </header>

        <section class="section_layout" id="buttons">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
              <div class="section_head">
                  <p class="eyebrow">Buttons and links</p>
                  <p class="section_lead text-small text-ink-muted max-w-measure-md">
                  One button, two voices: accent speaks, secondary holds
                  the line. Works as a button or a link. Hover lifts the
                  slab and slides its ink offset out beneath it; press
                  stamps it flat. The color never changes, the motion is
                  the feedback.
                  </p>
              </div>
              <div class="section_body">
                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">button · button</span>
                      <span class="spec_info">display 600 · accent / is-secondary · is-small · disabled</span>
                    </div>
                    <div class="demo_row">
                      <button class="button" type="button">Book a strategy call</button>
                      <button class="button is-secondary" type="button">See the work</button>
                      <button class="button is-small" type="button">Small</button>
                      <button class="button is-secondary is-small" type="button">Small secondary</button>
                      <button class="button" type="button" disabled>Disabled</button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">button · is-hero</span>
                      <span class="spec_info">--text-body-lg · hero CTAs only, one primary per hero · lift and offset in em, they scale with the type</span>
                    </div>
                    <div class="demo_row">
                      <button class="button is-hero" type="button">
                        <span class="icon" set:html={iconCalendar} /> Book a strategy call
                      </button>
                      <button class="button is-hero is-secondary" type="button">
                        See the work <span class="icon" set:html={iconArrowRight} />
                      </button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">div · button-group</span>
                      <span class="spec_info">THE container for buttons · buttons are never loose siblings · in a section_head it owns the head-to-action gap</span>
                    </div>
                    <div class="button-group">
                      <button class="button" type="button">Book a strategy call</button>
                      <button class="button is-secondary" type="button">See the work</button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">button · is-ink</span>
                      <span class="spec_info">the button for accent surfaces · solid ink slab, paper offset · same motion, inks traded</span>
                    </div>
                    <div class="demo_row" style="background: var(--m-accent); padding: var(--spacing-medium); border-radius: var(--radius-xs);">
                      <button class="button is-ink" type="button">Book a strategy call</button>
                      <button class="button is-ink is-small" type="button">Small ink</button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">button · with icon</span>
                      <span class="spec_info">leading or trailing · icons hold still · is-icon is square and needs an aria-label</span>
                    </div>
                    <div class="demo_row">
                      <button class="button" type="button">
                        <span class="icon" set:html={iconCalendar} /> Book a strategy call
                      </button>
                      <button class="button is-secondary" type="button">
                        See the work <span class="icon" set:html={iconArrowRight} />
                      </button>
                      <button class="button is-small" type="button">
                        <span class="icon" set:html={iconDownload} /> Download
                      </button>
                      <button class="button is-icon" type="button" aria-label="Search">
                        <span class="icon" set:html={iconSearch} />
                      </button>
                      <button class="button is-secondary is-icon" type="button" aria-label="Close">
                        <span class="icon" set:html={iconClose} />
                      </button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">button · is-icon sizes</span>
                      <span class="spec_info">square, icon-only · is-tiny · is-small · default · is-large · needs an aria-label</span>
                    </div>
                    <div class="demo_row">
                      <button class="button is-icon is-tiny" type="button" aria-label="Search"><span class="icon" set:html={iconSearch} /></button>
                      <button class="button is-icon is-small" type="button" aria-label="Search"><span class="icon" set:html={iconSearch} /></button>
                      <button class="button is-icon" type="button" aria-label="Search"><span class="icon" set:html={iconSearch} /></button>
                      <button class="button is-icon is-large" type="button" aria-label="Search"><span class="icon" set:html={iconSearch} /></button>
                      <button class="button is-secondary is-icon is-tiny" type="button" aria-label="Close"><span class="icon" set:html={iconClose} /></button>
                      <button class="button is-secondary is-icon is-small" type="button" aria-label="Close"><span class="icon" set:html={iconClose} /></button>
                      <button class="button is-secondary is-icon" type="button" aria-label="Close"><span class="icon" set:html={iconClose} /></button>
                      <button class="button is-secondary is-icon is-large" type="button" aria-label="Close"><span class="icon" set:html={iconClose} /></button>
                    </div>
                  </div>

                  <div class="spec_row">
                    <div class="spec_meta">
                      <span class="spec_tag">a · text-link</span>
                      <span class="spec_info">600 · accent underline · highlight sweeps in from the left, leaves to the right</span>
                    </div>

---
import '../../styles/global.css';
import Navbar from '../../components/Navbar';
import MobileMenu from '../../components/MobileMenu';
import iconArrowRight from '../../icons/freehand/arrow-right.svg?raw';
import { getAvatar } from '../../lib/avatar';

const avatar = await getAvatar();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Navbar · Devin Alexander</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/DMSans-Variable-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page-wrapper">
      <a class="skip_link" href="#main">Skip to content</a>

      <Navbar avatar={avatar}>
        <MobileMenu client:load avatar={avatar} />
      </Navbar>

      <main id="main">
        <section class="section_layout" id="work">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-large">
                <div class="section_head">
                  <h1 class="text-h1">Marketing that earns its invoice.</h1>
                  <p class="section_lead text-body-lg text-ink-muted max-w-measure-sm">
                    A human-made agency for owners who are done paying to
                    guess. Scroll down, and the header tightens its rhythm
                    once you leave the top.
                  </p>
                </div>
                <div class="section_body">
                  <div class="button-group">
                    <a class="button is-hero" href="/">Join the waitlist</a>
                    <a class="button is-hero is-secondary" href="#work">
                      See the work <span class="icon" aria-hidden="true" set:html={iconArrowRight} />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="services">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
                <div class="section_head">
                  <p class="eyebrow">Services</p>
                  <h2 class="text-h3">Four moves, aimed at one number.</h2>
                  <p class="section_lead text-body-md text-ink-muted max-w-measure-md">
                    Captivate, connect, convert, close. Each one feeds the
                    next, and together they compound into the only metric
                    that matters.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section_layout" id="training">
          <div class="padding-global">
            <div class="container-large">
              <div class="padding-section-medium">
                <div class="section_head">
                  <p class="eyebrow">Training</p>
                  <h2 class="text-h3">Real research, never a prompt.</h2>
                  <p class="section_lead text-body-md text-ink-muted max-w-measure-md">
                    Interviews before ideas, always. We build the case for
                    every decision before a single pixel is placed.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script is:inline>
      (function () {
        var navbar = document.getElementById('navbar');
        var onScroll = function () { navbar.classList.toggle('is-stuck', window.scrollY > 8); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>

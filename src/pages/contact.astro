---
import Layout from '../layouts/Layout.astro';
import BookingCalendar from '../components/BookingCalendar.svelte';
---

<Layout title="Contact — Devin Alexander" description="Get in touch about consulting, collaboration, or interesting problems worth solving.">
  <main>
    <section class="contact-page">
      <div class="contact-inner">
        <header class="page-header">
          <div class="section-tag"><span class="tag-number">01</span><span class="tag-dash" aria-hidden="true"></span><span class="tag-label">Contact</span></div>
          <h1 class="page-title">Let's talk</h1>
          <p class="page-subtitle">Whether it's <span class="sub-accent teal">consulting</span>, <span class="sub-accent amber">collaboration</span>, or an interesting problem worth <span class="sub-accent rust">solving</span>.</p>
          <div class="title-rule" aria-hidden="true"></div>
        </header>

        <div class="contact-switcher">
          <div class="tab-track">
            <div class="tab-indicator" id="tab-indicator"></div>
            <button class="tab-btn active" id="tab-message" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Message
            </button>
            <button class="tab-btn" id="tab-booking" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              Book a call
            </button>
          </div>
        </div>

        <div class="contact-card" id="contact-card">
          <div class="card-accent teal" aria-hidden="true"></div>
          <div class="card-accent amber" aria-hidden="true"></div>

          <div class="panel active" id="panel-message">
            <p class="panel-hint">I'll get back to you within a day or two.</p>
            <form class="contact-form" id="contact-form">
              <div class="form-field">
                <input type="text" name="name" placeholder="Name" required class="form-input" aria-label="Your name" />
                <div class="input-line"></div>
              </div>
              <div class="form-field">
                <input type="email" name="email" placeholder="Email" required class="form-input" aria-label="Your email address" />
                <div class="input-line"></div>
              </div>
              <div class="form-field">
                <textarea name="message" placeholder="What's on your mind?" required class="form-input form-textarea" rows="4" aria-label="Your message"></textarea>
              </div>
              <button type="submit" class="form-submit" id="form-submit">Send message</button>
              <p class="form-status" id="form-status" aria-live="polite"></p>
            </form>
          </div>

          <div class="panel" id="panel-booking">
            <p class="panel-hint">30 minutes, no commitment.</p>
            <BookingCalendar client:load />
          </div>
        </div>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { animate, inView } from 'motion';

  // ---- Tab switching ----
  const tabMessage = document.getElementById('tab-message');
  const tabBooking = document.getElementById('tab-booking');
  const indicator = document.getElementById('tab-indicator');
  const panelMessage = document.getElementById('panel-message');
  const panelBooking = document.getElementById('panel-booking');
  const card = document.getElementById('contact-card');

  function switchTab(tab) {
    const isBooking = tab === 'booking';

    tabMessage.classList.toggle('active', !isBooking);
    tabBooking.classList.toggle('active', isBooking);
    indicator.classList.toggle('right', isBooking);
    card.classList.toggle('booking', isBooking);

    panelMessage.classList.toggle('active', !isBooking);
    panelBooking.classList.toggle('active', isBooking);
  }

  tabMessage?.addEventListener('click', () => switchTab('message'));
  tabBooking?.addEventListener('click', () => switchTab('booking'));

  // ---- Entrance animations ----
  const header = document.querySelector('.page-header');
  const switcher = document.querySelector('.contact-switcher');
  const cardEl = document.querySelector('.contact-card');


  if (header) {
    header.style.opacity = '0';
    inView(header, () => {
      animate(header, { opacity: [0, 1], y: [12, 0] }, {
        duration: 0.4,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.3 });
  }

  if (switcher) {
    switcher.style.opacity = '0';
    inView(switcher, () => {
      animate(switcher, { opacity: [0, 1], y: [10, 0] }, {
        duration: 0.35,
        delay: 0.05,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.3 });
  }

  if (cardEl) {
    cardEl.style.opacity = '0';
    inView(cardEl, () => {
      animate(cardEl, { opacity: [0, 1], y: [15, 0] }, {
        duration: 0.4,
        delay: 0.1,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.1 });
  }

  // ---- Spring hover on submit button ----
  const submitBtnEl = document.querySelector('.form-submit');
  if (submitBtnEl) {
    submitBtnEl.addEventListener('mouseenter', () => {
      animate(submitBtnEl, { scale: 1.04 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
    });
    submitBtnEl.addEventListener('mouseleave', () => {
      animate(submitBtnEl, { scale: 1 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
    });
  }

  // ---- Contact form handling ----
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('form-submit');
  const statusEl = document.getElementById('form-status');

  if (form && submitBtn && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = '';
      const dots = document.createElement('span');
      dots.className = 'loading-dots';
      for (let i = 0; i < 3; i++) {
        const dot = document.createElement('span');
        dot.textContent = '.';
        dots.appendChild(dot);
      }
      submitBtn.appendChild(dots);
      statusEl.textContent = '';
      statusEl.className = 'form-status';

      const data = new FormData(form);
      const body = {
        name: data.get('name'),
        email: data.get('email'),
        message: data.get('message'),
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const d = await res.json();
          throw new Error(d.error || 'Something went wrong');
        }

        statusEl.textContent = 'Message sent — I\'ll be in touch.';
        statusEl.className = 'form-status success';
        form.reset();
      } catch (err) {
        statusEl.textContent = err.message;
        statusEl.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  }
</script>

<style>
  .contact-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .contact-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0;
  }

  .sub-accent { font-style: normal; }
  .sub-accent.teal { color: var(--color-accent-teal); }
  .sub-accent.amber { color: var(--color-accent-amber); }
  .sub-accent.rust { color: var(--color-accent-rust); }

  .title-rule {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---- Tab switcher ---- */
  .contact-switcher {
    max-width: 640px;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .tab-track {
    position: relative;
    display: inline-flex;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    border-radius: 999px;
    padding: 3px;
  }

  .tab-indicator {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent-teal) 10%, transparent);
    transition: left 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tab-indicator.right {
    left: 50%;
    background: color-mix(in oklab, var(--color-accent-amber) 10%, transparent);
  }

  .tab-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: none;
    border: none;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 999px;
    white-space: nowrap;
  }

  .tab-btn.active {
    color: var(--color-text);
  }

  .tab-btn svg {
    opacity: 0.5;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tab-btn.active svg {
    opacity: 0.8;
  }

  /* ---- Contact card ---- */
  .contact-card {
    position: relative;
    max-width: 640px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-card:hover {
    border-color: color-mix(in oklab, var(--color-text-muted) 22%, transparent);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-accent.teal {
    background: linear-gradient(90deg, var(--color-accent-teal), color-mix(in oklab, var(--color-accent-teal) 30%, transparent));
    opacity: 1;
  }

  .card-accent.amber {
    background: linear-gradient(90deg, var(--color-accent-amber), color-mix(in oklab, var(--color-accent-amber) 30%, transparent));
    opacity: 0;
  }

  .contact-card.booking .card-accent.teal {
    opacity: 0;
  }

  .contact-card.booking .card-accent.amber {
    opacity: 1;
  }

  /* ---- Panels ---- */
  .panel {
    display: none;
  }

  .panel.active {
    display: block;
    animation: panel-enter 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes panel-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-hint {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(0.92rem, 1.2vw, 1rem);
    color: var(--color-text-muted);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* ---- Contact form ---- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-field {
    margin-bottom: 1.25rem;
    position: relative;
  }

  .form-input {
    width: 100%;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 20%, transparent);
    padding: 0.75rem 0;
    outline: none;
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .input-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input:focus ~ .input-line {
    width: 100%;
  }

  .form-input:focus {
    border-color: var(--color-accent);
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input:focus::placeholder {
    opacity: 0.4;
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    padding: 0.75rem;
  }

  .form-textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent) 8%, transparent);
  }

  .form-submit {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background-color: var(--color-accent);
    background-image: linear-gradient(90deg, var(--color-accent-teal) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: 100% 0;
    color: var(--color-bg);
    border: 1px solid var(--color-accent);
    padding: 0.8rem 1.75rem;
    cursor: pointer;
    transition: background-position 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0.25rem;
    align-self: flex-start;
  }

  .form-submit:hover {
    background-position: 0% 0;
    border-color: var(--color-accent-teal);
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    margin: 0.75rem 0 0;
    min-height: 1.2em;
  }

  .form-status.success {
    color: var(--color-accent);
  }

  .form-status.error {
    color: var(--color-error);
  }

  /* ---- Booking panel overrides ---- */
  #panel-booking :global(.booking) {
    padding: 0;
    border: none;
  }

  #panel-booking :global(.booking-heading),
  #panel-booking :global(.booking-pitch) {
    display: none;
  }

  /* ---- Footer ---- */
  .page-footer {
    margin-top: var(--space-block);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  .loading-dots {
    display: inline-flex;
    gap: 2px;
  }

  .loading-dots span {
    animation: dot-pulse 1.4s infinite;
    opacity: 0;
  }

  .loading-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .loading-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0; }
    40% { opacity: 1; }
  }
</style>

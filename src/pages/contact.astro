---
import Layout from '../layouts/Layout.astro';
import BookingCalendar from '../components/BookingCalendar.svelte';
import ContactForm from '../components/ContactForm.svelte';
---

<Layout title="Contact — Devin Alexander" description="Get in touch about consulting, collaboration, or interesting problems worth solving." image="/og/contact.png">
  <main>
    <section class="contact-page">
      <div class="contact-inner">
        <header class="page-header reveal" style="--reveal-i: 0">
          <div class="section-tag"><span class="tag-number">01</span><span class="tag-dash" aria-hidden="true"></span><span class="tag-label">Contact</span></div>
          <h1 class="page-title">Let's talk</h1>
          <p class="page-subtitle">Whether it's <span class="sub-accent teal">consulting</span>, <span class="sub-accent amber">collaboration</span>, or an interesting problem worth <span class="sub-accent rust">solving</span>.</p>
          <div class="title-rule" aria-hidden="true"></div>
        </header>

        <div class="contact-switcher reveal" style="--reveal-i: 1" role="tablist" aria-label="Choose how to get in touch">
          <button class="tab-btn active" id="tab-message" type="button" role="tab" aria-selected="true" aria-controls="panel-message">
            <span class="tab-num">01</span>
            <span class="tab-label">Message</span>
          </button>
          <button class="tab-btn" id="tab-booking" type="button" role="tab" aria-selected="false" aria-controls="panel-booking">
            <span class="tab-num">02</span>
            <span class="tab-label">Book a call</span>
          </button>
        </div>

        <div class="contact-card reveal" style="--reveal-i: 2" id="contact-card">
          <div class="card-accent teal" aria-hidden="true"></div>
          <div class="card-accent amber" aria-hidden="true"></div>

          <div class="panel active" id="panel-message">
            <p class="panel-hint">I'll get back to you within a day or two.</p>
            <ContactForm client:load />
          </div>

          <div class="panel" id="panel-booking">
            <p class="panel-hint">30 minutes, no commitment.</p>
            <BookingCalendar client:load />
          </div>
        </div>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Entrance fades handled by the global .reveal utility (CSS + observer
  // in Layout.astro). This script only owns tab switching + deep-linking.
  document.addEventListener('astro:page-load', () => {
    const tabMessage = document.getElementById('tab-message');
    const tabBooking = document.getElementById('tab-booking');
    const panelMessage = document.getElementById('panel-message');
    const panelBooking = document.getElementById('panel-booking');
    const card = document.getElementById('contact-card');

    function switchTab(tab) {
      const isBooking = tab === 'booking';
      tabMessage.classList.toggle('active', !isBooking);
      tabBooking.classList.toggle('active', isBooking);
      tabMessage.setAttribute('aria-selected', String(!isBooking));
      tabBooking.setAttribute('aria-selected', String(isBooking));
      card.classList.toggle('booking', isBooking);
      panelMessage.classList.toggle('active', !isBooking);
      panelBooking.classList.toggle('active', isBooking);
    }

    tabMessage?.addEventListener('click', () => switchTab('message'));
    tabBooking?.addEventListener('click', () => switchTab('booking'));

    if (window.location.hash === '#book') switchTab('booking');
  });
</script>

<style>
  /* Pre-hide elements JS will fade in (Layout.astro adds .js-ready before paint). */
  /* Entrance hidden state provided by the global .reveal utility. */

  /* ---- Centered stage layout ---- */
  .contact-page {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: clamp(6rem, 14vh, 10rem) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .contact-inner {
    width: 100%;
    max-width: 580px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 440px;
    margin: 0;
  }

  .sub-accent { font-style: normal; }
  .sub-accent.teal { color: var(--color-accent-teal); }
  .sub-accent.amber { color: var(--color-accent-amber); }
  .sub-accent.rust { color: var(--color-accent-rust); }

  .title-rule {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---- Tab switcher — editorial underline tabs ---- */
  .contact-switcher {
    display: inline-flex;
    gap: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
  }

  .tab-btn {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    font-family: var(--font-body);
    background: none;
    border: none;
    padding: 0.85rem 0;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  /* Animated underline for active state */
  .tab-btn::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width var(--duration-normal) var(--ease-out-expo);
  }

  .tab-btn:hover { color: var(--color-text); }
  .tab-btn.active { color: var(--color-text); }
  .tab-btn.active::after { width: 100%; }

  /* Editorial 01/02 numerals */
  .tab-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-subtle);
    letter-spacing: 0;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .tab-btn.active .tab-num { color: var(--color-accent); }

  .tab-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---- Contact card ---- */
  .contact-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    transition: border-color var(--duration-normal) var(--ease-out-expo),
                box-shadow var(--duration-normal) var(--ease-out-expo);
    box-shadow: 0 0 60px color-mix(in oklab, var(--color-accent) 4%, transparent),
                0 0 120px color-mix(in oklab, var(--color-accent-teal) 3%, transparent);
    text-align: left;
  }

  .contact-card:hover {
    border-color: color-mix(in oklab, var(--color-text-muted) 22%, transparent);
    box-shadow: 0 0 80px color-mix(in oklab, var(--color-accent) 6%, transparent),
                0 0 160px color-mix(in oklab, var(--color-accent-teal) 4%, transparent);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 1;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .card-accent.teal {
    background: linear-gradient(90deg, var(--color-accent-teal), color-mix(in oklab, var(--color-accent-teal) 30%, transparent));
    opacity: 1;
  }

  .card-accent.amber {
    background: linear-gradient(90deg, var(--color-accent-amber), color-mix(in oklab, var(--color-accent-amber) 30%, transparent));
    opacity: 0;
  }

  .contact-card.booking .card-accent.teal {
    opacity: 0;
  }

  .contact-card.booking .card-accent.amber {
    opacity: 1;
  }

  .contact-card.booking {
    box-shadow: 0 0 60px color-mix(in oklab, var(--color-accent-amber) 4%, transparent),
                0 0 120px color-mix(in oklab, var(--color-accent-amber) 3%, transparent);
  }

  .contact-card.booking:hover {
    box-shadow: 0 0 80px color-mix(in oklab, var(--color-accent-amber) 6%, transparent),
                0 0 160px color-mix(in oklab, var(--color-accent-amber) 4%, transparent);
  }

  /* ---- Panels ---- */
  .panel {
    display: none;
  }

  .panel.active {
    display: block;
    animation: panel-enter var(--duration-normal) var(--ease-out-expo) forwards;
  }

  @keyframes panel-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-hint {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* ---- Contact form ---- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-field {
    margin-bottom: 1rem;
    position: relative;
  }

  /* Form styling lives inside the ContactForm Svelte component (scoped). */

  /* ---- Booking panel overrides ---- */
  #panel-booking :global(.booking) {
    padding: 0;
    border: none;
  }

  #panel-booking :global(.booking-heading),
  #panel-booking :global(.booking-pitch) {
    display: none;
  }

  /* Hide hints on success states */
  #panel-booking:has(:global(.booking-success)) .panel-hint,
  #panel-message:has(:global(.success)) .panel-hint {
    display: none;
  }

  /* ---- Footer ---- */
  .page-footer {
    width: 100%;
    max-width: 540px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }


  .consent-text a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-accent) 30%, transparent);
    transition: border-color var(--duration-fast) var(--ease-out-expo);
  }

  .consent-text a:hover {
    border-color: var(--color-accent);
  }

  .loading-dots {
    display: inline-flex;
    gap: 2px;
  }

  .loading-dots span {
    animation: dot-pulse 1.4s infinite;
    opacity: 0;
  }

  .loading-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .loading-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dot-pulse {
    0%, 80%, 100% { opacity: 0; }
    40% { opacity: 1; }
  }
</style>

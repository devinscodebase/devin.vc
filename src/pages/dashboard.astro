---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.svelte';

export const prerender = false;
---

<Layout title="Dashboard — Devin Alexander" description="Admin dashboard for notifications and subscribers." noIndex hideScrollProgress>
  <main>
    <section class="dashboard-page">
      <header class="dash-header">
        <div class="dash-header-inner">
          <h1 class="dash-title">Dashboard</h1>
          <p class="dash-subtitle">Notifications & subscribers</p>
        </div>
      </header>
      <div class="dash-body">
        <Dashboard client:load />
      </div>
    </section>
  </main>
</Layout>

<style>
  .dashboard-page {
    min-height: 100dvh;
    padding-top: 6rem;
  }

  .dash-header {
    padding: 0 var(--space-page-x) 2rem;
    border-bottom: var(--border-subtle);
  }

  .dash-header-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .dash-title {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .dash-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0;
  }

  .dash-body {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem var(--space-page-x) var(--space-page-bottom);
  }
</style>

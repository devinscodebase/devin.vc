---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.svelte';
import About from '../components/About.svelte';
import Gallery from '../components/Gallery.astro';
import Timeline from '../components/Timeline.svelte';
import Now from '../components/Now.svelte';
import Journal from '../components/Journal.svelte';
import Contact from '../components/Contact.svelte';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.journal.list();
const allPosts = await Promise.all(
  slugs.map(async (slug) => {
    const entry = await reader.collections.journal.read(slug);
    return { slug, ...entry! };
  })
);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.date!).getTime() - new Date(a.date!).getTime())
  .slice(0, 3)
  .map(({ slug, title, description, tag, date, featured }) => ({
    slug, title, description, tag, date, featured,
  }));
---

<Layout>
  <main>
    <Hero client:load />
    <About client:load />
    <Gallery />
    <Timeline client:load />
    <Now client:load />
    <Journal client:load posts={latestPosts} />
    <Contact client:load />
  </main>
</Layout>

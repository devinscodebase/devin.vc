---
import Site from '../layouts/Site.astro';

import HomeWaitlist from '../components/HomeWaitlist';
---
<Site
  minimal
  title="Master the entire marketing subject | Devin Alexander"
  description="A full marketing course for CEOs, owners, and marketing executives. Learn how marketing works and how to apply it to your own business. Join the waitlist."
>
  <section class="section_layout" id="waitlist">
    <div class="padding-global">
      <div class="container-large">
        <div class="md:py-large">
          <HomeWaitlist client:load />
        </div>
      </div>
    </div>
    <div class="padding-global">
      <div class="container-large">
        <div class="legal_bar">
          <p>© 2026 Devin Alexander. All Rights Reserved.</p>
          <nav class="legal_bar_links" aria-label="Legal">
            <a class="text-link" href="/privacy">Privacy</a>
            <a class="text-link" href="/cookies">Cookies</a>
            <a class="text-link" href="/terms">Terms</a>
          </nav>
        </div>
      </div>
    </div>
  </section>
</Site>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.svelte';
import Timeline from '../components/Timeline.astro';
import NowTeaser from '../components/NowTeaser.astro';
import JournalTeaser from '../components/JournalTeaser.astro';
import Footer from '../components/Footer.astro';
import ScrollBackground from '../components/ScrollBackground.svelte';
---

<Layout title="Devin">
  <ScrollBackground client:load />
  <div class="relative z-10">
    <Hero client:load />
    <Timeline />
    <NowTeaser />
    <JournalTeaser />
    <Footer />
  </div>
</Layout>

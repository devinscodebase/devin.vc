---
import InternalLayout from '../../layouts/InternalLayout.astro';
import Heading from '../../components/ui/Heading.svelte';
import Text from '../../components/ui/Text.svelte';
import Tag from '../../components/ui/Tag.svelte';
import Button from '../../components/ui/Button.svelte';
import Card from '../../components/ui/Card.svelte';
import Stack from '../../components/ui/Stack.svelte';
import Field from '../../components/ui/Field.svelte';
import CardCompositionDemo from '../../components/ui/showcase/CardCompositionDemo.svelte';

const toc = [
  { id: 'overview', label: 'Overview', no: '01' },
  { id: 'color', label: 'Color', no: '02' },
  { id: 'typography', label: 'Typography', no: '03' },
  { id: 'spacing', label: 'Spacing', no: '04' },
  { id: 'motion', label: 'Motion', no: '05' },
  { id: 'surface', label: 'Radius & Shadow', no: '06' },
  { id: 'heading', label: 'Heading', no: '07' },
  { id: 'text', label: 'Text', no: '08' },
  { id: 'tag', label: 'Tag', no: '09' },
  { id: 'button', label: 'Button', no: '10' },
  { id: 'card', label: 'Card', no: '11' },
  { id: 'field', label: 'Field', no: '12' },
  { id: 'stack', label: 'Stack', no: '13' },
  { id: 'section', label: 'Section', no: '14' },
];

const colorTokens = [
  { name: '--color-bg', desc: 'Page background' },
  { name: '--color-surface', desc: 'Elevated surface' },
  { name: '--color-text', desc: 'Primary text' },
  { name: '--color-text-muted', desc: 'Secondary text' },
  { name: '--color-text-subtle', desc: 'Tertiary text' },
  { name: '--color-accent', desc: 'Warm gold accent' },
  { name: '--color-accent-teal', desc: 'Cool accent' },
  { name: '--color-accent-amber', desc: 'Warm secondary' },
  { name: '--color-accent-rust', desc: 'Saturated accent' },
  { name: '--color-error', desc: 'Error / destructive' },
  { name: '--color-success', desc: 'Confirmation' },
];

const typeScale = [
  { name: '--text-4xl', value: 'clamp(4rem, 9vw + 1.5rem, 7.5rem)', sample: 'Quiet capital', display: true },
  { name: '--text-3xl', value: 'clamp(3rem, 5.5vw + 1.4rem, 4.75rem)', sample: 'Selected work', display: true },
  { name: '--text-2xl', value: 'clamp(2.125rem, 3.5vw + 1.2rem, 3rem)', sample: 'A founder’s partner', display: true },
  { name: '--text-xl',  value: 'clamp(1.625rem, 2vw + 1.1rem, 2.125rem)', sample: 'Section heading', display: true },
  { name: '--text-lg',  value: 'clamp(1.25rem, 0.9vw + 1.05rem, 1.5rem)', sample: 'Leading paragraph for emphasis at the top of long passages.' },
  { name: '--text-md',  value: 'clamp(1.0625rem, 0.45vw + 0.95rem, 1.1875rem)', sample: 'Body emphasis sits a step above the baseline.' },
  { name: '--text-base', value: '1rem', sample: 'Body. The neutral default for prose, set in DM Sans at 1rem with 1.55 line-height.' },
  { name: '--text-sm',  value: '0.875rem', sample: 'Caption and metadata copy lives here.' },
  { name: '--text-xs',  value: '0.75rem', sample: 'Eyebrow and label text, uppercase, tracked wide.' },
];

const spacingTokens = [
  { name: '--space-section', value: 'clamp(8rem, 20vh, 14rem)', desc: 'Between major sections' },
  { name: '--space-page-top', value: 'clamp(8rem, 18vh, 12rem)', desc: 'Top of every page' },
  { name: '--space-page-bottom', value: 'clamp(4rem, 10vh, 8rem)', desc: 'Bottom of every page' },
  { name: '--space-block-lg', value: 'clamp(4rem, 8vw, 6rem)', desc: 'Large block padding' },
  { name: '--space-block', value: 'clamp(3rem, 6vw, 5rem)', desc: 'Standard block padding' },
  { name: '--space-element', value: 'clamp(1.5rem, 3vw, 2.5rem)', desc: 'Between elements in a stack' },
  { name: '--space-card', value: 'clamp(1.5rem, 3vw, 2rem)', desc: 'Card interior padding' },
  { name: '--space-page-x', value: 'clamp(1.5rem, 5vw, 3.5rem)', desc: 'Horizontal page gutter' },
];

const easingTokens = [
  { name: '--ease-out-expo', value: 'var(--ease-out-expo)', curve: 'M 0 100 C 16 0, 30 0, 100 0', use: 'Default. Entrances, hovers, micro-interactions.' },
  { name: '--ease-in-out-smooth', value: 'var(--ease-in-out-smooth)', curve: 'M 0 100 C 65 100, 35 0, 100 0', use: 'Symmetrical transitions, view transitions, scroll.' },
];

const durationTokens = [
  { name: '--duration-fast', value: '200ms', use: 'Hovers, focus, color shifts' },
  { name: '--duration-normal', value: '350ms', use: 'Entrances, layout changes' },
  { name: '--duration-slow', value: '500ms', use: 'Heroes, emphasized moments' },
];

const selectOptions = [
  { value: 'pre-seed', label: 'Pre-seed' },
  { value: 'seed', label: 'Seed' },
  { value: 'series-a', label: 'Series A' },
  { value: 'series-b', label: 'Series B+' },
];
---

<InternalLayout
  title="Design System · Internal"
  description="Component primitives and design tokens for devin.vc"
>
  <a href="#main" class="ds__skip">Skip to content</a>

  <div class="ds">
    <aside class="ds__sidebar" aria-label="Design system navigation">
      <details class="ds__sidebar-collapse">
        <summary class="ds__sidebar-toggle">
          <div class="ds__mark-row">
            <a class="ds__mark" href="/">
              <svg class="ds__mark-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 3H4.5a3 3 0 0 0 0 6H7M6 7l-2 2 2 2" />
              </svg>
              <span>devin.vc</span>
            </a>
            <span class="ds__sidebar-chevron" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 4.5L6 7.5L9 4.5" />
              </svg>
            </span>
          </div>
        </summary>

        <div class="ds__sidebar-inner">
          <div class="ds__context">
            <span class="ds__chip">Internal</span>
            <span class="ds__version">v0.2 · 2026.05</span>
          </div>

          <nav class="ds__nav" aria-label="Sections">
            <ul>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} data-nav={item.id}>
                    <span class="ds__nav-no">{item.no}</span>
                    <span class="ds__nav-label">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <p class="ds__sidebar-foot">
            Edit primitives at<br />
            <code>src/components/ui/</code>
          </p>
        </div>
      </details>
    </aside>

    <main id="main" class="ds__main" tabindex="-1">
      <!-- THEME TOGGLE -->
      <div class="ds__toolbar">
        <button class="ds__theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
          <span class="ds__theme-icons" aria-hidden="true">
            <svg class="ds__theme-icon ds__theme-icon--sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="8" r="3" />
              <path d="M8 1v1.5M8 13.5V15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M1 8h1.5M13.5 8H15M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
            </svg>
            <svg class="ds__theme-icon ds__theme-icon--moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5 6 6 0 1 0 13.5 9.5z" />
            </svg>
          </span>
          <span class="ds__theme-label" data-theme-label>Dark</span>
        </button>
      </div>

      <!-- HERO -->
      <header class="ds__hero">
        <Stack gap="5">
          <div class="ds__hero-eyebrow">
            <span aria-hidden="true">—</span>
            <span>Design System</span>
            <span class="ds__hero-eyebrow-date">2026.05.27</span>
          </div>

          <Heading level={1} size="3xl" class="ds__hero-title">
            A system, <span class="ds__hero-accent">not a collection</span> of one-offs.
          </Heading>

          <Text size="md" tone="muted" leading="relaxed" measure>
            The canonical foundation for devin.vc. Every typographic decision, every color, every animation curve lives here. Build with these primitives. Resist the urge to make new ones.
          </Text>

          <div class="ds__hero-meta">
            <div>
              <span class="ds__hero-meta-no">08</span>
              <Text size="xs" tone="muted" as="span">Foundation tokens</Text>
            </div>
            <div>
              <span class="ds__hero-meta-no">09</span>
              <Text size="xs" tone="muted" as="span">Primitives</Text>
            </div>
            <div>
              <span class="ds__hero-meta-no">∞</span>
              <Text size="xs" tone="muted" as="span">Composable surfaces</Text>
            </div>
          </div>
        </Stack>
      </header>

      <!-- 01 OVERVIEW -->
      <section id="overview" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={1} size="md">Overview</Tag>
          <Heading level={2} size="2xl">The discipline.</Heading>
        </div>
        <Stack gap="5">
          <Text size="lg" tone="default" leading="relaxed" measure>
            This system replaces the dozens of bespoke styles scattered through page sections with a small set of primitives whose variants are sufficient. If you find yourself reaching for a custom <code>font-size</code>, a raw hex value, or a one-off <code>clamp()</code> — stop. Open this page. Find the variant. Or extend the system <em>here</em>, not in the consuming component.
          </Text>
          <Text size="base" tone="muted" leading="relaxed" measure>
            The rules are blunt. No <code>font-family</code> declarations in components — use <code>var(--font-display)</code>, <code>var(--font-body)</code>, or <code>var(--font-mono)</code>. No raw hex outside <code>global.css</code>. No fresh <code>clamp()</code> values for spacing — pick from the eight scale tokens. Animation timing comes from the three duration tokens and two easing curves, nothing else.
          </Text>
        </Stack>
      </section>

      <!-- 02 COLOR -->
      <section id="color" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={2} size="md">Color</Tag>
          <Heading level={2} size="2xl">Warm, restrained, theme-aware.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            All color flows through CSS custom properties defined in <code>global.css</code>. Dark theme is default; light theme swaps via <code>[data-theme="light"]</code>. Toggle above to compare. Never write raw hex values in components.
          </Text>
        </div>

        <div class="ds__swatches">
          {colorTokens.map((tok) => (
            <div class="ds__swatch">
              <div class="ds__swatch-chip" style={`background: var(${tok.name});`}></div>
              <div class="ds__swatch-meta">
                <code class="ds__swatch-name">{tok.name}</code>
                <span class="ds__swatch-desc">{tok.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 03 TYPOGRAPHY -->
      <section id="typography" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={3} size="md">Typography</Tag>
          <Heading level={2} size="2xl">Two voices.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            <strong>Funnel Display</strong> variable for headlines — a technical, architectural sans-serif. <strong>DM Sans</strong> variable for body. <code>var(--font-mono)</code> for code and metadata. No fourth font. Ever.
          </Text>
        </div>

        <Stack gap="5">
          <Card variant="outlined" padding="lg">
            <div class="ds__type-pair">
              <div class="ds__type-pair-col">
                <Text size="xs" tone="muted" weight="medium" as="span" class="ds__type-pair-label">Display · serif</Text>
                <Heading level={3} size="2xl">A quiet partner</Heading>
                <code class="ds__type-pair-token">var(--font-display)</code>
              </div>
              <div class="ds__type-pair-col">
                <Text size="xs" tone="muted" weight="medium" as="span" class="ds__type-pair-label">Body · sans</Text>
                <Heading level={3} size="xl" family="sans">Capital, placed carefully.</Heading>
                <code class="ds__type-pair-token">var(--font-body)</code>
              </div>
            </div>
          </Card>

          <div class="ds__type-scale">
            <div class="ds__type-scale-head">
              <span>Token</span>
              <span>Value</span>
              <span>Sample</span>
            </div>
            {typeScale.map((step) => (
              <div class="ds__type-scale-row">
                <code class="ds__type-scale-token">{step.name}</code>
                <code class="ds__type-scale-value">{step.value}</code>
                <span
                  class={`ds__type-scale-sample ${step.display ? 'ds__type-scale-sample--display' : ''}`}
                  style={`font-size: var(${step.name});`}
                >
                  {step.sample}
                </span>
              </div>
            ))}
          </div>
        </Stack>
      </section>

      <!-- 04 SPACING -->
      <section id="spacing" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={4} size="md">Spacing</Tag>
          <Heading level={2} size="2xl">Eight scales. No more.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            Every padding, margin, and gap pulls from one of these tokens. If a layout needs something between two scales — fix the scale, not the layout.
          </Text>
        </div>

        <Stack gap="4">
          {spacingTokens.map((tok) => (
            <div class="ds__spacing-row">
              <div class="ds__spacing-meta">
                <code class="ds__spacing-name">{tok.name}</code>
                <span class="ds__spacing-desc">{tok.desc}</span>
                <code class="ds__spacing-value">{tok.value}</code>
              </div>
              <div class="ds__spacing-bar-wrap">
                <div class="ds__spacing-bar" style={`width: var(${tok.name});`}></div>
              </div>
            </div>
          ))}
        </Stack>
      </section>

      <!-- 05 MOTION -->
      <section id="motion" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={5} size="md">Motion</Tag>
          <Heading level={2} size="2xl">Two curves. Three speeds.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            Each curve is rendered as a position-vs-time graph. The trailing dot demonstrates the curve in motion. Static SVG ensures the comparison is visible even with <code>prefers-reduced-motion</code>.
          </Text>
        </div>

        <Stack gap="5">
          <div class="ds__motion-grid">
            {easingTokens.map((ez) => (
              <Card variant="outlined" padding="md">
                <Stack gap="3">
                  <div class="ds__motion-head">
                    <code class="ds__motion-name">{ez.name}</code>
                    <code class="ds__motion-value">{ez.value}</code>
                  </div>
                  <svg class="ds__motion-curve" viewBox="-4 -4 108 108" aria-hidden="true">
                    <defs>
                      <pattern id={`grid-${ez.name.replace(/--/g, '')}`} width="20" height="20" patternUnits="userSpaceOnUse">
                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.08" />
                      </pattern>
                    </defs>
                    <rect x="0" y="0" width="100" height="100" fill={`url(#grid-${ez.name.replace(/--/g, '')})`} />
                    <line x1="0" y1="100" x2="100" y2="100" stroke="currentColor" stroke-width="0.6" opacity="0.25" />
                    <line x1="0" y1="0" x2="0" y2="100" stroke="currentColor" stroke-width="0.6" opacity="0.25" />
                    <path d={ez.curve} fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                  <div class="ds__motion-track" data-motion-track>
                    <span class="ds__motion-dot" style={`--ez: ${ez.value};`}></span>
                  </div>
                  <Text size="sm" tone="muted">{ez.use}</Text>
                </Stack>
              </Card>
            ))}
          </div>

          <div class="ds__duration-grid">
            {durationTokens.map((d) => (
              <Card variant="outlined" padding="md">
                <Stack gap="2">
                  <code class="ds__duration-name">{d.name}</code>
                  <Heading level={3} size="lg">{d.value}</Heading>
                  <Text size="sm" tone="muted">{d.use}</Text>
                </Stack>
              </Card>
            ))}
          </div>
        </Stack>
      </section>

      <!-- 06 RADIUS & SHADOW -->
      <section id="surface" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={6} size="md">Surface</Tag>
          <Heading level={2} size="2xl">Edges and depth.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            Radius is small and restrained — 2px on buttons, 4px on cards. Sharp edges read editorial; round edges read consumer-app. Shadows are layered, color-aware, and reserved for genuine elevation.
          </Text>
        </div>

        <div class="ds__shadow-grid">
          <div class="ds__shadow-card" style="box-shadow: var(--shadow-sm);">
            <code>--shadow-sm</code>
            <Text size="sm" tone="muted">Hairline lift</Text>
          </div>
          <div class="ds__shadow-card" style="box-shadow: var(--shadow-md);">
            <code>--shadow-md</code>
            <Text size="sm" tone="muted">Card elevation</Text>
          </div>
          <div class="ds__shadow-card" style="box-shadow: var(--shadow-lg);">
            <code>--shadow-lg</code>
            <Text size="sm" tone="muted">Modal / overlay</Text>
          </div>
        </div>
      </section>

      <!-- 07 HEADING -->
      <section id="heading" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={7} size="md">Heading</Tag>
          <Heading level={2} size="2xl">The voice of the page.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            Semantic level decoupled from visual size. Use <code>level</code> for HTML semantics, <code>size</code> for visual weight. Default family is serif; switch to sans for utility headings.
          </Text>
        </div>

        <Stack gap="5">
          <div class="ds__variant-grid">
            <div class="ds__variant">
              <code class="ds__variant-label">size="4xl"</code>
              <Heading level={3} size="4xl">Quiet capital</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="3xl"</code>
              <Heading level={3} size="3xl">Selected work</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="2xl"</code>
              <Heading level={3} size="2xl">A founder's partner</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="xl"</code>
              <Heading level={3} size="xl">Section heading</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="lg"</code>
              <Heading level={3} size="lg">A softer note</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="md" · family="sans"</code>
              <Heading level={3} size="md" family="sans">Utility heading</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="sm" · family="sans"</code>
              <Heading level={3} size="sm" family="sans">Small label heading</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">tone="muted"</code>
              <Heading level={3} size="lg" tone="muted">Recessed heading</Heading>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">tone="accent"</code>
              <Heading level={3} size="lg" tone="accent">Highlighted</Heading>
            </div>
          </div>

          <pre class="ds__code"><code class="language-svelte">{`<Heading level={1} size="4xl">Quiet capital</Heading>
<Heading level={2} size="3xl">A founder’s partner</Heading>
<Heading level={3} size="md" family="sans">Utility heading</Heading>

// Props
//   level:   1..6                            (semantic)
//   size:    '4xl' | '3xl' | '2xl' | 'xl' | 'lg' | 'md' | 'sm'
//   family:  'serif' | 'sans'                (default: serif)
//   tone:    'default' | 'muted' | 'accent'
//   balance: boolean                         (default: true)
//
// Headings never render italic. Nested <em> tags are normalized.`}</code></pre>
        </Stack>
      </section>

      <!-- 08 TEXT -->
      <section id="text" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={8} size="md">Text</Tag>
          <Heading level={2} size="2xl">Every paragraph, every label.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">
            One component for all non-heading copy. Variants cover size, weight, tone, family, and leading. <code>measure</code> caps line length at 62ch — use it for long-form prose.
          </Text>
        </div>

        <Stack gap="5">
          <div class="ds__variant-grid ds__variant-grid--2">
            <div class="ds__variant">
              <code class="ds__variant-label">size="lg" · leading="relaxed"</code>
              <Text size="lg" leading="relaxed">
                A leading paragraph that sets up the section with a slightly larger, looser feel.
              </Text>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="base" · default</code>
              <Text>
                Body copy. Neutral, readable, set at 1rem with 1.55 line-height. The workhorse.
              </Text>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">tone="muted"</code>
              <Text tone="muted">
                Muted body for secondary information, captions under primary content, supporting prose.
              </Text>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">size="sm" · tone="subtle"</code>
              <Text size="sm" tone="subtle">
                Quiet metadata. Dates, byline, footnotes.
              </Text>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">family="serif" · italic</code>
              <Text family="serif" italic size="lg">
                "Pulled quotes and emphasized prose use the display serif in italic."
              </Text>
            </div>
            <div class="ds__variant">
              <code class="ds__variant-label">family="mono" · tone="accent"</code>
              <Text family="mono" size="sm" tone="accent">
                $ deploy --quiet 2026-05-27
              </Text>
            </div>
          </div>

          <pre class="ds__code"><code class="language-svelte">{`<Text size="lg" leading="relaxed" measure>...</Text>
<Text tone="muted">...</Text>
<Text family="serif" italic>...</Text>

// Props
//   as:      'p' | 'span' | 'div'           (default: p)
//   size:    'xs' | 'sm' | 'base' | 'md' | 'lg'
//   tone:    'default' | 'muted' | 'subtle' | 'accent'
//   weight:  'light' | 'regular' | 'medium'
//   family:  'sans' | 'serif' | 'mono'
//   italic:  boolean
//   leading: 'tight' | 'normal' | 'relaxed'
//   measure: boolean                         (caps at 62ch)`}</code></pre>
        </Stack>
      </section>

      <!-- 09 TAG -->
      <section id="tag" class="ds__sec">
        <div class="ds__sec-head">
          <Tag index={9} size="md">Tag</Tag>
          <Heading level={2} size="2xl">Eyebrows and status.</Heading>
          <Text size="md" tone="muted" measure leading="relaxed">

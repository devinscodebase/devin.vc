<script>
  // ──────────────────────────────────────────────────────
  // Theme toggle (persists to localStorage.theme)
  // ──────────────────────────────────────────────────────
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');
  const syncThemeUi = () => {
    const cur = document.documentElement.getAttribute('data-theme') ?? 'dark';
    if (themeLabel) themeLabel.textContent = cur === 'light' ? 'Light' : 'Dark';
    themeBtn?.setAttribute('aria-pressed', cur === 'light' ? 'true' : 'false');
  };
  themeBtn?.addEventListener('click', () => {
    const cur = document.documentElement.getAttribute('data-theme') ?? 'dark';
    const next = cur === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    syncThemeUi();
  });
  syncThemeUi();

  // ──────────────────────────────────────────────────────
  // Sidebar scroll-spy (sets aria-current="location" + class)
  // ──────────────────────────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.ds__nav a[data-nav]');
  const sections = Array.from(navLinks).map((link) => {
    const id = link.dataset.nav!;
    return { id, link, el: document.getElementById(id) };
  });

  const setActive = (id: string | null) => {
    navLinks.forEach((l) => {
      const active = l.dataset.nav === id;
      l.classList.toggle('is-active', active);
      if (active) l.setAttribute('aria-current', 'location');
      else l.removeAttribute('aria-current');
    });
  };

  const io = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((e) => e.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) setActive(visible.target.id);
    },
    { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
  );

  sections.forEach((s) => s.el && io.observe(s.el));

  // ──────────────────────────────────────────────────────
  // Sidebar collapse: open by default on desktop, closed on mobile
  // ──────────────────────────────────────────────────────
  const sidebarCollapse = document.querySelector<HTMLDetailsElement>('.ds__sidebar-collapse');
  const mq = window.matchMedia('(min-width: 901px)');
  const syncOpen = () => { if (sidebarCollapse) sidebarCollapse.open = mq.matches; };
  syncOpen();
  mq.addEventListener('change', syncOpen);
  // Auto-close on nav click (mobile only)
  navLinks.forEach((l) => l.addEventListener('click', () => { if (!mq.matches && sidebarCollapse) sidebarCollapse.open = false; }));
</script>


---
import Layout from '../../layouts/Layout.astro';
import PostContent from '../../components/PostContent';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const slugs = await reader.collections.journal.list();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const reader = createReader(process.cwd(), keystaticConfig);
const post = await reader.collections.journal.read(slug!);

if (!post) {
  return Astro.redirect('/journal');
}

const content = await post.body();
const formattedDate = new Date(post.date!).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const seoTitle = post.seoTitle || `${post.title} — Devin Alexander`;
const ogImage = post.ogImage || post.heroImage || undefined;
---

<Layout
  title={seoTitle}
  description={post.description}
  image={ogImage}
  type="article"
  publishedDate={post.date || undefined}
  noIndex={post.noIndex}
>
  <main>
    <article class="post">
      <div class="post-inner">
        <header class="post-header">
          <a href="/journal" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Journal
          </a>
          <div class="post-meta">
            <span class="post-tag">{post.tag}</span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <time datetime={post.date!}>{formattedDate}</time>
          </div>
          <h1 class="post-title">{post.title}</h1>
          <p class="post-description">{post.description}</p>
        </header>

        {post.heroImage && (
          <figure class="hero-image">
            <img src={post.heroImage} alt={post.heroAlt || ''} loading="eager" />
          </figure>
        )}

        <div class="post-body prose">
          <PostContent document={content} />
        </div>

        <footer class="post-footer">
          <a href="/journal" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back to Journal
          </a>
        </footer>
      </div>
    </article>
  </main>
</Layout>

<style>
  .post {
    min-height: 100dvh;
    padding: clamp(8rem, 18vh, 12rem) clamp(1.5rem, 5vw, 3.5rem) clamp(4rem, 10vh, 8rem);
    background: var(--color-bg);
  }

  .post-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  .post-header {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-meta .post-tag {
    color: var(--color-accent);
    font-weight: 500;
  }

  .meta-sep {
    opacity: 0.3;
  }

  .post-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 1rem 0 0.75rem;
  }

  .post-description {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero-image {
    margin: 0 calc(-1 * clamp(1rem, 3vw, 2rem)) clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Prose typography for post body */
  .prose {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin: 2.5rem 0 1rem;
  }

  .prose :global(h3) {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text);
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    margin: 0 0 1.5rem;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    transition: text-decoration-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: color-mix(in oklab, var(--color-text-muted) 20%, transparent);
    margin: 2.5rem 0;
  }

  .prose :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88em;
    background: color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 2rem 0;
  }

  .post-footer {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { PortableText, toPlainText } from 'astro-portabletext';
import { sanityClient, urlFor } from '../../lib/sanity';
import ExternalLink from '../../components/portable-text/ExternalLink.astro';
import Heading from '../../components/portable-text/Heading.astro';
import BodyImage from '../../components/portable-text/BodyImage.astro';

export const prerender = false;

const { slug } = Astro.params;

const post = await sanityClient.fetch(
  `*[_type == "journal" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    description,
    tag,
    date,
    featured,
    heroImage,
    heroAlt,
    ogImage,
    seoTitle,
    noIndex,
    body
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect('/journal');
}

const adjacentPosts = await sanityClient.fetch(
  `{
    "next": *[_type == "journal" && date > $date] | order(date asc)[0] {
      title, "slug": slug.current, tag, date
    },
    "prev": *[_type == "journal" && date < $date] | order(date desc)[0] {
      title, "slug": slug.current, tag, date
    }
  }`,
  { date: post.date }
);

const nextPost = adjacentPosts?.next;
const prevPost = adjacentPosts?.prev;

const formattedDate = new Date(post.date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const plainBody = post.body ? toPlainText(post.body) : '';
const wordCount = plainBody.split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(wordCount / 238));

// Extract headings for table of contents
const headings = (post.body || [])
  .filter((block: any) => block._type === 'block' && (block.style === 'h2' || block.style === 'h3'))
  .map((block: any) => {
    const text = block.children?.map((c: any) => c.text || '').join('') || '';
    const id = text.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
    return { text, id, level: block.style };
  });
const showToc = headings.length >= 2;

const postUrl = `https://devin.vc/journal/${post.slug}`;
const seoTitle = post.seoTitle || `${post.title}, Devin Alexander`;
const ogImage = post.ogImage
  ? urlFor(post.ogImage).width(1200).url()
  : post.heroImage
    ? urlFor(post.heroImage).width(1200).url()
    : `/og/journal/${post.slug}.png`;
---

<Layout
  title={seoTitle}
  description={post.description}
  image={ogImage}
  type="article"
  publishedDate={post.date || undefined}
  noIndex={post.noIndex}
  hideScrollProgress
>
  <div class="progress-bar" aria-hidden="true"></div>
  <main>
    <article class="post">
      <div class="post-inner">
        <header class="post-header reveal">
          <a href="/journal" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Journal
          </a>
          <div class="post-meta">
            <span class="post-tag">{post.tag}</span>
            <span class="meta-sep" aria-hidden="true"></span>
            <time datetime={post.date!}>{formattedDate}</time>
            <span class="meta-sep" aria-hidden="true"></span>
            <span class="read-time">{readTime} min read</span>
          </div>
          <h1 class="post-title">{post.title}</h1>
          <p class="post-description">{post.description}</p>
          <div class="title-rule" aria-hidden="true"></div>
        </header>

        {post.heroImage && (
          <figure class="hero-image reveal" style="--reveal-i: 1">
            <img src={urlFor(post.heroImage).width(1200).url()} alt={post.heroAlt || ''} loading="eager" />
          </figure>
        )}

        {showToc && (
          <nav class="toc collapsed" aria-label="Table of contents">
            <button class="toc-toggle" type="button" aria-expanded="false">
              <span class="toc-label">Contents</span>
              <svg class="toc-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 4.5L6 7.5L9 4.5" />
              </svg>
            </button>
            <ol class="toc-list">
              {headings.map((h: { text: string; id: string; level: string }) => (
                <li class={h.level === 'h3' ? 'toc-h3' : ''}>
                  <a href={`#${h.id}`} class="toc-link">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="post-body prose">
          <PortableText
            value={post.body}
            components={{
              mark: { link: ExternalLink },
              block: { h2: Heading, h3: Heading },
              type: { image: BodyImage },
            }}
          />
        </div>

        <footer class="post-footer">
          <div class="author-card">
            <div class="author-info">
              <img class="author-avatar" src="/images/author.jpg" alt="Devin Alexander" width="40" height="40" loading="lazy" />
              <div class="author-details">
                <span class="author-name">Devin Alexander</span>
                <span class="author-bio">A decade of executive leadership in marketing, ops, and design.</span>
              </div>
            </div>
            <div class="author-links">
              <a href="https://x.com/devinhelps" target="_blank" rel="noopener" class="author-social" aria-label="X (Twitter)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/devalexander/" target="_blank" rel="noopener" class="author-social" aria-label="LinkedIn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>
          <div class="share-row">
            <button class="share-btn" data-action="copy" type="button">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              <span class="share-label">Copy link</span>
            </button>
            <a class="share-btn" href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span class="share-label">Share</span>
            </a>
            <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <span class="share-label">Share</span>
            </a>
          </div>
          <a href="/journal" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back to Journal
          </a>
        </footer>

        {(nextPost || prevPost) && (
          <nav class="keep-reading" aria-label="More articles">
            <span class="keep-reading-label">Keep reading</span>
            <div class="keep-reading-cards">
              {nextPost && (
                <a href={`/journal/${nextPost.slug}`} class="kr-card">
                  <div class="kr-card-meta">
                    {nextPost.tag && <span class="kr-tag">{nextPost.tag}</span>}
                    <time datetime={nextPost.date}>
                      {new Date(nextPost.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                  </div>
                  <span class="kr-title">{nextPost.title}</span>
                  <svg class="kr-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
              )}
              {prevPost && (
                <a href={`/journal/${prevPost.slug}`} class="kr-card">
                  <div class="kr-card-meta">
                    {prevPost.tag && <span class="kr-tag">{prevPost.tag}</span>}
                    <time datetime={prevPost.date}>
                      {new Date(prevPost.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                  </div>
                  <span class="kr-title">{prevPost.title}</span>
                  <svg class="kr-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </article>
  </main>
  <button class="scroll-top" type="button" aria-label="Scroll to top" hidden>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 13V3M4 6l4-4 4 4" />
    </svg>
  </button>
</Layout>

<script>
  // Entrance fades handled by the global .reveal utility.
  // Apply .reveal to the first 5 body children once at load (article DOM
  // comes from rendered portable text so we can't author them with .reveal).
  const postBody = document.querySelector('.post-body');
  if (postBody) {
    const children = Array.from(postBody.children).slice(0, 5) as HTMLElement[];
    children.forEach((el, i) => {
      el.classList.add('reveal');
      el.style.setProperty('--reveal-i', String(i));
    });
  }

  // TOC toggle
  const tocToggle = document.querySelector('.toc-toggle');
  const toc = document.querySelector('.toc');
  if (tocToggle && toc) {
    tocToggle.addEventListener('click', () => {
      const isCollapsed = toc.classList.toggle('collapsed');
      tocToggle.setAttribute('aria-expanded', String(!isCollapsed));
    });

    // Smooth scroll for TOC links
    toc.querySelectorAll('.toc-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (link as HTMLAnchorElement).getAttribute('href');
        if (!href) return;
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // Collapse TOC on mobile after clicking
          if (window.innerWidth < 481) {
            toc.classList.add('collapsed');
            tocToggle.setAttribute('aria-expanded', 'false');
          }
        }
      });
    });
  }

  // Reading progress bar
  const progressBar = document.querySelector('.progress-bar') as HTMLElement;
  if (progressBar) {
    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      progressBar.style.width = `${pct}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Copy link button
  const copyBtn = document.querySelector('[data-action="copy"]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const label = copyBtn.querySelector('.share-label');
        if (label) {
          const orig = label.textContent;
          label.textContent = 'Copied!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            label.textContent = orig;
            copyBtn.classList.remove('copied');
          }, 2000);
        }
      } catch { /* clipboard not available */ }
    });
  }

  // Scroll-to-top button
  const scrollTopBtn = document.querySelector('.scroll-top') as HTMLElement;
  const headerEl = document.querySelector('.post-header') as HTMLElement;
  if (scrollTopBtn && headerEl) {
    let visible = false;
    const check = () => {
      const rect = headerEl.getBoundingClientRect();
      const shouldShow = rect.bottom < 0;
      if (shouldShow !== visible) {
        visible = shouldShow;
        scrollTopBtn.hidden = !visible;
        if (visible) {
          scrollTopBtn.style.opacity = '0';
          scrollTopBtn.style.transform = 'translateY(8px)';
          requestAnimationFrame(() => {
            scrollTopBtn.style.opacity = '1';
            scrollTopBtn.style.transform = 'translateY(0)';
          });
        }
      }
    };
    window.addEventListener('scroll', check, { passive: true });
    check();

    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* Entrance fades handled by the global .reveal utility. */

  .post {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .post-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  .post-header {
    margin-bottom: clamp(3rem, 6vw, 4rem);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-meta .post-tag {
    color: var(--color-accent-teal);
    font-weight: var(--weight-medium);
  }

  .meta-sep {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 1rem 0 0.75rem;
  }

  .post-description {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .title-rule {
    width: clamp(56px, 12%, 80px);
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    margin-top: clamp(1.5rem, 3vw, 2rem);
    border-radius: 1px;
  }

  .hero-image {
    margin: 0 calc(-1 * clamp(1rem, 3vw, 2rem)) clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Prose typography for post body */
  .prose {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 3rem 0 1rem;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: 1.3;
    color: var(--color-text);
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(p) {
    margin: 0 0 1.85rem;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    transition: text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(.external-link) {
    display: inline;
  }

  .prose :global(.ext-icon) {
    display: inline-block;
    margin-left: 0.15em;
    vertical-align: baseline;
    position: relative;
    top: -0.05em;
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-fast) var(--ease-out-expo);
  }

  .prose :global(.external-link:hover .ext-icon) {
    opacity: 0.8;
    transform: translate(1px, -1px);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(li::marker) {
    color: var(--color-accent-teal);
  }

  .prose :global(blockquote) {
    position: relative;
    border-left: 2px solid var(--color-accent-teal);
    margin: 2rem 0 2rem -0.5rem;
    padding: 1.25rem 1.5rem 1.25rem 1.5rem;
    background: color-mix(in oklab, var(--color-accent-teal) 4%, transparent);
    border-radius: 0 6px 6px 0;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 1.15em;
    line-height: 1.6;
  }

  .prose :global(blockquote)::before {
    content: '\201C';
    position: absolute;
    top: -0.15rem;
    left: 0.75rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-accent-teal);
    opacity: 0.15;
    pointer-events: none;
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-text-muted) 20%, transparent) 20%, color-mix(in oklab, var(--color-text-muted) 20%, transparent) 80%, transparent);
    margin: 3rem 0;
  }

  .prose :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88em;
    background: color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    background: color-mix(in oklab, var(--color-text-muted) 8%, transparent);
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
  }

  .prose :global(.body-image) {
    margin: 2.5rem 0;
  }

  .prose :global(.body-image-border) {
    padding: 1px;
    border-radius: 10px;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      var(--color-accent-amber) 40%,
      var(--color-accent-rust) 70%,
      var(--color-accent-teal) 100%
    );
  }

  .prose :global(.body-image img) {
    display: block;
    border-radius: 9px;
    margin: 0;
  }

  .prose :global(.body-image figcaption) {
    margin-top: 0.75rem;
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-text-muted, #888);
    text-align: center;
  }

  .post-footer {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .author-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1.5px solid color-mix(in oklab, var(--color-accent-teal) 30%, transparent);
  }

  .author-details {

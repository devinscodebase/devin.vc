---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Devin`}>
  <main class="min-h-screen py-24 sm:py-32 px-8 sm:px-16 md:px-24">
    <article class="max-w-2xl mx-auto">
      <a
        href="/journal"
        class="inline-block text-xs font-medium tracking-[0.15em] uppercase text-alloy hover:text-burnt transition-colors duration-200 mb-16"
      >
        &larr; Journal
      </a>

      <time class="block text-xs font-medium tracking-[0.1em] text-rich-black/30">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="font-sans text-3xl sm:text-4xl md:text-5xl text-rich-black mt-2 mb-12 font-bold leading-[1.15]">
        {post.data.title}
      </h1>

      <div class="prose">
        <Content />
      </div>

      {post.data.tags && (
        <div class="flex gap-3 mt-16 pt-8 border-t border-rich-black/8">
          {post.data.tags.map((tag) => (
            <span class="text-[0.6875rem] font-medium tracking-wider uppercase text-rich-black/25">
              {tag}
            </span>
          ))}
        </div>
      )}
    </article>
  </main>
  <Footer />
</Layout>

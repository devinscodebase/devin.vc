---
import Layout from '../../layouts/Layout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

const posts = await sanityClient.fetch(`
  *[_type == "journal"] | order(date desc) {
    title,
    "slug": slug.current,
    description,
    tag,
    date,
    featured,
    heroImage,
    heroAlt
  }
`);

const featuredPost = posts.find(p => p.featured) || posts[0];
const remainingPosts = posts.filter(p => p !== featuredPost);
const accentColors = ['teal', 'amber', 'rust', 'teal', 'amber', 'rust'];
---

<Layout title="Journal — Devin Alexander" description="Essays on marketing, leadership, and building things that matter.">
  <main>
    <section class="journal-page">
      <div class="journal-page-inner">
        <header class="page-header">
          <div class="section-tag"><span class="tag-number">01</span><span class="tag-dash" aria-hidden="true"></span><span class="tag-label">Journal</span></div>
          <h1 class="page-title">Journal</h1>
          <p class="page-subtitle">Essays on <span class="sub-accent teal">marketing</span>, <span class="sub-accent amber">leadership</span>, and building things that <span class="sub-accent rust">matter</span>.</p>
        </header>

        {featuredPost && (
          <a href={`/journal/${featuredPost.slug}`} class:list={['featured-card', { 'has-image': !!featuredPost.heroImage }]}>
            <div class="featured-accent" aria-hidden="true"></div>
            {featuredPost.heroImage && (
              <div class="featured-image-wrap">
                <img class="featured-image" src={urlFor(featuredPost.heroImage).width(1000).url()} alt={featuredPost.heroAlt || ''} loading="eager" />
              </div>
            )}
            <div class="featured-content">
              <div class="featured-meta">
                <span class="featured-badge">Featured</span>
                <span class="meta-dot" aria-hidden="true"></span>
                <span class="post-tag">{featuredPost.tag}</span>
              </div>
              <h2 class="featured-title">{featuredPost.title}</h2>
              <p class="featured-excerpt">{featuredPost.description}</p>
              <time class="post-date" datetime={featuredPost.date!}>
                {new Date(featuredPost.date!).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
          </a>
        )}

        {remainingPosts.length > 0 && (
          <div class="posts-grid">
            {remainingPosts.map((post, i) => (
              <a href={`/journal/${post.slug}`} class="post-card" style={`--accent: var(--color-accent-${accentColors[i % accentColors.length]})`}>
                <span class="card-index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
                {post.heroImage && (
                  <div class="card-image-wrap">
                    <img class="card-image" src={urlFor(post.heroImage).width(800).url()} alt={post.heroAlt || ''} loading="lazy" />
                  </div>
                )}
                <div class="card-content">
                  <span class="post-tag" style={`color: var(--accent)`}>{post.tag}</span>
                  <h2 class="post-title">{post.title}</h2>
                  <p class="post-excerpt">{post.description}</p>
                  <time class="post-date" datetime={post.date!}>
                    {new Date(post.date!).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  </time>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { animate, inView } from 'motion';

  const header = document.querySelector('.page-header');
  if (header) {
    header.style.opacity = '0';
    inView(header, () => {
      animate(header, { opacity: [0, 1], y: [12, 0] }, {
        duration: 0.4,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.3 });
  }

  const featured = document.querySelector('.featured-card');
  if (featured) {
    featured.style.opacity = '0';
    inView(featured, () => {
      animate(featured, { opacity: [0, 1], y: [15, 0] }, {
        duration: 0.4,
        delay: 0.08,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.15 });
  }

  const featuredEl = document.querySelector('.featured-card');
  if (featuredEl) {
    // Spring hover — gentle lift + image zoom
    const featImg = featuredEl.querySelector('.featured-image');
    featuredEl.addEventListener('mouseenter', () => {
      animate(featuredEl, { y: -3 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      if (featImg) animate(featImg, { scale: 1.03 }, { duration: 0.3, easing: [0.16, 1, 0.3, 1] });
    });
    featuredEl.addEventListener('mouseleave', () => {
      animate(featuredEl, { y: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      if (featImg) animate(featImg, { scale: 1 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
    });
  }

  const cards = document.querySelectorAll('.post-card');
  cards.forEach(card => {
    card.style.opacity = '0';
    inView(card, () => {
      animate(card, { opacity: [0, 1], y: [15, 0] }, {
        duration: 0.4,
        easing: [0.25, 1, 0.5, 1],
      });
    }, { amount: 0.15 });

    // Spring hover — lift card + shift title
    card.addEventListener('mouseenter', () => {
      const title = card.querySelector('.post-title');
      const img = card.querySelector('.card-image');
      animate(card, { y: -4 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      if (title) animate(title, { x: 4 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      if (img) animate(img, { scale: 1.03 }, { duration: 0.3, easing: [0.16, 1, 0.3, 1] });
    });
    card.addEventListener('mouseleave', () => {
      const title = card.querySelector('.post-title');
      const img = card.querySelector('.card-image');
      animate(card, { y: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      if (title) animate(title, { x: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      if (img) animate(img, { scale: 1 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
    });
  });
</script>

<style>
  .journal-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .journal-page-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0;
  }

  .sub-accent { font-style: normal; }
  .sub-accent.teal { color: var(--color-accent-teal); }
  .sub-accent.amber { color: var(--color-accent-amber); }
  .sub-accent.rust { color: var(--color-accent-rust); }

  /* ---- Featured card ---- */
  .featured-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    margin-bottom: var(--space-block-lg);
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-card:hover {
    border-color: color-mix(in oklab, var(--color-accent-teal) 30%, transparent);
  }

  .featured-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent), var(--color-accent-amber));
    z-index: 2;
  }

  .featured-image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .featured-image {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  .featured-content {
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .featured-badge {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in oklab, var(--color-accent-teal) 30%, transparent);
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-text-muted);
    opacity: 0.4;
  }

  .featured-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 0.75rem;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured-card:hover .featured-title {
    color: var(--color-accent-teal);
  }

  .featured-excerpt {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0;
  }

  /* ---- Shared meta ---- */
  .post-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
  }

  .post-date {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  /* ---- Post cards grid ---- */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-left: 2px solid transparent;
    transition: border-left-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card:hover {
    border-left-color: var(--accent);
    background-color: color-mix(in oklab, var(--color-text-muted) 3%, transparent);
  }

  .card-index {
    position: absolute;
    right: clamp(1rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 1.5vw, 1rem);
    font-family: 'Instrument Serif', serif;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    opacity: 0.04;
    pointer-events: none;
    color: var(--color-text);
  }

  .card-image-wrap {
    margin: calc(-1 * clamp(1.5rem, 3vw, 2.5rem));
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    position: relative;
    z-index: 1;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-excerpt {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.82rem, 1.1vw, 0.9rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  /* ---- Footer ---- */
  .page-footer {
    margin-top: var(--space-block-lg);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  @media (max-width: 640px) {
    .featured-card.has-image {
      flex-direction: column;
    }

    .featured-image {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 641px) {
    .posts-grid {
      grid-template-columns: 1fr 1fr;
    }

    .featured-card.has-image {
      flex-direction: row;
    }

    .featured-image-wrap {
      width: 50%;
      flex-shrink: 0;
    }

    .featured-image {
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>

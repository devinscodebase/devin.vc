---
import Layout from '../../layouts/Layout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

const posts = await sanityClient.fetch(`
  *[_type == "journal"] | order(date desc) {
    title,
    "slug": slug.current,
    description,
    tag,
    date,
    featured,
    heroImage,
    heroAlt
  }
`);
---

<Layout title="Journal — Devin Alexander" description="Essays on marketing, leadership, and building things that matter.">
  <main>
    <section class="journal-page">
      <div class="journal-page-inner">
        <header class="page-header">
          <h1 class="page-title">Journal</h1>
          <p class="page-subtitle">Essays on marketing, leadership, and building things that matter.</p>
          <div class="header-rule" aria-hidden="true"></div>
        </header>

        <div class="posts-grid">
          {posts.map((post, i) => (
            <a href={`/journal/${post.slug}`} class:list={['post-card', { featured: post.featured, 'has-image': !!post.heroImage }]} style={`--delay: ${i * 0.1}s`}>
              {post.featured && <div class="post-accent" aria-hidden="true"></div>}
              {post.heroImage && (
                <img class="card-image" src={urlFor(post.heroImage).width(800).url()} alt={post.heroAlt || ''} loading="lazy" />
              )}
              <div class="card-content">
                <span class="post-tag">{post.tag}</span>
                <h2 class="post-title">{post.title}</h2>
                <p class="post-excerpt">{post.description}</p>
                <time class="post-date" datetime={post.date!}>
                  {new Date(post.date!).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </time>
              </div>
            </a>
          ))}
        </div>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .journal-page {
    min-height: 100dvh;
    padding: clamp(8rem, 18vh, 12rem) clamp(1.5rem, 5vw, 3.5rem) clamp(4rem, 10vh, 8rem);
    background: var(--color-bg);
  }

  .journal-page-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0;
  }

  .header-rule {
    width: 48px;
    height: 1px;
    background: var(--color-accent-teal);
    margin-top: 2rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--color-accent-amber) 40%, transparent);
  }

  .post-card.featured {
    grid-column: 1 / -1;
  }

  .post-card.has-image.featured {
    flex-direction: row;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    overflow: hidden;
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
  }

  .post-card.has-image.featured .card-image {
    width: 45%;
    flex-shrink: 0;
    aspect-ratio: auto;
    min-height: 100%;
  }

  .post-card.has-image.featured .card-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  .post-card:not(.featured) .card-image {
    margin: calc(-1 * clamp(1.5rem, 3vw, 2.5rem));
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    width: calc(100% + 2 * clamp(1.5rem, 3vw, 2.5rem));
  }

  .post-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
  }

  .post-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-card:hover .post-title {
    color: var(--color-accent-amber);
  }

  .post-card.featured .post-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .post-excerpt {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.82rem, 1.1vw, 0.9rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
  }

  .post-date {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .page-footer {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .post-card.has-image.featured {
      flex-direction: column;
    }

    .post-card.has-image.featured .card-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      min-height: auto;
    }

    .post-card.has-image.featured .card-content {
      padding: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @media (min-width: 641px) {
    .posts-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

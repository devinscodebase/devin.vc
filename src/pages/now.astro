---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const nowEntries = await getCollection('now');
const nowEntry = nowEntries[0];
const { Content } = nowEntry ? await render(nowEntry) : { Content: null };
---

<Layout title="Now — Devin">
  <main class="min-h-screen py-24 sm:py-32 px-8 sm:px-16 md:px-24">
    <div class="max-w-2xl mx-auto">
      <a
        href="/"
        class="inline-block text-xs font-medium tracking-[0.15em] uppercase text-alloy hover:text-burnt transition-colors duration-200 mb-16"
      >
        &larr; Home
      </a>

      <h1 class="font-sans text-3xl sm:text-4xl font-light text-rich-black mb-12 leading-tight">
        Now
      </h1>

      {Content && (
        <div class="prose">
          <Content />
        </div>
      )}

      {nowEntry?.data.updated && (
        <p class="text-rich-black/25 text-xs tracking-wider mt-20">
          Last updated {nowEntry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      )}
    </div>
  </main>
  <Footer />
</Layout>

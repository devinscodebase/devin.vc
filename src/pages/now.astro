---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const nowEntries = await getCollection('now');
const nowEntry = nowEntries[0];
const { Content } = nowEntry ? await render(nowEntry) : { Content: null };
---

<Layout title="Now — Devin">
  <main class="min-h-screen bg-sand py-24 px-6 sm:px-12 md:px-24">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-display text-4xl sm:text-5xl text-rich-black mb-12">Now</h1>
      {Content && (
        <div class="font-sans text-rich-black/80 text-base sm:text-lg leading-relaxed
          [&_h2]:font-sans [&_h2]:text-rich-black [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-3
          [&_a]:text-alloy [&_a]:underline [&_a]:underline-offset-4
          [&_p]:mb-4">
          <Content />
        </div>
      )}
      {nowEntry?.data.updated && (
        <p class="font-sans text-rich-black/30 text-sm mt-16">
          Last updated {nowEntry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      )}
      <a href="/" class="inline-block mt-8 font-sans text-alloy hover:text-burnt transition-colors underline underline-offset-4">
        &larr; Back home
      </a>
    </div>
  </main>
  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

const projects = await sanityClient.fetch(`
  *[_type == "project"] | order(order asc) {
    name, url, category, description, contribution, tags, accent, screenshot, order
  }
`);
---

<Layout title="Projects — Devin Alexander" description="A look at some of the platforms and brands I've helped build." image="/api/og.png?type=projects">
  <main>
    <section class="projects-page">
      <div class="projects-inner">
        <header class="page-header">
          <div class="section-tag"><span class="tag-number">01</span><span class="tag-dash" aria-hidden="true"></span><span class="tag-label">Projects</span></div>
          <h1 class="page-title">Selected work</h1>
          <p class="page-subtitle">A look at some of the <span class="sub-accent teal">platforms</span> and <span class="sub-accent amber">brands</span> I've helped build.</p>
          <div class="title-rule" aria-hidden="true"></div>
        </header>

        <div class="project-list">
          {projects.map((project: any, i: number) => (
            <article class={`project project--${project.accent}`}>
              {project.screenshot ? (
                <a href={project.url} target="_blank" rel="noopener" class="project-screenshot-link">
                  <div class={`project-screenshot project-screenshot--${project.accent}`}>
                    <img
                      src={urlFor(project.screenshot).width(960).height(600).fit('crop').crop('top').quality(90).auto('format').url()}
                      srcset={`${urlFor(project.screenshot).width(640).height(400).fit('crop').crop('top').quality(85).auto('format').url()} 640w, ${urlFor(project.screenshot).width(960).height(600).fit('crop').crop('top').quality(90).auto('format').url()} 960w`}
                      sizes="(max-width: 640px) 280px, 320px"
                      alt={`${project.name} website screenshot`}
                      width="960"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="screenshot-overlay"></div>
                  </div>
                </a>
              ) : (
                <div class="project-screenshot-placeholder"></div>
              )}

              <div class="project-content">
                <div class="project-head">
                  <span class="project-category">{project.category}</span>
                  <h2 class="project-name">{project.name}</h2>
                </div>

                <p class="project-desc">{project.description}</p>
                <p class="project-role">{project.contribution}</p>

                <div class="project-footer">
                  <div class="project-tags">
                    {project.tags.map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <a href={project.url} target="_blank" rel="noopener" class="project-link">
                    Visit
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3.5 8.5L8.5 3.5M8.5 3.5H4M8.5 3.5V8" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { animate, inView, stagger } from 'motion';

  const isVtNav = window.__vtNav;
  const header = document.querySelector('.page-header');
  const projects = document.querySelectorAll('.project');

  if (!isVtNav) {
    if (header) {
      header.style.opacity = '0';
      inView(header, () => {
        animate(header, { opacity: [0, 1], y: [12, 0] }, {
          duration: 0.4,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.3 });
    }

    projects.forEach(p => { p.style.opacity = '0'; });
    projects.forEach((project, i) => {
      inView(project, () => {
        animate(project, { opacity: [0, 1], y: [15, 0] }, {
          duration: 0.4,
          delay: 0.05,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.15 });
    });
  }

  // Spring hover on project cards
  projects.forEach(project => {
    const link = project.querySelector('.project-link');
    if (link) {
      project.addEventListener('mouseenter', () => {
        animate(link, { x: 3 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      });
      project.addEventListener('mouseleave', () => {
        animate(link, { x: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      });
    }
  });
</script>

<style>
  .projects-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .projects-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag-label {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0;
  }

  .sub-accent { font-style: normal; }
  .sub-accent.teal { color: var(--color-accent-teal); }
  .sub-accent.amber { color: var(--color-accent-amber); }

  .title-rule {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---- Project list ---- */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ---- Project card ---- */
  .project {
    display: grid;
    grid-template-columns: clamp(200px, 30%, 320px) 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project:last-child {
    border-bottom: none;
  }

  .project:hover {
    border-color: color-mix(in oklab, var(--color-text-muted) 25%, transparent);
  }

  /* ---- Content ---- */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }

  .project-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .project-category {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project--teal .project-category { color: var(--color-accent-teal); }
  .project--amber .project-category { color: var(--color-accent-amber); }
  .project--rust .project-category { color: var(--color-accent-rust); }

  .project-name {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }

  /* ---- Screenshot ---- */
  .project-screenshot-link {
    display: block;
    text-decoration: none;
  }

  .project-screenshot {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    transition: transform var(--duration-normal) var(--ease-out-expo),
                box-shadow var(--duration-normal) var(--ease-out-expo);
  }

  .project-screenshot-link:hover .project-screenshot {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .project-screenshot--teal {
    box-shadow: var(--shadow-md), 0 0 0 1px color-mix(in oklab, var(--color-accent-teal) 8%, transparent);
  }

  .project-screenshot--amber {
    box-shadow: var(--shadow-md), 0 0 0 1px color-mix(in oklab, var(--color-accent-amber) 8%, transparent);
  }

  .project-screenshot--rust {
    box-shadow: var(--shadow-md), 0 0 0 1px color-mix(in oklab, var(--color-accent-rust) 8%, transparent);
  }

  .project-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .screenshot-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--color-bg) 40%, transparent);
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .project-screenshot-link:hover .screenshot-overlay {
    opacity: 0;
  }

  .project-screenshot-placeholder {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    background: color-mix(in oklab, var(--color-text-muted) 5%, transparent);
  }

  .project-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text);
    margin: 0;
    max-width: 600px;
  }

  .project-role {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 600px;
  }

  /* ---- Footer row: tags + link ---- */
  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(0.5rem, 1vw, 0.75rem);
    flex-wrap: wrap;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    padding: 0.3rem 0.65rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  .project-link svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-link:hover svg {
    transform: translate(2px, -2px);
  }

  /* ---- Page footer ---- */
  .page-footer {
    margin-top: var(--space-block);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  @media (max-width: 640px) {
    .project {
      grid-template-columns: 1fr;
      gap: clamp(1rem, 2vw, 1.25rem);
    }

    .project-screenshot-link,
    .project-screenshot-placeholder {
      max-width: 280px;
    }
  }
</style>

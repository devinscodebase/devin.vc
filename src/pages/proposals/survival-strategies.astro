<script>
  import { animate, inView } from 'motion';

  // ─── Password gate handling ───
  const gateForm = document.querySelector<HTMLFormElement>('.gate-form');
  const gateInner = document.querySelector<HTMLElement>('.gate-inner');
  if (gateForm && gateInner) {
    const input = gateForm.querySelector<HTMLInputElement>('input[name="password"]');
    const submitBtn = gateForm.querySelector<HTMLButtonElement>('.gate-submit');
    const submitLabel = gateForm.querySelector<HTMLElement>('.gate-submit-label');
    const messageEl = gateForm.querySelector<HTMLElement>('.gate-message');

    const setState = (state: 'idle' | 'loading' | 'error' | 'success') => {
      gateInner.dataset.state = state;
      if (state === 'loading') {
        submitBtn?.setAttribute('disabled', 'true');
        input?.setAttribute('disabled', 'true');
        if (submitLabel) submitLabel.textContent = submitLabel.dataset.labelLoading || 'Checking…';
      } else if (state === 'idle') {
        submitBtn?.removeAttribute('disabled');
        input?.removeAttribute('disabled');
        if (submitLabel) submitLabel.textContent = submitLabel.dataset.labelDefault || 'Continue';
      }
    };

    gateForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (gateInner.dataset.state === 'loading' || gateInner.dataset.state === 'success') return;

      // Capture form data BEFORE disabling inputs — disabled inputs are excluded from FormData.
      const formData = new FormData(gateForm);

      if (messageEl) messageEl.textContent = '';
      setState('loading');

      try {
        const response = await fetch(window.location.href, {
          method: 'POST',
          body: formData,
        });

        const data = await response.json() as { ok: boolean; error?: string };

        if (response.ok && data.ok) {
          setState('success');
          // Wait for the success animation to play, then load the proposal.
          window.setTimeout(() => {
            window.location.reload();
          }, 1400);
        } else {
          setState('error');
          if (messageEl) messageEl.textContent = data.error || 'Something went wrong.';
          // Restore the form to idle after a brief moment.
          window.setTimeout(() => {
            setState('idle');
            input?.focus();
            input?.select();
          }, 400);
        }
      } catch (err) {
        setState('error');
        if (messageEl) messageEl.textContent = 'Network error. Try again.';
        window.setTimeout(() => setState('idle'), 400);
      }
    });
  }

  const isVtNav = (window as any).__vtNav;
  if (!isVtNav) {
    // Initial opacity:0 is set via CSS (html.js-ready selector) so the elements
    // never paint visible — no FOUC, no inline style means no global fallback
    // animation conflict. motion animates from CSS-applied opacity:0 to 1.
    const header = document.querySelector('.page-header') as HTMLElement | null;
    if (header) {
      inView(header, () => {
        animate(header, { opacity: [0, 1], y: [12, 0] }, {
          duration: 0.5,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.3 });
    }

    const sections = document.querySelectorAll<HTMLElement>('.section');
    sections.forEach((section, i) => {
      inView(section, () => {
        animate(section, { opacity: [0, 1], y: [10, 0] }, {
          duration: 0.5,
          delay: 0.05,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.15 });
    });

    const tiers = document.querySelectorAll<HTMLElement>('.tier');
    tiers.forEach((tier, i) => {
      inView(tier, () => {
        animate(tier, { opacity: [0, 1], y: [12, 0] }, {
          duration: 0.5,
          delay: i * 0.06,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.1 });
    });
  }
</script>

<style>
  /* ═══════════════════════════════════════
     PASSWORD GATE — devin.vc-aligned
     States: idle, loading, error, success
     ═══════════════════════════════════════ */
  .gate-page {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }

  /* Soft accent glow in the background, subtle */
  .gate-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 50% 35%,
        color-mix(in oklab, var(--color-accent) 6%, transparent) 0%,
        transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .gate-inner {
    width: 100%;
    max-width: 460px;
    position: relative;
    z-index: 1;
  }

  /* Form wrap (idle / loading / error states) */
  .gate-form-wrap {
    transition: opacity 0.45s var(--ease-out-expo),
                transform 0.45s var(--ease-out-expo),
                filter 0.45s var(--ease-out-expo);
  }

  .gate-inner[data-state="success"] .gate-form-wrap {
    opacity: 0;
    transform: translateY(-12px);
    filter: blur(4px);
    pointer-events: none;
  }

  .gate-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: clamp(1rem, 2vw, 1.5rem) 0 0.75rem;
  }

  .gate-subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .gate-page .title-rule {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .gate-form {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* Shake on error */
  .gate-inner[data-state="error"] .gate-form {
    animation: gate-shake 0.42s var(--ease-out-expo);
  }

  @keyframes gate-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(7px); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(4px); }
  }

  /* Field — underline-only editorial style */
  .gate-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .gate-field-label {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .gate-input {
    appearance: none;
    width: 100%;
    padding: 0.5rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 30%, transparent);
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-lg);
    letter-spacing: 0.1em;
    color: var(--color-text);
    outline: none;
    transition: border-color 0.3s var(--ease-out-expo), letter-spacing 0.3s var(--ease-out-expo);
  }

  .gate-input:focus {
    border-bottom-color: var(--color-accent);
  }

  .gate-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .gate-inner[data-state="error"] .gate-input {
    border-bottom-color: var(--color-error, #c47c7c);
  }

  /* Submit — pill-style accent button with state changes */
  .gate-submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.4rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    color: var(--color-bg);
    background: var(--color-accent);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    transition: transform 0.2s var(--ease-out-expo),
                box-shadow 0.2s var(--ease-out-expo),
                opacity 0.2s var(--ease-out-expo);
  }

  .gate-submit:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in oklab, var(--color-accent) 30%, transparent);
  }

  .gate-submit:disabled {
    cursor: progress;
    opacity: 0.85;
  }

  .gate-submit-arrow {
    transition: transform 0.2s var(--ease-out-expo);
  }

  .gate-submit:hover:not(:disabled) .gate-submit-arrow {
    transform: translateX(2px);
  }

  /* Loading: hide arrow, show spinner */
  .gate-submit-spinner {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in oklab, var(--color-bg) 35%, transparent);
    border-top-color: var(--color-bg);
    animation: gate-spin 0.7s linear infinite;
    display: none;
  }

  @keyframes gate-spin {
    to { transform: rotate(360deg); }
  }

  .gate-inner[data-state="loading"] .gate-submit-arrow { display: none; }
  .gate-inner[data-state="loading"] .gate-submit-spinner { display: inline-block; }

  /* Message (error or status) */
  .gate-message {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    color: var(--color-error, #c47c7c);
    margin: 0;
    min-height: 1.4em;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out-expo);
  }

  .gate-inner[data-state="error"] .gate-message {
    opacity: 1;
  }

  /* Success state */
  .gate-success-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out-expo) 0.1s;
  }

  .gate-inner[data-state="success"] .gate-success-wrap {
    opacity: 1;
  }

  .gate-check {
    width: 64px;
    height: 64px;
    color: var(--color-accent);
  }

  .gate-check-circle {
    stroke-dasharray: 152;
    stroke-dashoffset: 152;
  }

  .gate-check-path {
    stroke-dasharray: 36;
    stroke-dashoffset: 36;
  }

  .gate-inner[data-state="success"] .gate-check-circle {
    animation: gate-draw 0.55s var(--ease-out-expo) 0.15s forwards;
  }

  .gate-inner[data-state="success"] .gate-check-path {
    animation: gate-draw 0.4s var(--ease-out-expo) 0.55s forwards;
  }

  @keyframes gate-draw {
    to { stroke-dashoffset: 0; }
  }

  .gate-success-text {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text);
    margin: 0;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
  }

  .gate-inner[data-state="success"] .gate-success-text {
    animation: gate-fade-up 0.5s var(--ease-out-expo) 0.85s forwards;
  }

  .gate-success-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    margin: 0;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
  }

  .gate-inner[data-state="success"] .gate-success-sub {
    animation: gate-fade-up 0.5s var(--ease-out-expo) 1.05s forwards;
  }

  @keyframes gate-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gate-form-wrap,
    .gate-success-wrap,
    .gate-input,
    .gate-submit,
    .gate-message {
      transition: none;
    }
    .gate-check-circle,
    .gate-check-path,
    .gate-success-text,
    .gate-success-sub,
    .gate-submit-spinner {
      animation: none;
    }
    .gate-inner[data-state="success"] .gate-success-text,
    .gate-inner[data-state="success"] .gate-success-sub {
      opacity: 1;
      transform: none;
    }
    .gate-inner[data-state="success"] .gate-check-circle,
    .gate-inner[data-state="success"] .gate-check-path {
      stroke-dashoffset: 0;
    }
  }

  /* ═══════════ FOUC PREVENTION ═══════════
     Pre-hide elements that JS will fade in.
     Only applies when JS is ready (set in Layout.astro).
     This eliminates the visible→invisible flash before animations run. */
  html.js-ready .page-header,
  html.js-ready .section,
  html.js-ready .tier {
    opacity: 0;
    /* Safety-net CSS reveal in case motion's inView fails to fire (e.g., very
       tall sections or IntersectionObserver quirks). Motion's WAAPI animation
       with fill:both takes precedence when it runs, so this only kicks in if
       the JS animation never fires. */
    animation: proposal-fallback-reveal 0.4s ease 3s forwards;
  }

  @keyframes proposal-fallback-reveal {
    to { opacity: 1; }
  }

  /* ═══════════ PAGE ═══════════ */
  .proposal-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .proposal-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ═══════════ HEADER ═══════════ */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  /* ───── Section tag (reused exactly from projects.astro / about.astro) ───── */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag--amber .tag-number { color: var(--color-accent-amber); }
  .tag--rust .tag-number { color: var(--color-accent-rust); }
  .tag--gold .tag-number { color: var(--color-accent); }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag--amber .tag-dash { background: linear-gradient(90deg, var(--color-accent-amber), transparent); }
  .tag--rust .tag-dash { background: linear-gradient(90deg, var(--color-accent-rust), transparent); }
  .tag--gold .tag-dash { background: linear-gradient(90deg, var(--color-accent), transparent); }

  .tag-label {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ───── Title + subtitle + rule ───── */
  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 36ch;
  }

  .sub-accent {
    font-style: normal;
  }

  .sub-accent.teal { color: var(--color-accent-teal); }
  .sub-accent.rust { color: var(--color-accent-rust); }

  .title-rule {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-teal), var(--color-accent-amber));
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ─── Cover intro (one short paragraph below the page header) ─── */
  .cover-intro {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text);
    max-width: 52ch;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  /* ─── Section subhead (sub-heading inside a section, between h2 and beat-marker) ─── */
  .section-subhead {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 1rem;
  }

  /* ═══════════ SECTION ═══════════ */
  .section {
    margin-top: 0;
  }

  .section-title {
    position: relative;
    z-index: 1;
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 26ch;
  }

  /* ─── Chapter divider (reused from about.astro) ─── */
  .chapter-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--color-text-muted) 20%, transparent), transparent);
    margin: clamp(3rem, 6vw, 4.5rem) 0;
  }

  /* ═══════════ SELECTED WORK SHOWCASE ═══════════ */
  .section--showcase .section-title {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .showcase-lead {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    max-width: 56ch;
  }

  .showcase-footer {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
  }

  /* ─── Marquee container ─── */
  .marquee {
    position: relative;
    overflow: hidden;
    /* Break out beyond the 720px proposal-inner to a contained full-bleed */
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    /* Edge fade:masks where cards exit the viewport */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    width: max-content;
    animation: marquee-scroll 55s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* ─── Individual card ─── */
  .marquee-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: clamp(280px, 38vw, 380px);
    flex: 0 0 auto;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .marquee-card:hover {
    transform: translateY(-4px);
  }

  /* ─── Browser chrome frame ─── */
  .browser-frame {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-text) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 14%, transparent);
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.4s var(--ease-out-expo),
                border-color 0.4s var(--ease-out-expo);
  }

  .marquee-card:hover .browser-frame {
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in oklab, var(--card-accent, var(--color-accent)) 35%, transparent);
  }

  .marquee-card--teal { --card-accent: var(--color-accent-teal); }
  .marquee-card--amber { --card-accent: var(--color-accent-amber); }
  .marquee-card--rust { --card-accent: var(--color-accent-rust); }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    background: color-mix(in oklab, var(--color-text) 5%, var(--color-bg));
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
  }

  .browser-chrome .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-text-muted) 30%, transparent);
  }

  .browser-chrome .dot:nth-child(1) { background: color-mix(in oklab, var(--color-accent-rust) 60%, transparent); }
  .browser-chrome .dot:nth-child(2) { background: color-mix(in oklab, var(--color-accent-amber) 60%, transparent); }
  .browser-chrome .dot:nth-child(3) { background: color-mix(in oklab, var(--color-accent-teal) 60%, transparent); }

  .browser-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
    overflow: hidden;
  }

  .browser-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .marquee-card:hover .browser-screen img {
    transform: scale(1.03);
  }

  .screen-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--card-accent, var(--color-accent)) 8%, var(--color-bg)),
      color-mix(in oklab, var(--card-accent, var(--color-accent)) 2%, var(--color-bg))
    );
  }

  /* ─── Caption ─── */
  .marquee-caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 0.15rem;
  }

  .caption-name {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .caption-category {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--card-accent, var(--color-text-muted));
  }

  /* ─── Reduced motion fallback ─── */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }

    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .marquee-card {
      width: clamp(260px, 45%, 340px);
    }
  }

  /* ═══════════ TESTIMONIALS WALL ═══════════ */
  .section--testimonials .section-title {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .testimonials-lead {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    max-width: 56ch;
  }

  /* ─── Two-column wall ─── */
  .testimonials-wall {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
    height: clamp(520px, 70vh, 720px);
    overflow: hidden;
    /* Top + bottom edge fades */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .testimonials-col {
    position: relative;
    overflow: hidden;
  }

  .testimonials-track {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    will-change: transform;
  }

  /* Two opposing scroll directions for visual rhythm */
  .testimonials-col--down .testimonials-track {
    animation: testimonials-scroll-down 55s linear infinite;
  }

  .testimonials-col--up .testimonials-track {
    animation: testimonials-scroll-up 65s linear infinite;
  }

  .testimonials-wall:hover .testimonials-track {
    animation-play-state: paused;
  }

  @keyframes testimonials-scroll-down {
    from { transform: translate3d(0, -50%, 0); }
    to   { transform: translate3d(0, 0, 0); }
  }

  @keyframes testimonials-scroll-up {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, -50%, 0); }
  }

  /* ─── Individual testimonial card ─── */
  .tmnl {
    position: relative;
    margin: 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 10%, transparent);
    display: flex;
    flex-direction: column;
    background: color-mix(in oklab, var(--color-text) 2%, transparent);
    transition: border-color 0.4s var(--ease-out-expo),
                background 0.4s var(--ease-out-expo);
  }

  .tmnl::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--tmnl-accent), color-mix(in oklab, var(--tmnl-accent) 20%, transparent));
  }

  .tmnl--teal { --tmnl-accent: var(--color-accent-teal); }
  .tmnl--amber { --tmnl-accent: var(--color-accent-amber); }

  .tmnl:hover {
    border-color: color-mix(in oklab, var(--tmnl-accent) 30%, transparent);
    background: color-mix(in oklab, var(--tmnl-accent) 4%, transparent);
  }

  .tmnl-mark {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 0.7;
    color: var(--tmnl-accent);
    opacity: 0.18;
    display: block;
    margin-bottom: 0.5rem;
    user-select: none;
  }

  .tmnl-quote {
    font-family: 'DM Sans', sans-serif;
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .tmnl-attr {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .tmnl-name {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .tmnl-rule {
    width: 16px;
    height: 1px;
    background: linear-gradient(90deg, var(--tmnl-accent), transparent);
    flex-shrink: 0;
  }

  .tmnl-detail {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ─── Responsive: single column on small screens, both columns shown statically ─── */
  @media (max-width: 640px) {
    .testimonials-wall {
      display: flex;
      flex-direction: column;
      grid-template-columns: 1fr;
      height: auto;
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .testimonials-col {
      overflow: visible;

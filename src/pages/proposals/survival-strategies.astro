---
export const prerender = false;

import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

const PROPOSAL_PASSWORD = 'ssiproposal';
const AUTH_COOKIE = 'proposal-auth-ss';

let unlocked = false;

if (Astro.request.method === 'POST') {
  let submitted: FormDataEntryValue | null = null;
  try {
    const formData = await Astro.request.formData();
    submitted = formData.get('password');
  } catch {
    return new Response(JSON.stringify({ ok: false, error: 'Invalid request.' }), {
      status: 400,
      headers: { 'Content-Type': 'application/json' },
    });
  }

  // Trim and normalize case — protects against autocomplete trailing spaces and mobile autocapitalize.
  const normalized = typeof submitted === 'string' ? submitted.trim().toLowerCase() : '';

  if (normalized === PROPOSAL_PASSWORD) {
    Astro.cookies.set(AUTH_COOKIE, 'unlocked', {
      path: '/proposals/survival-strategies',
      sameSite: 'lax',
      httpOnly: true,
      maxAge: 60 * 60 * 24 * 30,
    });
    return new Response(JSON.stringify({ ok: true }), {
      headers: { 'Content-Type': 'application/json' },
    });
  }

  return new Response(JSON.stringify({ ok: false, error: 'Incorrect password.' }), {
    status: 401,
    headers: { 'Content-Type': 'application/json' },
  });
}

const cookie = Astro.cookies.get(AUTH_COOKIE);
if (cookie?.value === 'unlocked') {
  unlocked = true;
}

const projects = unlocked
  ? await sanityClient.fetch(`
      *[_type == "project"] | order(order asc) {
        name, url, category, tags, accent, screenshot, order
      }
    `)
  : [];

const testimonials = unlocked
  ? await sanityClient.fetch(`
      *[_type == "testimonial"] | order(order asc) {
        quote, name, role, company
      }
    `)
  : [];

// Double the list for seamless marquee looping
const marqueeProjects = [...projects, ...projects];

// Split testimonials into two columns and double each for seamless vertical loop
const tCol1 = testimonials.filter((_: any, i: number) => i % 2 === 0);
const tCol2 = testimonials.filter((_: any, i: number) => i % 2 === 1).reverse();
const tCol1Track = [...tCol1, ...tCol1];
const tCol2Track = [...tCol2, ...tCol2];

// Render "W1" → "Week 1" and "W2–3" → "Weeks 2–3" for clearer phase labels.
const tiers = [
  {
    accent: 'teal',
    label: 'Tier 01',
    name: 'Rebuild',
    tagline: 'The foundation: a new Webflow site on a real design system, no plug-ins, Core Web Vitals green.',
    price: 7500,
    timeline: '5–6 weeks',
    payment: '50% on signing · 50% at launch',
    cmsCount: '2 CMSs',
    builds_on: null,
    groups: [
      {
        label: 'Platform & design system',
        items: [
          'Full rebuild of ~20 core marketing pages: Home, About (+ Founder, Philosophy, Advisory Board, FAQs, Awards), Services + four service pages, Programs, Who We Serve (PT, OT/SLP, Audiology, SMB), Results, Communities, Resources, Contact.',
          'A tokenized design system in Webflow — typography, color, spacing, motion, and shared components — so Marketing can spin up new pages later without breaking the brand.',
          'Zero plug-ins for basic functionality. Forms, search, SEO controls, image optimization, and CDN are part of the platform, not bolted on.',
          'Photography direction and asset sourcing to replace stock-feeling imagery.',
        ],
      },
      {
        label: 'Content & products',
        items: [
          'Blog CMS with 188 existing posts migrated via CSV and a redesigned article template Marketing can publish to directly.',
          'Products CMS with 20 items, each linked to a Stripe Payment Link. WooCommerce decommissioned. No cart, no checkout pages, no plug-ins.',
          'Five to eight testimonials placed by hand across the site (the full Testimonials CMS arrives in Engine).',
        ],
      },
      {
        label: 'Performance, accessibility & handoff',
        items: [
          'A single intake form rebuilt in Webflow, wired to your existing CRM.',
          'Mobile-first, WCAG AA accessible, all Core Web Vitals green (LCP, INP, CLS) on every core page.',
          'A 60-minute Webflow training session and a written handoff doc so Marketing can publish, edit, and ship without a developer.',
        ],
      },
    ],
    phases: [
      { week: 'W1', name: 'Discovery' },
      { week: 'W2–3', name: 'Design' },
      { week: 'W3–4', name: 'Build' },
      { week: 'W5', name: 'QA' },
      { week: 'W6', name: 'Launch' },
    ],
    outcome: 'A site that finally looks like your business built it — and one your Marketing team can run without me.',
  },
  {
    accent: 'amber',
    label: 'Tier 02',
    name: 'Engine',
    tagline: 'Rebuild + the content and lead-capture machinery: more CMSes, a multi-step F.A.T., real measurement.',
    price: 11500,
    timeline: '7–9 weeks',
    payment: '40% on signing · 30% at design approval · 30% at launch',
    cmsCount: '5 CMSs',
    builds_on: 'Rebuild',
    groups: [
      {
        label: 'Case studies & testimonials system',
        items: [
          'Case Studies CMS: an editorial template with narrative, before-and-after data, pull quotes, practice-type taxonomy, and a filterable index. New ones go live the day they arrive.',
          'Testimonials CMS: all 47 existing reviews structured for reuse across the site with practice-type filtering, plus a Marketing-side workflow for adding new ones as you collect them.',
        ],
      },
      {
        label: 'Lead capture, qualification & content tools',
        items: [
          'A purpose-built multi-step F.A.T. (your free consultation, currently your weakest lead-capture surface). Calibrated questions that pre-qualify owners before a consultant ever picks up the phone. Practice Analysis and Contact intakes rebuilt to the same standard.',
          'Owner Tools CMS: two interactive self-assessments at launch (a Practice Profitability Snapshot and a Hiring Scorecard), each ending in a lead capture. The CMS structure lets your team publish more later.',
          'The Programs page redesigned as a visible curriculum: Practice Analysis through the seven specialized programs to Power of Choice.',
          'Email capture into your existing platform (Mailchimp, HubSpot, ConvertKit, or GoHighLevel).',
        ],
      },
      {
        label: 'Measurement',
        items: [
          'Analytics and event tracking on every form, scroll, and CTA, so you can see what is and isn\'t working after launch (full heat maps, session replays, and the /admin dashboard live in Authority).',
        ],
      },
    ],
    phases: [
      { week: 'W1–2', name: 'Discovery' },
      { week: 'W2–4', name: 'Design' },
      { week: 'W4–7', name: 'Build' },
      { week: 'W6–8', name: 'CMS + integrations' },
      { week: 'W8–9', name: 'QA + launch' },
    ],
    outcome: 'Better leads, fewer junk calls, and content your team can publish without me.',
  },
  {
    accent: 'rust',
    label: 'Tier 03',
    name: 'Authority',
    tagline: 'Engine + the data, dashboards, integrations, and training material your Marketing team needs to fully own the site.',
    price: 15000,
    timeline: '11–14 weeks',
    payment: '30% on signing · 35% at design approval · 35% at launch',
    cmsCount: '7 CMSs · admin dashboard',
    builds_on: 'Engine',
    groups: [
      {
        label: 'Platform & control',
        items: [
          'Zero plug-ins for any functionality. Webflow, Turso, PostHog, and Resend are all first-party platforms — no plug-in maintenance, no version conflicts, no surprise costs, no Qual Sec pulled off post to fix a broken update.',
          'Marketing controls the site end to end. Copy edits, image swaps, new pages, redirects, meta tags, A/B tests — all done by your team in the Webflow Editor, the same hour they\'re requested. No tickets, no developer in the loop.',
          'A custom /admin dashboard SSI logs into. Real-time lead activity feed, form submission inbox, subscriber lists, owner-tools completion stats, and PostHog analytics embedded inline. The single source of truth your Marketing team runs on, behind your own login.',
          'Turso database, spun up under SSI ownership and handed over with the keys. Stores every form submission, lead, F.A.T. completion, owner-tools result, and subscriber record.',
        ],
      },
      {
        label: 'The complete content engine',
        items: [
          'Seven CMSes covering everything Marketing publishes: Blog (articles), Owner Tools (interactive tools), Free Downloads & Ebooks, Webinars (replays + upcoming), Case Studies, Testimonials, and Products. Each has structured fields, an approved template, and SEO defaults so a new piece of content publishes in minutes, in the right place, formatted to the brand.',
          'Free Downloads / Ebooks CMS: gated lead magnets (your existing 8, with room to grow), each with a hero, preview pages, and a capture form.',
          'Webinars CMS: on-demand replays and upcoming sessions in a real content hub. Strong top-of-funnel for owners not yet ready for a call.',
          'Every new piece of content auto-publishes to the right index, sitemap entry, and RSS feed — no developer step.',
        ],
      },
      {
        label: 'One source of truth: heat maps + analytics',
        items: [
          'PostHog wired in from day one: per-page heat maps (scroll depth + click maps), session replays, custom event tracking on every form, CTA, and scroll event, plus conversion funnels for the paths that matter.',
          'All of it embedded inside the /admin dashboard so Marketing reads the data without a separate tool and without a data analyst.',
          'Optimization loop built in: see where visitors drop off, fix it in Webflow the same week, watch the number move.',
        ],
      },
      {
        label: 'Integrations: Sheets, email, GoHighLevel-ready',
        items: [
          'Google Sheets integration: every form submission and lead capture mirrors into the spreadsheets your team already lives in. No tool switching.',
          'Resend integration for transactional and automated email, hooked into the Resend account SSI already runs. Confirmations on every form and download, drip sequences for new leads and owner-tools completions, internal notifications when high-value inquiries land.',
          'Architected for the future GoHighLevel rollout: when SSI moves over, the same form, lead, and subscriber data routes directly into GHL via its native webhook + API — a swap, not a rebuild.',
        ],
      },
      {
        label: 'Personalization & storytelling',
        items: [
          'Practice-type personalization on Home and Services: same site, four tailored experiences (PT, OT/SLP, Audiology, Pediatric) via conditional content and URL parameters.',
          'Scroll-driven storytelling on Home and Results: the 30-year timeline becomes a moment, the proof numbers count up in view, and case studies unfold as you scroll.',
          'Survival Strategies Magazine treated as a real editorial destination: typography-led article template, featured pieces, full archive.',
        ],
      },
      {
        label: 'Performance & accessibility',
        items: [
          'All Core Web Vitals green (LCP, INP, CLS) on every core page. Mobile load under 2.5 seconds. WCAG AA accessible. Built in from page one, not patched after launch.',
        ],
      },
      {
        label: 'Training material the Marketing team owns',
        items: [
          'A written training handbook covering every part of the website ecosystem: how to publish in each of the seven CMSes, how to work the /admin dashboard, how to read PostHog analytics and interpret heat maps, how to configure Resend workflows, how to back up the Turso database, and how to ship a new page from the design system.',
          'A matching library of screen-recorded Loom walkthroughs, topic-tagged and shareable, so a new Marketing hire can ramp in an afternoon — without my involvement.',
          '30 days of post-launch support: bug fixes, copy tweaks, performance tuning, and a measurement readout pulled directly from PostHog and the /admin dashboard once real traffic hits.',
        ],
      },
    ],
    phases: [
      { week: 'W1–2', name: 'Discovery' },
      { week: 'W2–5', name: 'Design' },
      { week: 'W5–9', name: 'Build' },
      { week: 'W7–11', name: 'CMS + personalization' },
      { week: 'W9–13', name: 'Integrations + admin' },
      { week: 'W12–14', name: 'Handoff + launch' },
    ],
    outcome: 'When a practice owner Googles "how to grow my PT practice," your site is the one they keep coming back to — and your Marketing team can see exactly when they did, what they read, what they signed up for, and ship the next optimization that same week without ever calling a developer.',
  },
];
---

<Layout
  title="Proposal: Survival Strategies"
  description="A three-tier web design proposal for Survival Strategies, Inc."
  noIndex={true}
>
  <main>
    {!unlocked && (
      <section class="gate-page">
        <div class="gate-inner" data-state="idle">

          <div class="gate-form-wrap">
            <div class="section-tag">
              <span class="tag-number">00</span>
              <span class="tag-dash" aria-hidden="true"></span>
              <span class="tag-label">Restricted access</span>
            </div>
            <h1 class="gate-title">This proposal is private.</h1>
            <p class="gate-subtitle">Enter the password to continue.</p>
            <div class="title-rule" aria-hidden="true"></div>

            <form method="POST" class="gate-form" novalidate>
              <label class="gate-field">
                <span class="gate-field-label">Password</span>
                <input
                  type="password"
                  name="password"
                  class="gate-input"
                  required
                  autocomplete="off"
                  autofocus
                />
              </label>

              <button type="submit" class="gate-submit">
                <span class="gate-submit-label" data-label-default="Continue" data-label-loading="Checking…">Continue</span>
                <svg class="gate-submit-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7h8M7 3l4 4-4 4" />
                </svg>
                <span class="gate-submit-spinner" aria-hidden="true"></span>
              </button>

              <p class="gate-message" role="status" aria-live="polite"></p>
            </form>
          </div>

          <div class="gate-success-wrap" aria-hidden="true">
            <svg class="gate-check" viewBox="0 0 52 52" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle class="gate-check-circle" cx="26" cy="26" r="24"></circle>
              <path class="gate-check-path" d="M14 27 l8 8 l16 -18"></path>
            </svg>
            <p class="gate-success-text">Access granted.</p>
            <p class="gate-success-sub">Loading the proposal…</p>
          </div>

        </div>
      </section>
    )}

    {unlocked && (
    <section class="proposal-page">
      <div class="proposal-inner">

        <!-- ═══════════ HEADER ═══════════ -->
        <header class="page-header reveal">
          <div class="section-tag">
            <span class="tag-number">00</span>
            <span class="tag-dash" aria-hidden="true"></span>
            <span class="tag-label">Proposal · Survival Strategies</span>
          </div>
          <h1 class="page-title">A proposal for the Survival Strategies website.</h1>
          <div class="title-rule" aria-hidden="true"></div>

          <p class="cover-intro">
            Your site works. It's also leaving 30 to 50 percent of leads on the table. This document
            walks through what I found in a top-to-bottom audit, what it's costing your business,
            and what we'd build to fix it.
          </p>
        </header>

        <!-- ═══════════ 01: WHAT I SEE ═══════════ -->
        <section class="section reveal">
          <div class="section-tag">
            <span class="tag-number">01</span>
            <span class="tag-dash" aria-hidden="true"></span>
            <span class="tag-label">What I see</span>
          </div>

          <h2 class="section-title">Your business and the website don't match.</h2>

          <div class="prose">
            <p>
              Survival Strategies has been around since 1989. Craig started your business with one idea: practice
              owners need management training, not motivation. Thirty-something years later, your business is
              still here.
            </p>

            <p>
              Your <a href="https://survivalstrategies.com/results/" class="prose-link" target="_blank" rel="noopener">results page</a>
              tells the story most consultancies fabricate. <span class="num-inline">65%</span> more new
              patients on average. <span class="num-inline">70%</span> more visits. Numbers you've earned
              over decades.
            </p>

            <p>
              And your business has built a lot. Ten programs from Practice Analysis through Power of Choice.
              Five full case studies. Forty-seven testimonials. Eight ebooks. Twenty products. A magazine.
              A Knowledge Center going back to 2009.
            </p>

            <p>The site doesn't showcase or represent that level of expertise and industry knowledge.</p>

            <p>
              The site works. It loads, the forms submit, the structure is fine. But it reads the same
              as the other "private practice consultants" you've outperformed for thirty years. A
              practice owner landing on your homepage in 2026 can't tell in three seconds whether
              you've been around since 1989 or just registered a domain last week.
            </p>

            <blockquote class="pull-quote">
              You've been doing this since 1989. The site doesn't show it.
            </blockquote>

            <h3 class="section-subhead">What "done" actually means.</h3>

            <p>
              A rebuild without measurable goals is a redesign with no way to know if it worked.
              Nine things define success — and here's what each one looks like when it's actually
              shipped.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">1</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">No plug-ins for basic functionality</span>
            </h4>
            <p>
              Forms, search, SEO, image optimization, and analytics are part of the platform,
              not bolted on. Nothing breaks at the next WordPress update because there is no
              WordPress.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">2</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Marketing controls the site without dev intervention</span>
            </h4>
            <p>
              Edits, publishing, and routine optimization happen inside a content editor your team
              already understands. No tickets. No waiting on a developer to push a button.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">3</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">A CMS built for fast content output</span>
            </h4>
            <p>
              Articles, free tools, downloadables, e-books, and webinar recordings each have their
              own structured templates. Marketing adds a new one in minutes, not days.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">4</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">A design system that scales to new pages</span>
            </h4>
            <p>
              Type, color, spacing, and components are tokenized. New pages assemble from the same
              approved blocks, so a page built six months from now still looks like SSI.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">5</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">One source of truth for heat maps and analytics</span>
            </h4>
            <p>
              Page-level analytics, scroll depth, and click maps live in one dashboard Marketing
              can read without a data analyst. See what works, fix what doesn't, same week.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">6</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">A case study and testimonial system</span>
            </h4>
            <p>
              A dedicated content type for case studies and testimonials with publish-ready
              templates. New ones go live the day they arrive, not the quarter they arrive.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">7</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Integrations with Sheets, email, and GoHighLevel</span>
            </h4>
            <p>
              Form submissions flow into the existing Google Sheets workflow and email system on
              day one, and the integration layer is ready for the future GoHighLevel rollout.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">8</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Training material the Marketing team owns</span>
            </h4>
            <p>
              Written guides and short walkthrough videos for publishing articles, adding case
              studies, swapping copy, and reading analytics. New Marketing hires get up to speed
              without outside help.
            </p>

            <h4 class="beat-marker">
              <span class="beat-num">9</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Core Web Vitals: all green</span>
            </h4>
            <p>
              LCP, INP, and CLS pass on every core page. Mobile load under 2.5 seconds. WCAG AA
              accessible. The performance Google rewards in search, on day one.
            </p>
          </div>
        </section>

        <hr class="chapter-divider" aria-hidden="true" />

        <!-- ═══════════ 02: THE PAGES ═══════════ -->
        <section class="section reveal">
          <div class="section-tag tag--amber">
            <span class="tag-number">02</span>
            <span class="tag-dash" aria-hidden="true"></span>
            <span class="tag-label">The pages</span>
          </div>

          <h2 class="section-title">What we see, page by page.</h2>

          <div class="prose">
            <p>
              I ran each of the eight core marketing pages through three things: Google's free website
              diagnostic tool (Lighthouse, which scores any page 0 to 100 across Performance,
              Accessibility, SEO, and Best Practices; anything under 90 falls below Google's bar for a
              production-ready page), browser automation that captures the rendered design
              (Playwright), and a manual content review. The findings are below.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">1</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Home</span>
            </h3>
            <p>
              The homepage has 26 different CTAs (calls-to-action, buttons or links asking the
              visitor to do something) competing for attention. With no clear primary action, visitors
              don't know what to click. The hero section uses a 2.1 MB image, which is the single
              largest asset on the entire site and takes several seconds to download on a phone.
              Server response time is 2.2 seconds before anything else can begin loading, the
              industry target is under 0.2 seconds, so the site is roughly ten times slower at this
              first step alone. Eight different button styles appear on the same page, breaking visual
              consistency. The page has 43 headings (one H1, fourteen H2s, sixteen H3s, plus more),
              which dilutes the hierarchy enough that no single message lands.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">2</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">About</span>
            </h3>
            <p>
              The About page has two H1 elements, the H1 is the main heading of a page, and there
              should only ever be one. Three different font families render on the page (only two are
              intentional). The main "Contact us" call-to-action is buried at the very bottom of a
              long bio block, where most readers never scroll.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">3</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Services</span>
            </h3>
            <p>
              Four different font families render on this page: Prompt, Montserrat, Times, and Lucida
              Grande. Only the first two are intentional. The other two appear because form inputs and
              certain text elements don't override the operating system's default fonts. The page also
              shifts visibly during load, its Cumulative Layout Shift (CLS, Google's measure of how
              much content jumps around while loading) is 0.138, over the "good" threshold of 0.1. At
              the bottom is an intake form that asks ten or more questions across roughly 25 form
              fields before the visitor can submit anything.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">4</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Programs</span>
            </h3>
            <p>
              This is the slowest page on the site. Its LCP (Largest Contentful Paint, the time the
              main visible content takes to appear) is 9.4 seconds. Google considers anything over 2.5
              seconds poor. The ten programs are presented as a flat list with no visual hierarchy
              between the flagship and the supporting programs, so visitors leave without a clear
              sense of which one is right for them. The same long intake form from the Services page
              appears here, too.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">5</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Who We Serve</span>
            </h3>
            <p>
              The audience overview is too thin to actually qualify visitors. It routes them to the
              Results page to figure out which audience they belong to, instead of into a Practice
              Analysis intake. A visitor who doesn't already know they're a fit will bounce.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">6</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Results</span>
            </h3>
            <p>
              This is the most important page on the entire site, because it's where the proven case
              studies live and where prospects decide whether to schedule a Practice Analysis. It's
              also the worst-performing page on the site. Its Lighthouse Performance score is 40, a
              flat failing grade. Its CLS is 0.326, over three times the "good" threshold of 0.1.
              That means the page content visibly jumps around as it loads. The testimonials on the
              page are shown as initials only ("S.Y., BS, MPT" or "M.J.S., PT/CHT") instead of as
              named people with photos and full attribution. The underlying reviews are genuine, but
              initials read as anonymous and unverifiable.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">7</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Resources</span>
            </h3>
            <p>
              Five resource types are listed (Knowledge Center, F.A.T., Online Store, Calendar,
              Communities) with no sense of which is most valuable to a new visitor. Every link
              sends the visitor off the page before they can engage with anything inline.
            </p>

            <h3 class="beat-marker">
              <span class="beat-num">8</span>
              <span class="beat-dash" aria-hidden="true"></span>
              <span class="beat-label">Contact</span>
            </h3>
            <p>
              The Contact page has two separate forms on it. The main contact form asks about ten
              questions (roughly 25 form fields when each radio button and checkbox is counted
              individually). The second form is "OMS Support," which exists for existing-customer
              technical issues, not for new prospects. Having both forms on the same page confuses
              both audiences. The page also has eleven CTAs competing for attention.
            </p>

            <blockquote class="pull-quote">
              Every one of these pages is trying to do everything. None of them do one thing well.
            </blockquote>
          </div>
        </section>

        <hr class="chapter-divider" aria-hidden="true" />

        <!-- ═══════════ 03: THE PATTERNS ═══════════ -->
        <section class="section reveal">
          <div class="section-tag tag--rust">
            <span class="tag-number">03</span>
            <span class="tag-dash" aria-hidden="true"></span>
            <span class="tag-label">The patterns</span>
          </div>

          <h2 class="section-title">What's broken across the site.</h2>

          <div class="prose">
            <p>
              The page-by-page issues above fall into four patterns. Each repeats almost everywhere.
            </p>

            <p>
              <strong>Design.</strong> Eight different CTA button styles on the homepage alone. Some
              with zero vertical padding, so they visually collapse and become hard to tap. Two
              slightly different blues both used as "the primary" accent
              (<span class="num-inline">rgb(46,109,168)</span> and
              <span class="num-inline">rgb(46,109,169)</span>). Ten distinct text colors on the
              homepage, including off-by-one duplicates and barely-different shades of white. A
              consistent design system uses three or four colors and a couple of button variants.
              The current site has nearly three times that.
            </p>

            <p>
              <strong>Typography.</strong> <span class="num-inline">26</span> distinct font sizes on
              the homepage. Real type scales have five to eight. Four font families render across the
              site when only two are intentional, the others creep in from form inputs and inline
              elements that don't override the operating system's defaults. The chosen body font
              (Prompt) reads as a modern tech startup, which quietly undercuts the heritage claim of
              a 30-year firm.
            </p>

            <p>
              <strong>Performance.</strong> Mobile Lighthouse averages <span class="num-inline">57</span>
              across the site, with Results scoring <span class="num-inline">40</span>, a flat failing
              grade. Server response sits between 1.0 and 2.2 seconds; the industry target is 0.2. The
              homepage ships 4.46 MB on a phone, driven by a single 2.1 MB hero image that was never
              properly compressed. YouTube alone loads 780 KB of JavaScript before the visitor even
              presses play.
            </p>

            <p>
              <strong>Structure.</strong> The homepage is <span class="num-inline">8,678</span> pixels
              tall, about six full mobile screens, with 43 headings and 26 CTAs. The Services and
              Programs pages both end in intake forms asking 10+ questions across roughly 25 form
              fields. The Contact page hosts two separate forms, one for prospects and one for
              existing-customer technical support, which confuses both audiences. Every page tries to
              do everything, and no page has a single primary action.
            </p>

            <p>
              The accessibility findings are real but smaller in scale. Heading hierarchy is broken
              on every page (an H1 followed by an H4 with no H2 or H3 between them is common). 24 of
              28 homepage images are missing alt text, which costs both screen-reader users and
              Google's image search. Two pages fail the "links rely on color alone" check, meaning a
              colorblind visitor can't tell a link from surrounding text. Compared to the design and
              performance issues above, these are cleanup items.
            </p>
          </div>
        </section>

        <hr class="chapter-divider" aria-hidden="true" />

        <!-- ═══════════ 04: THE COST ═══════════ -->
        <section class="section reveal">
          <div class="section-tag tag--gold">
            <span class="tag-number">04</span>
            <span class="tag-dash" aria-hidden="true"></span>
            <span class="tag-label">The cost</span>
          </div>

          <h2 class="section-title">What this is costing your business.</h2>

          <div class="prose">
            <p>
              Every one of these failures has a measurable cost in lost conversions. Drawing from
              Google's own page experience research, Nielsen Norman form completion data, and standard
              B2B funnel benchmarks, here's what the current state is taking off the table.
            </p>

            <p>
              <strong>Slow main content (LCP over 4 seconds): 20 to 30 percent fewer page reads
              complete.</strong> Google's research shows that every additional second of main-content
              load time increases bounce rate by about 32 percent. Five of the eight pages on the
              site have LCPs between 4.5 and 9.5 seconds.
            </p>

            <p>
              <strong>26 CTAs on the homepage: roughly 50 percent reduction in click-through
              rate.</strong> When visitors face too many choices, none of them get clicked. The best
              practice for a homepage is one primary CTA plus two or three secondary ones, all using
              the same visual style so the visitor learns what "clickable" looks like.
            </p>

            <p>
              <strong>Intake forms of ten-plus questions: 5 to 10 times lower completion than a 3 to
              5 question multi-step flow.</strong> Every form field past field seven reduces
              completion by roughly 5 percent. By the time a visitor reaches question ten or beyond,
              completion is in the low single digits. The Services and Programs forms both fall into
              this trap.
            </p>

            <p>
              <strong>Content jumping during load (CLS of 0.326 on the Results page): about 12
              percent more bounces.</strong> The Results page is the most important conversion page
              on the site, and its content visibly shifts around while loading. That shifting is
              directly correlated with visitors leaving before reading.
            </p>

            <p>
              <strong>Slow server response (1.0 to 2.2 seconds before anything else can load):
              roughly 25 percent more bounces from the delay alone.</strong> The industry target is
              under 200 milliseconds. The current site is five to ten times slower at this first step.
            </p>

            <p>
              <strong>Testimonials shown as initials only (S.Y., M.J.S., R.G.): roughly 40 percent
              weaker trust signal.</strong> People trust named, attributed quotes from real people
              with photos. Initials read as anonymous and potentially fabricated, even when the
              underlying review is genuine.
            </p>

            <blockquote class="pull-quote">
              Conservatively, the site is leaving 30 to 50 percent of potential leads on the table.
            </blockquote>

            <p>
              For a firm whose typical engagement is in the five-figure range, that's significant
              revenue annually. None of it requires more marketing spend or more leads at the top of
              the funnel. The leads are already arriving. The site is losing them between arrival
              and conversion.
            </p>
          </div>
        </section>

        <hr class="chapter-divider" aria-hidden="true" />

        <!-- ═══════════ 05: THE RECOMMENDATION ═══════════ -->

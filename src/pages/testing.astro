        .headline,
        .sub,
        .ctas,
        .blocks-wrap,
        .blocks-caption,
        .block {
          animation: none;
          opacity: 1;
          transform: none;
        }
        .blocks,
        .block,
        .revenue-label {
          transition: none;
        }
      }

      /* ── Small screens ── */
      @media (max-width: 640px) {
        .blocks {
          grid-template-columns: repeat(2, 1fr);
        }
        .blocks.merged {
          gap: 0;
        }
        .blocks.merged .block {
          border-radius: 0;
        }
        .blocks.merged .block:nth-child(1) {
          border-radius: var(--radius-lg) 0 0 0;
        }
        .blocks.merged .block:nth-child(2) {
          border-radius: 0 var(--radius-lg) 0 0;
        }
        .blocks.merged .block:nth-child(3) {
          border-radius: 0 0 0 var(--radius-lg);
        }
        .blocks.merged .block:nth-child(4) {
          border-radius: 0 0 var(--radius-lg) 0;
        }
      }
    </style>

    <style is:global>
      html {

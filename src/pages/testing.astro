      .fld-err input { border-color: var(--t-error); }
      .fld-err .fmsg { color: var(--t-error); }
      .fld-ok input { border-color: var(--t-success); }
      .fld-ok .fmsg { color: var(--t-success); }
      .fmsg {
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.45;
      }
      .sys-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
      }
      .sys-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }
      .tile {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 96px;
        padding: 1rem 1.1rem;
        background: var(--t-surface);
        border-radius: var(--radius-lg);
      }
      .tile-l {
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }
      .tile-d {
        font-size: var(--text-xs);
        color: var(--t-muted);
      }
      .t-b1 { border: 1px solid var(--t-border-subtle); }
      .t-b2 { border: 1px solid var(--t-border); }
      .t-b3 { border: 1px solid var(--t-border-strong); }
      .t-s1 { box-shadow: var(--t-shadow-sm); }
      .t-s2 { box-shadow: var(--t-shadow-md); }
      .t-s3 { box-shadow: var(--t-shadow-lg); }
      .sys-select {
        margin: 0;
        font-size: var(--text-md);
        line-height: 1.6;
        max-width: 52ch;
      }
      .sys-scroll {
        margin-top: 1.1rem;
        max-width: 44rem;
        height: 170px;
        overflow: auto;
        padding: 1rem 1.2rem;
        background: var(--t-surface);
        border: 1px solid var(--t-border);
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        line-height: 1.7;
      }
      .sys-scroll p {
        margin: 0 0 0.9em;
        white-space: nowrap;
      }
      .sys-scroll:focus-visible {
        outline: 2px solid var(--t-focus);
        outline-offset: 2px;
      }
      .aa {
        overflow-x: auto;
      }
      .aa table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-xs);
      }
      .aa th,
      .aa td {
        text-align: left;
        padding: 0.55em 0.9em 0.55em 0;
        border-bottom: 1px solid var(--t-border-subtle);
        white-space: nowrap;
      }
      .aa th {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: var(--weight-medium);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--t-muted);
      }
      .aa-sample {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 26px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--t-border-subtle);
        font-weight: var(--weight-bold);
        font-size: 0.85rem;
      }
      .aa-ratio {
        font-family: var(--font-mono);
      }
      .aa-verdict {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
      }
      .aa-verdict.pass { color: var(--t-success); }
      .aa-verdict.fail { color: var(--t-error); }

      /* ── Scroll reveals: play once, rest on end state ── */
      .rv {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity 0.7s var(--ease-out-expo),
          transform 0.7s var(--ease-out-expo);
        transition-delay: calc(var(--i, 0) * 90ms);
      }
      .rv.on {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .rv {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* ── Responsive ── */
      @media (max-width: 1080px) {
        .cgrid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 900px) {
        .contact-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 700px) {
        .mani,
        .mani-list {
          grid-template-columns: 1fr;
        }
        .band-grid {
          grid-template-columns: 1fr;
        }
        .foot-fine {
          flex-direction: column;
          gap: 0.35rem;
        }
        .alerts,
        .sys-forms {
          grid-template-columns: 1fr;
        }
        .sys-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 560px) {
        .cgrid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script is:inline>
      (function () {
        var tg = document.getElementById('tg');
        var blocks = document.getElementById('blocks');
        var rail = document.querySelector('.rail');
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var mergeTimer = null;

        // The 4→1 merge plays once, then rests on the Revenue end state.
        function playMerge() {
          clearTimeout(mergeTimer);
          if (reduced) {
            blocks.classList.add('merged');
            return;
          }
          mergeTimer = setTimeout(function () {
            blocks.classList.add('merged');
          }, 2100);
        }

        function replay() {
          blocks.classList.remove('merged');
          // Restart the entrance animations by forcing a reflow
          Array.prototype.forEach.call(blocks.querySelectorAll('.block'), function (el) {
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
          playMerge();
        }

        function setActive(group, btn) {
          Array.prototype.forEach.call(group, function (b) {
            b.classList.toggle('is-active', b === btn);
          });
        }

        // ── Live AA contrast audit ──
        // Resolves each token to its rendered color (canvas
        // normalization handles color-mix), alpha-blends
        // translucent values over the page background, and
        // reports the real WCAG ratio for the current mode.
        var PAIRS = [
          ['Ink on paper', '--t-text', '--t-bg', 4.5],
          ['Muted ink on paper', '--t-muted', '--t-bg', 4.5],
          ['Ink on surface', '--t-text', '--t-surface', 4.5],
          ['Muted ink on surface', '--t-muted', '--t-surface', 4.5],
          ['Button ink on accent', '--t-on-accent', '--t-accent', 4.5],
          ['Error on paper', '--t-error', '--t-bg', 4.5],
          ['Success on paper', '--t-success', '--t-bg', 4.5],
          ['Warning on paper', '--t-warn', '--t-bg', 4.5],
          ['Info on paper', '--t-info', '--t-bg', 4.5],
          ['Focus ring on paper', '--t-focus', '--t-bg', 3],
          ['Strong border on paper', '--t-border-strong', '--t-bg', 3]
        ];
        var aaBox = document.getElementById('aa');
        var probe = document.createElement('span');
        probe.style.display = 'none';
        tg.appendChild(probe);
        var cnv = document.createElement('canvas');
        cnv.width = cnv.height = 1;
        var ctx = cnv.getContext('2d', { willReadFrequently: true });

        function resolveColor(varName) {
          probe.style.color = 'var(' + varName + ')';
          var resolved = getComputedStyle(probe).color;
          ctx.clearRect(0, 0, 1, 1);
          ctx.fillStyle = resolved;
          ctx.fillRect(0, 0, 1, 1);
          var d = ctx.getImageData(0, 0, 1, 1).data;
          return [d[0], d[1], d[2], d[3] / 255];
        }

        function blend(fg, bg) {
          var a = fg[3];
          return [
            fg[0] * a + bg[0] * (1 - a),
            fg[1] * a + bg[1] * (1 - a),
            fg[2] * a + bg[2] * (1 - a),
            1
          ];
        }

        function luminance(c) {
          var ch = [c[0], c[1], c[2]].map(function (v) {
            v /= 255;
            return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
          });
          return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
        }

        function contrast(fg, bg) {
          var l1 = luminance(fg);
          var l2 = luminance(bg);
          var hi = Math.max(l1, l2);
          var lo = Math.min(l1, l2);
          return (hi + 0.05) / (lo + 0.05);
        }

        // Emit oklch() even for runtime-measured colors, so every
        // color value on the page speaks the same language.
        function oklchCss(c) {
          function chan(v) {
            v /= 255;
            return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
          }
          var r = chan(c[0]), g = chan(c[1]), b = chan(c[2]);
          var l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
          var m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
          var s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
          var L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
          var a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
          var bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
          var C = Math.sqrt(a * a + bb * bb);
          var H = Math.atan2(bb, a) * 180 / Math.PI;
          if (H < 0) H += 360;
          if (C < 0.0005) H = 0;
          return 'oklch(' + (L * 100).toFixed(1) + '% ' + C.toFixed(3) + ' ' + H.toFixed(1) + ')';
        }

        function renderAA() {
          if (!aaBox) return;
          // innerHTML is safe here: every interpolated value is either a
          // hardcoded literal from PAIRS or a number produced by
          // canvas/contrast math. No user or remote input reaches this.
          var rows = PAIRS.map(function (pair) {
            var bg = resolveColor(pair[2]);
            var fg = blend(resolveColor(pair[1]), bg);
            var ratio = contrast(fg, bg);
            var pass = ratio >= pair[3];
            return '<tr>' +
              '<td>' + pair[0] + '</td>' +
              '<td><span class="aa-sample" style="background:' + oklchCss(bg) + ';color:' + oklchCss(fg) + '">Ag</span></td>' +
              '<td class="aa-ratio">' + ratio.toFixed(2) + ':1</td>' +
              '<td class="aa-ratio">' + pair[3] + ':1</td>' +
              '<td><span class="aa-verdict ' + (pass ? 'pass' : 'fail') + '">' + (pass ? 'PASS' : 'FAIL') + '</span></td>' +
              '</tr>';
          }).join('');
          aaBox.innerHTML =
            '<table><thead><tr>' +
            '<th>Pair</th><th>Sample</th><th>Measured</th><th>Target</th><th>Verdict</th>' +
            '</tr></thead><tbody>' + rows + '</tbody></table>';
        }

        rail.addEventListener('click', function (e) {
          var btn = e.target.closest('.rail-btn');
          if (!btn) return;
          if (btn.dataset.mode) {
            tg.dataset.m = btn.dataset.mode;
            setActive(document.querySelectorAll('[data-mode]'), btn);
            renderAA();
          } else if (btn.id === 'replay') {
            replay();
          }
        });

        playMerge();
        renderAA();

        // Scroll reveals — play once per element, then rest
        var revealEls = document.querySelectorAll('.rv');
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach(function (el) { el.classList.add('on'); });
        } else {
          var rio = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('on');
                rio.unobserve(en.target);
              }
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0 });
          revealEls.forEach(function (el) { rio.observe(el); });
        }
      })();
    </script>
  </body>
</html>

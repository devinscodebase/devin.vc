        border: 2px solid oklch(20.3% 0.01 107.2);
      }
      html:has(.tg[data-m='dark']) ::-webkit-scrollbar-thumb:hover,
      html:has(.tg[data-m='dark'])::-webkit-scrollbar-thumb:hover {
        background: oklch(57.6% 0.033 100.9);
      }
    </style>

    <style>
      /* ══════════════════════════════════════════════════
         FULL-PAGE SECTIONS
         ══════════════════════════════════════════════════ */
      .tg {
        position: relative;
      }

      /* ── Masthead ── */
      .mast {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: clamp(1.25rem, 3vh, 2rem) var(--space-page-x);
      }

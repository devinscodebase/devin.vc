        background: oklch(93.3% 0.016 95.2);
      }
      html:has(.tg[data-m='light']) ::-webkit-scrollbar-thumb,
      html:has(.tg[data-m='light'])::-webkit-scrollbar-thumb {
        background: oklch(59.7% 0.027 99.4);
        border-radius: 5px;
        border: 2px solid oklch(93.3% 0.016 95.2);
      }
      html:has(.tg[data-m='light']) ::-webkit-scrollbar-thumb:hover,
      html:has(.tg[data-m='light'])::-webkit-scrollbar-thumb:hover {
        background: oklch(51.5% 0.026 99);
      }
      html:has(.tg[data-m='dark']) ::-webkit-scrollbar-track,
      html:has(.tg[data-m='dark'])::-webkit-scrollbar-track {
        background: oklch(20.3% 0.01 107.2);
      }
      html:has(.tg[data-m='dark']) ::-webkit-scrollbar-thumb,
      html:has(.tg[data-m='dark'])::-webkit-scrollbar-thumb {

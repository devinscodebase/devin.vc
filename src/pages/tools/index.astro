---
import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    name: 'GTM Budget Planner',
    slug: 'gtm-planner',
    tag: 'Planning',
    description: 'Reverse-engineer your go-to-market funnel from revenue target to daily activity and budget.',
    detail: 'Input your revenue goal and conversion rates. Get the exact leads, budget, and pipeline you need at every stage.',
    accent: 'teal',
  },
  {
    name: 'Retention Revenue Calculator',
    slug: 'retention-calculator',
    tag: 'Retention',
    description: 'Quantify the real cost of customer churn and the compounding gap over 3 years.',
    detail: 'See what your churn actually costs in annual revenue lost, replacement spend, and the widening gap over time.',
    accent: 'amber',
  },
  {
    name: 'Marketing Efficiency Scorecard',
    slug: 'marketing-scorecard',
    tag: 'Diagnostics',
    description: 'Score your marketing engine across 11 metrics and get a specific diagnosis.',
    detail: 'Benchmark your performance against stage-specific standards. Find out exactly what\'s holding you back.',
    accent: 'rust',
  },
];
---

<Layout title="Free Tools — Devin Alexander" description="Marketing and growth tools for operators. Reverse-engineer your funnel, diagnose your marketing, and quantify what churn really costs." image="/og/tools.png">
  <main>
    <section class="tools-page">
      <div class="tools-inner will-animate">
        <header class="page-header">
          <div class="section-tag"><span class="tag-label">Tools</span></div>
          <h1 class="page-title">Free Tools</h1>
          <p class="page-subtitle">Reverse-engineer your funnel, diagnose your marketing, and quantify what churn <em>really</em> costs.</p>
        </header>

        <div class="tool-cards">
          {tools.map((tool, i) => (
            <a href={`/tools/${tool.slug}`} class={`tool-card accent-${tool.accent}`}>
              <div class="card-bar" aria-hidden="true" />
              <span class="card-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="card-content">
                <span class={`card-tag`}>{tool.tag}</span>
                <h2 class="card-name">{tool.name}</h2>
                <p class="card-description">{tool.description}</p>
                <p class="card-detail">{tool.detail}</p>
              </div>
              <div class="card-action">
                <span class="action-label">Try it</span>
                <svg class="action-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 7h12M8 2l5 5-5 5" />
                </svg>
              </div>
            </a>
          ))}
        </div>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { animate, inView } from 'motion';

  const inner = document.querySelector('.tools-inner');
  const section = document.querySelector('.tools-page');

  if (window.__vtNav) {
    inner?.classList.remove('will-animate');
  } else if (inner && section) {
    const stop = inView(section, () => {
      inner.classList.remove('will-animate');
      inner.classList.add('revealed');
      stop();
    }, { amount: 0.1 });
  }

  // Cursor-following spotlight + spring hover
  document.querySelectorAll('.tool-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--glow-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--glow-y', `${e.clientY - rect.top}px`);
    });

    card.addEventListener('mouseenter', () => {
      const name = card.querySelector('.card-name');
      animate(card, { y: -5 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      if (name) animate(name, { x: 4 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
    });

    card.addEventListener('mouseleave', () => {
      const name = card.querySelector('.card-name');
      animate(card, { y: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      if (name) animate(name, { x: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
    });
  });
</script>

<style>
  .tools-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .tools-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Entrance animation (CSS-driven) ---- */
  .will-animate .page-header,
  .will-animate .tool-card,
  .will-animate .page-footer {
    opacity: 0;
    transform: translateY(16px);
  }

  .revealed .page-header {
    animation: fadeSlideUp 0.4s cubic-bezier(0.25, 1, 0.5, 1) both;
  }

  .revealed .tool-card {
    animation: fadeSlideUp 0.45s cubic-bezier(0.25, 1, 0.5, 1) both;
  }

  .revealed .tool-card:nth-child(1) { animation-delay: 80ms; }
  .revealed .tool-card:nth-child(2) { animation-delay: 180ms; }
  .revealed .tool-card:nth-child(3) { animation-delay: 280ms; }

  .revealed .page-footer {
    animation: fadeSlideUp 0.35s cubic-bezier(0.25, 1, 0.5, 1) 350ms both;
  }

  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .revealed .page-header,
    .revealed .tool-card,
    .revealed .page-footer {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
  }

  .page-subtitle em {
    font-style: normal;
    color: var(--color-accent-amber);
  }

  /* ---- Card stack ---- */
  .tool-cards {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  /* ---- Card ---- */
  .tool-card {
    --card-accent: var(--color-accent-teal);
    display: flex;
    align-items: stretch;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-text-muted) 3%, transparent);
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    transition: background var(--duration-normal) var(--ease-out-expo);
  }

  .tool-card.accent-teal { --card-accent: var(--color-accent-teal); }
  .tool-card.accent-amber { --card-accent: var(--color-accent-amber); }
  .tool-card.accent-rust { --card-accent: var(--color-accent-rust); }

  .tool-card:hover {
    background: color-mix(in oklab, var(--card-accent) 4%, transparent);
  }

  /* Cursor-following spotlight — uses card accent */
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--glow-x, 50%) var(--glow-y, 50%),
      color-mix(in oklab, var(--card-accent) 6%, transparent),
      transparent 45%
    );
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
    pointer-events: none;
  }

  .tool-card:hover::before { opacity: 1; }

  /* ---- Accent bar — CSS transition ---- */
  .card-bar {
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--card-accent);
    transform-origin: center;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .tool-card:hover .card-bar { transform: scaleY(1.1); }

  /* ---- Ghost number — CSS transition ---- */
  .card-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 6rem);
    line-height: 1;
    color: var(--card-accent);
    opacity: 0.04;
    flex-shrink: 0;
    pointer-events: none;
    position: relative;
    z-index: 1;
    align-self: center;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .tool-card:hover .card-number { opacity: 0.1; }

  /* ---- Content ---- */
  .card-content {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--card-accent);
    margin-bottom: 0.6rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 0.75rem;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .tool-card:hover .card-name { color: var(--color-accent); }

  .card-description {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    max-width: 520px;
  }

  .card-detail {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-text-muted) 65%, transparent);
    margin: 0;
    max-width: 480px;
  }

  /* ---- Action ---- */
  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-end;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .action-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out-expo),
                color var(--duration-fast) var(--ease-out-expo);
  }

  .tool-card:hover .action-label {
    opacity: 1;
    color: var(--color-accent);
  }

  .action-arrow {
    color: var(--color-text-muted);
    opacity: 0.4;
    transition: transform var(--duration-fast) var(--ease-out-expo),
                opacity var(--duration-fast) var(--ease-out-expo),
                color var(--duration-fast) var(--ease-out-expo);
  }

  .tool-card:hover .action-arrow {
    transform: translateX(3px);
    opacity: 1;
    color: var(--color-accent);
  }

  /* ---- Footer ---- */
  .page-footer {
    margin-top: var(--space-block-lg);
    padding-top: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover { color: var(--color-accent); }

  .back-link svg {
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover svg { transform: translateX(-3px); }

  /* ---- Mobile ---- */
  @media (max-width: 640px) {
    .tool-card {
      flex-direction: column;
      gap: 0;
    }

    .card-number {
      position: absolute;
      right: clamp(1rem, 3vw, 1.5rem);
      top: clamp(1rem, 2vw, 1.5rem);
      font-size: clamp(3rem, 6vw, 4rem);
    }

    .card-action {
      align-self: flex-start;
      margin-top: 1.25rem;
    }

    .action-label { opacity: 1; }
  }
</style>

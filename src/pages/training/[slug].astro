---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.svelte';
import { sanityClient } from '../../lib/sanity';
import { isTrainingAssetEnabled, groupSlug, SITE_URL } from '../../lib/training-leads';
import {
  VISUAL_TERMS,
  countVisualTerms,
  resolveHeroSlides,
  resolveShowcase,
  headlineHtml,
  subtitleHtml,
  showcaseTitleOf,
  categoriesTitleOf,
} from '../../lib/training-landing';
import TermVisual from '../../components/training/TermVisual.astro';

// Hero rotator — crossfades through kinetic term diagrams. Each slide is a
// single distinct motion on open canvas; the animation itself teaches the term.
import HeroTermLoop from '../../components/training/HeroTermLoop.svelte';
import HeroRetargeting from '../../components/training/hero-visuals/HeroRetargeting.astro';
import HeroClickRate from '../../components/training/hero-visuals/HeroClickRate.astro';
import HeroConversion from '../../components/training/hero-visuals/HeroConversion.astro';
import HeroFrequency from '../../components/training/hero-visuals/HeroFrequency.astro';
import HeroBounce from '../../components/training/hero-visuals/HeroBounce.astro';

export const prerender = false;

const { slug } = Astro.params;

// Temporarily hidden assets redirect to the index — see training-leads.ts.
if (!isTrainingAssetEnabled(slug)) {
  return Astro.redirect('/training');
}

const asset = await sanityClient.fetch(
  `*[_type == "trainingAsset" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    tagline,
    description,
    accent,
    heroHeadline,
    heroSubtitle,
    heroSlides[]{ visual, term, note },
    showcaseTitle,
    showcaseLead,
    showcasePair,
    categoriesTitle,
    terms[]{ term, definition, group },
    seoTitle,
    noIndex
  }`,
  { slug }
);

if (!asset) {
  return Astro.redirect('/training');
}

type Term = { term: string; definition: string; group?: string | null };
const terms: Term[] = asset.terms || [];
const termCount = terms.length;

// Count of terms with a bespoke visual — drives the "X illustrated" stat.
const visualsCount = countVisualTerms(terms, VISUAL_TERMS);

// Group terms in source (curated) order. Ungrouped terms collapse to "All Terms".
const grouped: Record<string, Term[]> = {};
const groupOrder: string[] = [];
for (const t of terms) {
  const key = (t.group || '').trim() || 'All Terms';
  if (!grouped[key]) {
    grouped[key] = [];
    groupOrder.push(key);
  }
  grouped[key].push(t);
}
const groupCount = groupOrder.length;

// Category cards: name, count, anchor, and the first three curated terms as a teaser.
const categories = groupOrder.map((name) => ({
  name,
  count: grouped[name].length,
  anchor: `group-${groupSlug(name)}`,
  sample: grouped[name].slice(0, 3).map((t) => t.term).join('  ·  '),
}));

// Find a term's definition / category by exact name (for the showcase specimens).
const defOf = (name: string) => terms.find((t) => t.term === name)?.definition ?? '';
const catOf = (name: string) => (terms.find((t) => t.term === name)?.group || '').trim();

const formUrl = `/training/${asset.slug}/form`;
const wordsUrl = `/training/${asset.slug}/words`;

// Hero rotator — Sanity supplies the slides, but each slide's animation is a
// code component, so a slide only renders if its `visual` key resolves in this
// registry. A list with no buildable slides (e.g. a brand-new SEO list)
// collapses the hero to a single column rather than showing the wrong examples.
const heroVisuals: Record<string, any> = {
  retargeting: HeroRetargeting,
  'click-rate': HeroClickRate,
  conversion: HeroConversion,
  frequency: HeroFrequency,
  bounce: HeroBounce,
};
const heroLoop = resolveHeroSlides(asset.heroSlides, heroVisuals);
const showHero = heroLoop.length > 0;

// Showcase specimens come from Sanity, validated against the terms that have a
// visual — no valid specimens -> the section is skipped.
const {
  leadTerm: showcaseLeadTerm,
  pairTerms: showcasePairTerms,
  show: showShowcase,
} = resolveShowcase(asset.showcaseLead, asset.showcasePair, VISUAL_TERMS);

// Landing copy with title-derived fallbacks. `*phrase*` -> accent <em>.
const headline = headlineHtml(asset.heroHeadline, asset.title);
const subtitle = subtitleHtml(asset.heroSubtitle, termCount);
const showcaseTitle = showcaseTitleOf(asset.showcaseTitle);
const categoriesTitle = categoriesTitleOf(asset.categoriesTitle, groupCount);

const pageTitle = `${asset.seoTitle || asset.title}, Devin Alexander`;
const pageDescription =
  asset.description || asset.tagline || `Free asset: ${asset.title}.`;
const ogImage = `/og/training/${asset.slug}.png`;

// Structured data: the gated /words list is noIndex, so expose the glossary's
// value to search engines here on the public landing as a DefinedTermSet.
const definedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: asset.title,
  description: pageDescription,
  url: `${SITE_URL}/training/${asset.slug}`,
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition,
  })),
};
---

<Layout title={pageTitle} description={pageDescription} image={ogImage} noIndex={asset.noIndex}>
  {!asset.noIndex && (
    <script type="application/ld+json" set:html={JSON.stringify(definedTermSet)} />
  )}
  <main class={`landing accent-${asset.accent || 'gold'}`}>

    {/* ─── Section 1: Hero ─── */}
    <section class="hero">
      <div class={`hero-inner${showHero ? '' : ' hero-inner-solo'}`}>

        <div class="hero-left">
          <div class="hero-breadcrumb reveal" style="--reveal-i: 0">
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <Button href="/training" variant="link" size="sm" client:load>Training</Button>
              <svg class="crumb-sep" width="10" height="10" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 2l5 5-5 5"/>
              </svg>
              <span class="crumb-current" aria-current="page">{asset.title}</span>
            </nav>
          </div>

          <div class="hero-headline reveal" style="--reveal-i: 1">
            <h1 class="page-title" set:html={headline} />
            <p class="page-subtitle" set:html={subtitle} />
          </div>

          <div class="hero-cta reveal" style="--reveal-i: 2">
            <Button href={formUrl} variant="primary" size="lg" arrow client:load>
              Get the Word List
            </Button>
          </div>

          <p class="hero-stats reveal" style="--reveal-i: 3">
            <span class="stat-num">{termCount}</span> terms
            {visualsCount > 0 && (
              <>
                <span class="stat-dot" aria-hidden="true">·</span>
                <span class="stat-num">{visualsCount}</span> illustrated
              </>
            )}
            <span class="stat-dot" aria-hidden="true">·</span>
            <span class="stat-num">{groupCount}</span> categories
            <span class="stat-dot" aria-hidden="true">·</span>
            free forever
          </p>
        </div>

        {showHero && (
          <div class="hero-right reveal" style="--reveal-i: 2">
            <HeroTermLoop count={heroLoop.length} interval={7200} client:load>
              {heroLoop.map((s: { Visual: any; term: string; note: string }) => (
                <article data-slide class="tl-slide" aria-label={`Example: ${s.term}`}>
                  <div class="tl-visual"><s.Visual /></div>
                  <div class="tl-cap">
                    <h2 class="tl-term">{s.term}</h2>
                    <p class="tl-note">{s.note}</p>
                  </div>
                </article>
              ))}
            </HeroTermLoop>
          </div>
        )}

      </div>
    </section>

    {/* ─── Section 2: Pitch ─── */}
    <section class="pitch">
      <div class="pitch-inner">
        <p class="section-eyebrow reveal">Why this exists</p>
        <p class="pitch-statement reveal" style="--reveal-i: 1">
          Most glossaries explain a word using three more words you don't
          know either. <em>This one doesn't.</em>
        </p>

        <div class={`pitch-grid${visualsCount > 0 ? '' : ' pitch-grid-solo'}`}>
          {visualsCount > 0 && (
            <figure class="pitch-stat reveal" style="--reveal-i: 2">
              <span class="pitch-stat-num">{visualsCount}</span>
              <figcaption>
                of {termCount} terms come with a picture, so you see how each one
                <em>actually works</em>, instead of picturing it wrong.
              </figcaption>
            </figure>
          )}

          <div class="pitch-who reveal" style="--reveal-i: 3">
            <p class="pitch-who-head">For anyone who ends up in the room without the vocabulary.</p>
            <ul class="pitch-who-list">
              <li>The founder approving the budget</li>
              <li>The designer handed a brief</li>
              <li>Anyone who nodded along, then looked it up after</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ─── Section 3: Visualized showcase (only when specimens have visuals) ─── */}
    {showShowcase && (
      <section class="showcase">
        <div class="showcase-inner">
          <header class="showcase-head reveal">
            <p class="section-eyebrow">Defined, then drawn</p>
            <h2 class="section-title">{showcaseTitle}</h2>
          </header>

          {showcaseLeadTerm && (
            <article class="specimen specimen-lead reveal" style="--reveal-i: 1">
              <div class="specimen-text">
                {catOf(showcaseLeadTerm) && <p class="specimen-cat">{catOf(showcaseLeadTerm)}</p>}
                <h3 class="specimen-term">{showcaseLeadTerm}</h3>
                <p class="specimen-def">{defOf(showcaseLeadTerm)}</p>
              </div>
              <div class="specimen-visual">
                <TermVisual term={showcaseLeadTerm} />
              </div>
            </article>
          )}

          {showcasePairTerms.length > 0 && (
            <div class="specimen-pair">
              {showcasePairTerms.map((term: string, i: number) => (
                <article class="specimen reveal" style={`--reveal-i: ${i + 2}`}>
                  <div class="specimen-text">
                    {catOf(term) && <p class="specimen-cat">{catOf(term)}</p>}
                    <h3 class="specimen-term specimen-term-sm">{term}</h3>
                    <p class="specimen-def">{defOf(term)}</p>
                  </div>
                  <div class="specimen-visual">
                    <TermVisual term={term} />
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    {/* ─── Section 4: Category index ─── */}
    <section class="categories">
      <div class="categories-inner">
        <header class="categories-head reveal">
          <p class="section-eyebrow">{groupCount} categories</p>
          <h2 class="section-title">{categoriesTitle}</h2>
        </header>

        <ul class="category-grid">
          {categories.map((c, i) => (
            <li class="reveal" style={`--reveal-i: ${Math.min(i, 6)}`}>
              <a class="category-card" href={`${wordsUrl}#${c.anchor}`}>
                <div class="card-top">
                  <h3 class="card-name">{c.name}</h3>
                  <span class="card-count">{String(c.count).padStart(2, '0')}</span>
                </div>
                <p class="card-sample">{c.sample}</p>
                <span class="card-arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 7h12M8 2l5 5-5 5" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ─── Section 5: Format / what you get ─── */}
    <section class="format">
      <div class="format-inner">
        <header class="format-head reveal">
          <p class="section-eyebrow">What you get</p>
          <h2 class="section-title">Two formats, no paywall</h2>
        </header>

        <ul class="format-grid">
          <li class="format-item reveal" style="--reveal-i: 1">
            <span class="format-num">01</span>
            <h3 class="format-name">Read it online</h3>
            <p class="format-text">The whole list in the browser. Grouped, searchable, every picture in place.</p>
          </li>
          <li class="format-item reveal" style="--reveal-i: 2">
            <span class="format-num">02</span>
            <h3 class="format-name">Download the PDF</h3>
            <p class="format-text">A typeset copy in the same fonts as the site. Good for printing, or sending to whoever needs it.</p>
          </li>
          <li class="format-item reveal" style="--reveal-i: 3">
            <span class="format-num">03</span>
            <h3 class="format-name">Free forever</h3>
            <p class="format-text">No paywall now, none later. Leave an email so I know where to send the link. That is the whole transaction.</p>
          </li>
        </ul>
      </div>
    </section>

    {/* ─── Section 6: Closing CTA ─── */}
    <section class="closer">
      <div class="closer-inner reveal">
        <h2 class="closer-title">Get the {termCount}-term list</h2>
        <p class="closer-sub">Defined, mostly illustrated, free. The only cost is an email address.</p>
        <div class="closer-cta">
          <Button href={formUrl} variant="primary" size="lg" arrow client:load>
            Get the Word List
          </Button>
        </div>
        <p class="closer-foot">
          Want someone to run this stuff for you? <a href="/contact#book">Book a call</a>.
        </p>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ─── Page accent system (matches /training index pattern) ─── */
  .landing {
    --landing-accent: var(--color-accent);
    /* hero-visuals + carousel read --words-accent; bridge it to the page accent */
    --words-accent: var(--landing-accent);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .landing.accent-gold  { --landing-accent: var(--color-accent); }
  .landing.accent-teal  { --landing-accent: var(--color-accent-teal); }
  .landing.accent-amber { --landing-accent: var(--color-accent-amber); }
  .landing.accent-rust  { --landing-accent: var(--color-accent-rust); }

  /* ─── Shared section primitives ─── */
  .section-eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--landing-accent);
  }
  .section-title {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    max-width: 22ch;
  }

  /* ─── Section 1: Hero ─── */
  .hero {
    padding: var(--space-page-top) var(--space-page-x) var(--space-block);
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-block);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-block-lg);
    }
    /* No hero animation -> keep the copy column from stretching full-bleed. */
    .hero-inner-solo {
      grid-template-columns: 1fr;
      max-width: 720px;
    }
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-element);
  }
  .hero-right { display: flex; min-width: 0; justify-content: center; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .crumb-sep { color: var(--color-text-subtle); flex-shrink: 0; }
  .crumb-current { color: var(--color-text); }

  .hero-headline {
    display: flex;
    flex-direction: column;
    gap: var(--space-element);
  }
  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }
  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 48ch;
    margin: 0;
  }
  .page-subtitle em { font-style: normal; color: var(--landing-accent); }

  .hero-cta { display: flex; }

  .hero-stats {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .stat-num { color: var(--color-text); }
  .stat-dot { color: var(--landing-accent); margin-inline: 0.4em; }

  /* ─── Hero term-loop slides ─── */
  .tl-slide {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .tl-visual {
    display: grid;
    place-items: center;
    min-height: 340px;
  }
  .tl-cap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tl-term {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }
  .tl-note {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  /* ─── Section 2: Pitch ─── */
  .pitch {
    padding: var(--space-block-lg) var(--space-page-x);
  }
  .pitch-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* the thesis — dramatic scale, the turn set in accent */
  .pitch-statement {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.18;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    max-width: 22ch;
    text-wrap: balance;
  }
  .pitch-statement em {
    font-style: normal;
    color: var(--landing-accent);
  }

  .pitch-grid {
    margin-top: var(--space-block);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-block);
    align-items: start;
  }
  @media (min-width: 760px) {
    .pitch-grid { grid-template-columns: 1fr 1fr; gap: var(--space-block-lg); }
    .pitch-grid-solo { grid-template-columns: 1fr; }
  }

  /* stat figure — a visual anchor for the "with a picture" claim */
  .pitch-stat {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 1.1rem;
  }
  .pitch-stat-num {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--weight-regular);
    line-height: 0.82;
    letter-spacing: var(--tracking-tight);
    color: var(--landing-accent);
    font-variant-numeric: tabular-nums;
  }
  .pitch-stat figcaption {
    align-self: center;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 32ch;
  }
  .pitch-stat figcaption em { font-style: normal; color: var(--color-text); }

  /* who it's for — scannable numbered list, not a run-on paragraph */
  .pitch-who-head {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    max-width: 30ch;
  }
  .pitch-who-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: who;
    display: flex;
    flex-direction: column;
  }
  .pitch-who-list li {
    counter-increment: who;
    position: relative;
    padding: 0.7rem 0 0.7rem 2.4rem;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.4;
    color: var(--color-text-muted);
    border-top: var(--border-subtle);
  }
  .pitch-who-list li:first-child { border-top: none; }
  .pitch-who-list li::before {
    content: counter(who, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.78rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-tight);
    color: var(--landing-accent);
    font-variant-numeric: tabular-nums;
  }

  /* ─── Section 3: Showcase ─── */
  .showcase {
    padding: var(--space-block-lg) var(--space-page-x);
  }
  .showcase-inner { max-width: 1100px; margin: 0 auto; }
  .showcase-head { margin-bottom: var(--space-block); }

  /* Each specimen is a genuinely elevated surface: lighter than the page,
     carries a real (glow-free) shadow, and frames the visual with air so the
     depth reads bg → card → the visual's own inner tile. */
  .specimen {
    display: flex;
    flex-direction: column;
    gap: var(--space-element);
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 9%, transparent);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    transition:
      box-shadow var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
  }
  .specimen:hover {
    border-color: color-mix(in oklab, var(--landing-accent) 28%, transparent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .specimen-lead {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }
  @media (min-width: 760px) {
    .specimen-lead { grid-template-columns: 0.85fr 1.15fr; }
  }
  .specimen-cat {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--landing-accent);
  }
  .specimen-term {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }
  .specimen-term-sm { font-size: var(--text-xl); }
  .specimen-def {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);

---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';

export const prerender = false;

const { slug } = Astro.params;

const asset = await sanityClient.fetch(
  `*[_type == "trainingAsset" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    category,
    tagline,
    description,
    accent,
    publishedAt,
    "termCount": count(terms),
    seoTitle,
    noIndex
  }`,
  { slug }
);

if (!asset) {
  return Astro.redirect('/training');
}

const categoryLabels: Record<string, string> = {
  'word-list': 'Word List',
  playbook: 'Playbook',
  checklist: 'Checklist',
  template: 'Template',
  guide: 'Guide',
};

const pageTitle = `${asset.seoTitle || asset.title} — Devin Alexander`;
const pageDescription = asset.description || asset.tagline || `Free ${categoryLabels[asset.category] || 'asset'}: ${asset.title}.`;
---

<Layout title={pageTitle} description={pageDescription} noIndex={asset.noIndex}>
  <main>
    <section class={`gate-page accent-${asset.accent || 'gold'}`}>
      <div class="gate-inner">
        <header class="page-header">
          <div class="section-tag">
            <span class="tag-label">{categoryLabels[asset.category] || 'Asset'}</span>
          </div>
          <h1 class="page-title">{asset.title}</h1>
          {asset.description && <p class="page-summary">{asset.description}</p>}
          {asset.termCount > 0 && (
            <p class="page-meta">
              <span class="meta-num">{asset.termCount}</span>
              <span>terms</span>
              <span class="meta-dot" aria-hidden="true">&middot;</span>
              <span>Free download</span>
            </p>
          )}
        </header>

        <div class="form-card">
          <div class="card-accent" aria-hidden="true"></div>

          <div data-state="form" id="form-panel">
            <p class="panel-hint">Where should I send it?</p>

            <form id="training-form" class="training-form" novalidate>
              <input type="hidden" name="assetSlug" value={asset.slug} />

              <div class="form-field">
                <input type="text" name="name" placeholder="Name" required class="form-input" autocomplete="name" aria-label="Your name" />
                <div class="input-line"></div>
              </div>

              <div class="form-field">
                <input type="email" name="email" placeholder="Email" required class="form-input" autocomplete="email" aria-label="Your email address" />
                <div class="input-line"></div>
              </div>

              <div class="form-field">
                <input type="text" name="company" placeholder="Company name" required class="form-input" autocomplete="organization" aria-label="Your company name" />
                <div class="input-line"></div>
              </div>

              <div class="form-field">
                <input type="text" name="jobTitle" placeholder="Job title" required class="form-input" autocomplete="organization-title" aria-label="Your job title" />
                <div class="input-line"></div>
              </div>

              <button type="submit" class="form-submit" id="form-submit">
                <span class="btn-label">Send it to me</span>
                <span class="btn-sending" hidden>Sending<span class="loading-dots"><span>.</span><span>.</span><span>.</span></span></span>
              </button>

              <p class="form-status" id="form-status" aria-live="polite"></p>

              <p class="form-fine">
                By submitting, you'll receive the download link by email. No spam, no nurture sequence unless you opt in.
              </p>
            </form>
          </div>

          <div data-state="success" id="success-panel" hidden>
            <div class="form-success">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5"/>
              </svg>
              <p class="success-text">It's on its way. Check your inbox for the download link.</p>
              <a href={`/training/${asset.slug}/words`} class="success-cta" id="success-cta">
                Or open it now
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 7h12M8 2l5 5-5 5" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="page-footer">
          <a href="/training" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            All training assets
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('training-form') as HTMLFormElement | null;
  const submit = document.getElementById('form-submit') as HTMLButtonElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  const formPanel = document.getElementById('form-panel') as HTMLElement | null;
  const successPanel = document.getElementById('success-panel') as HTMLElement | null;
  const successCta = document.getElementById('success-cta') as HTMLAnchorElement | null;

  function setLoading(loading: boolean) {
    if (!submit) return;
    const label = submit.querySelector('.btn-label') as HTMLElement;
    const sending = submit.querySelector('.btn-sending') as HTMLElement;
    submit.disabled = loading;
    label.hidden = loading;
    sending.hidden = !loading;
  }

  function showError(msg: string) {
    if (!status) return;
    status.textContent = msg;
    status.classList.add('error');
    status.classList.remove('success');
  }

  function clearError() {
    if (!status) return;
    status.textContent = '';
    status.classList.remove('error');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const fd = new FormData(form);
    const payload = {
      name: String(fd.get('name') || '').trim(),
      email: String(fd.get('email') || '').trim(),
      company: String(fd.get('company') || '').trim(),
      jobTitle: String(fd.get('jobTitle') || '').trim(),
      assetSlug: String(fd.get('assetSlug') || '').trim(),
    };

    if (!payload.name || !payload.email || !payload.company || !payload.jobTitle) {
      showError('Please fill in every field.');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) {
      showError("That email address doesn't look right.");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch('/api/training-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        showError(data.error || 'Something went wrong. Please try again.');
        setLoading(false);
        return;
      }

      if (data.assetUrl && successCta) {
        successCta.href = data.assetUrl;
      }
      if (formPanel && successPanel) {
        formPanel.hidden = true;
        successPanel.hidden = false;
      }
    } catch (err) {
      console.error(err);
      showError('Network error. Please try again.');
      setLoading(false);
    }
  });
</script>

<style>
  .gate-page {
    --gate-accent: var(--color-accent);
    min-height: 100dvh;
    padding: clamp(6rem, 14vh, 10rem) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
    display: grid;
    place-items: center;
  }
  .gate-page.accent-gold { --gate-accent: var(--color-accent); }
  .gate-page.accent-teal { --gate-accent: var(--color-accent-teal); }
  .gate-page.accent-amber { --gate-accent: var(--color-accent-amber); }
  .gate-page.accent-rust { --gate-accent: var(--color-accent-rust); }

  .gate-inner {
    width: 100%;
    max-width: 580px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ─── Section tag (matches site convention) ─── */
  .section-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-label {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--gate-accent);
  }

  /* ─── Header ─── */
  .page-header {
    margin-bottom: var(--space-block);
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 540px;
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .page-summary {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem;
    max-width: 48ch;
  }

  .page-meta {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .meta-num {
    font-family: 'DM Sans', sans-serif;
    font-weight: var(--weight-medium);
    color: var(--gate-accent);
    font-size: var(--text-xs);
  }

  .meta-dot {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  /* ─── Form card ─── */
  .form-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    transition: border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 60px color-mix(in oklab, var(--gate-accent) 4%, transparent),
                0 0 120px color-mix(in oklab, var(--gate-accent) 3%, transparent);
    text-align: left;
  }

  .form-card:hover {
    border-color: color-mix(in oklab, var(--color-text-muted) 22%, transparent);
    box-shadow: 0 0 80px color-mix(in oklab, var(--gate-accent) 6%, transparent),
                0 0 160px color-mix(in oklab, var(--gate-accent) 4%, transparent);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--gate-accent), color-mix(in oklab, var(--gate-accent) 30%, transparent));
  }

  /* ─── Panel hint (single short prompt line) ─── */
  .panel-hint {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* ─── Form (matches contact.astro patterns) ─── */
  .training-form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .form-field {
    margin-bottom: 1rem;
    position: relative;
  }

  .form-input {
    width: 100%;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-base);
    color: var(--color-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 20%, transparent);
    padding: 0.85rem 0;
    outline: none;
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .input-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--gate-accent), color-mix(in oklab, var(--gate-accent) 40%, transparent));
    transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input:focus ~ .input-line {
    width: 100%;
  }

  .form-input:focus {
    border-color: var(--gate-accent);
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input:focus::placeholder {
    opacity: 0.4;
  }

  .form-submit {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    background-color: var(--gate-accent);
    background-image: linear-gradient(90deg, color-mix(in oklab, var(--gate-accent) 80%, white) 50%, transparent 50%);
    background-size: 200% 100%;
    background-position: 100% 0;
    color: var(--color-bg);
    border: 1px solid var(--gate-accent);
    padding: 0.85rem 2rem;
    cursor: pointer;
    transition: background-position 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0.5rem;
    align-self: center;
    min-width: 200px;
  }

  .form-submit:hover:not(:disabled) {
    background-position: 0% 0;
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-sending {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .loading-dots span {
    animation: dots 1.4s infinite;
    opacity: 0;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dots {
    0%, 80%, 100% { opacity: 0; }
    40% { opacity: 1; }
  }

  .form-status {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    margin: 0.75rem 0 0;
    min-height: 1.2em;
    text-align: center;
    color: var(--color-text-muted);
  }

  .form-status.error {
    color: var(--color-accent-rust);
  }

  .form-fine {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 1rem 0 0;
    text-align: center;
    opacity: 0.8;
  }

  /* ─── Success state ─── */
  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem) 0;
    text-align: center;
    animation: panel-enter 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .form-success svg {
    color: var(--gate-accent);
  }

  .success-text {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
    max-width: 36ch;
  }

  .success-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--gate-accent);
    text-decoration: none;
    padding-top: 0.5rem;
    transition: gap 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .success-cta:hover { gap: 0.7rem; }

  @keyframes panel-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ─── Footer ─── */
  .page-footer {
    width: 100%;
    max-width: 540px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
    text-align: left;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-link:hover { color: var(--gate-accent); }
  .back-link svg { transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
  .back-link:hover svg { transform: translateX(-3px); }
</style>

---
import Layout from '../../../layouts/Layout.astro';
import { sanityClient } from '../../../lib/sanity';

export const prerender = false;

const { slug } = Astro.params;

const asset = await sanityClient.fetch(
  `*[_type == "trainingAsset" && slug.current == $slug][0] {
    title,
    "slug": slug.current,
    category,
    tagline,
    description,
    accent,
    publishedAt,
    terms[]{ term, definition, group }
  }`,
  { slug }
);

if (!asset) {
  return Astro.redirect('/training');
}

const categoryLabels: Record<string, string> = {
  'word-list': 'Word List',
  playbook: 'Playbook',
  checklist: 'Checklist',
  template: 'Template',
  guide: 'Guide',
};

// Group terms by their optional "group" field. Ungrouped terms fall under "General".
type Term = { term: string; definition: string; group?: string | null };
const terms: Term[] = asset.terms || [];
const grouped: Record<string, Term[]> = {};
const groupOrder: string[] = [];
for (const t of terms) {
  const key = (t.group || '').trim() || 'All Terms';
  if (!grouped[key]) {
    grouped[key] = [];
    groupOrder.push(key);
  }
  grouped[key].push(t);
}
// Sort each group's terms alphabetically by term name
for (const key of groupOrder) {
  grouped[key].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
}

const formattedDate = asset.publishedAt
  ? new Date(asset.publishedAt).toLocaleDateString('en-US', {
      month: 'long', year: 'numeric',
    })
  : '';
---

<Layout
  title={`${asset.title} — Devin Alexander`}
  description={asset.tagline || asset.description || `${asset.title}: a free reference.`}
  noIndex={true}
>
  <main>
    <section class={`words-page accent-${asset.accent || 'gold'}`}>
      <div class="words-inner">

        <header class="words-header">
          <div class="meta-row no-print">
            <a href="/training" class="back-link">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 7H1M6 2L1 7l5 5" />
              </svg>
              Training
            </a>
            <span class="meta-divider" aria-hidden="true">&middot;</span>
            <span class="meta-cat">{categoryLabels[asset.category] || 'Asset'}</span>
            {formattedDate && (
              <>
                <span class="meta-divider" aria-hidden="true">&middot;</span>
                <span class="meta-date">{formattedDate}</span>
              </>
            )}
          </div>

          <h1 class="words-title">{asset.title}</h1>
          {asset.tagline && <p class="words-tagline">{asset.tagline}</p>}

          <div class="words-actions no-print">
            <button type="button" id="download-pdf" class="action-btn primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download PDF
            </button>
            <span class="action-meta">
              <span class="action-num">{terms.length}</span> terms
            </span>
          </div>
        </header>

        <div class="words-body" id="words-body">
          {groupOrder.map((group) => (
            <section class="word-group">
              {groupOrder.length > 1 && (
                <h2 class="group-heading">
                  <span class="group-rule" aria-hidden="true"></span>
                  {group}
                </h2>
              )}
              <dl class="word-list">
                {grouped[group].map((t) => (
                  <div class="word-entry">
                    <dt class="word-term">{t.term}</dt>
                    <dd class="word-def">{t.definition}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        <footer class="words-footer no-print">
          <p class="footer-text">
            Built by <a href="/" class="footer-link">Devin Alexander</a>. If you need more in-depth marketing help, <a href="/contact#book" class="footer-link">book a call</a>.
          </p>
        </footer>

      </div>
    </section>
  </main>
</Layout>

<script>
  import jsPDF from 'jspdf';

  // Cache assets across multiple clicks
  let assetsPromise: Promise<{
    serif: string;
    serifItalic: string;
    sans: string;
    avatar: string;
  }> | null = null;

  async function fetchBase64(url: string): Promise<string> {
    const res = await fetch(url);
    const buf = await res.arrayBuffer();
    const bytes = new Uint8Array(buf);
    let bin = '';
    const chunk = 0x8000;
    for (let i = 0; i < bytes.length; i += chunk) {
      bin += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk) as unknown as number[]);
    }
    return btoa(bin);
  }

  function loadAssets() {
    if (!assetsPromise) {
      assetsPromise = Promise.all([
        fetchBase64('/fonts/InstrumentSerif-Regular-Latin.ttf'),
        fetchBase64('/fonts/InstrumentSerif-Italic-Latin.ttf'),
        fetchBase64('/fonts/DMSans-Regular.ttf'),
        fetchBase64('/images/avatar-round.png'),
      ]).then(([serif, serifItalic, sans, avatar]) => ({
        serif,
        serifItalic,
        sans,
        avatar: `data:image/png;base64,${avatar}`,
      }));
    }
    return assetsPromise;
  }

  function bindWordsActions() {
    const pdfBtn = document.getElementById('download-pdf');
    if (!pdfBtn) return;
    if ((pdfBtn as any)._bound) return;
    (pdfBtn as any)._bound = true;

    pdfBtn.addEventListener('click', async () => {
      const labelEl = pdfBtn.querySelector('span, .btn-label') as HTMLElement | null;
      const originalLabel = pdfBtn.textContent;
      try {
        (pdfBtn as HTMLButtonElement).disabled = true;
        if (labelEl) labelEl.textContent = 'Generating…';

        const title = document.querySelector('.words-title')?.textContent?.trim() || 'Word List';
        const tagline = document.querySelector('.words-tagline')?.textContent?.trim() || '';
        const slug = location.pathname.replace(/\/words\/?$/, '').split('/').filter(Boolean).pop() || '';
        const assetUrl = `devin.vc/training/${slug}`;
        const contactUrl = 'https://www.devin.vc/contact';
        const groups = Array.from(document.querySelectorAll('.word-group'));

        const assets = await loadAssets();

        // ─── A4: 595.28 × 841.89 pt (210 × 297 mm). 25mm margins ≈ 71pt ───
        const doc = new jsPDF({ unit: 'pt', format: 'a4' });
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const marginX = 71;
        const marginYTop = 64;
        const marginYBottom = 64;
        const contentW = pageW - marginX * 2;
        // Custom-embedded fonts can have imprecise width metrics in jsPDF.
        // Apply a small safety margin to line-wrapping so text never overruns.
        const wrapW = contentW - 4;

        // ─── Register site fonts ───
        doc.addFileToVFS('InstrumentSerif-Regular.ttf', assets.serif);
        doc.addFont('InstrumentSerif-Regular.ttf', 'InstrumentSerif', 'normal');
        doc.addFileToVFS('InstrumentSerif-Italic.ttf', assets.serifItalic);
        doc.addFont('InstrumentSerif-Italic.ttf', 'InstrumentSerif', 'italic');
        doc.addFileToVFS('DMSans-Regular.ttf', assets.sans);
        doc.addFont('DMSans-Regular.ttf', 'DMSans', 'normal');

        // ─── Site palette in light mode ───
        const text = [20, 18, 16] as const;       // near-black
        const muted = [110, 100, 90] as const;    // muted brown
        const dim = [160, 148, 136] as const;     // very muted for footer
        const accent = [196, 164, 124] as const;  // warm gold (--color-accent)

        let y = marginYTop;

        // ─── Title ───
        doc.setFont('InstrumentSerif', 'normal');
        doc.setFontSize(36);
        doc.setTextColor(...text);
        doc.text(title, marginX, y);
        y += 38;

        // ─── Tagline ───
        if (tagline) {
          doc.setFont('DMSans', 'normal');
          doc.setFontSize(11);
          doc.setTextColor(...muted);
          const taglineLines = doc.splitTextToSize(tagline, wrapW);
          doc.text(taglineLines, marginX, y);
          y += taglineLines.length * 16 + 14;
        }

        // ─── Author block (below tagline): circular avatar + Devin Alexander ───
        const avatarSize = 28;
        doc.addImage(assets.avatar, 'PNG', marginX, y, avatarSize, avatarSize);
        doc.setFont('InstrumentSerif', 'italic');
        doc.setFontSize(16);
        doc.setTextColor(...text);
        doc.text('Devin Alexander', marginX + avatarSize + 10, y + avatarSize / 2 + 5, { baseline: 'middle' });
        y += avatarSize + 28;

        // ─── Groups + entries ───
        function ensureRoom(needed: number) {
          if (y + needed > pageH - marginYBottom) {
            doc.addPage();
            y = marginYTop;
          }
        }

        for (const groupEl of groups) {
          const heading = groupEl.querySelector('.group-heading')?.textContent?.trim();
          const entries = Array.from(groupEl.querySelectorAll('.word-entry'));

          if (heading && groups.length > 1) {
            // Reserve room for heading + first entry to prevent orphan headings
            const firstEntry = entries[0];
            let firstHeight = 60;
            if (firstEntry) {
              const def = firstEntry.querySelector('.word-def')?.textContent?.trim() || '';
              const lines = doc.splitTextToSize(def, wrapW);
              firstHeight = 20 + lines.length * 14 + 14;
            }
            ensureRoom(46 + firstHeight);

            doc.setFont('DMSans', 'normal');
            doc.setFontSize(9);
            doc.setTextColor(...accent);
            doc.text(heading.toUpperCase(), marginX, y);
            y += 6;
            doc.setDrawColor(220, 195, 155);
            doc.setLineWidth(0.5);
            doc.line(marginX, y, marginX + contentW, y);
            y += 22;
          }

          for (const entry of entries) {
            const term = entry.querySelector('.word-term')?.textContent?.trim() || '';
            const def = entry.querySelector('.word-def')?.textContent?.trim() || '';
            const defLines = doc.splitTextToSize(def, wrapW);
            const blockHeight = 22 + defLines.length * 14 + 16;

            ensureRoom(blockHeight);

            // Term in serif (matches site .word-term)
            doc.setFont('InstrumentSerif', 'normal');
            doc.setFontSize(17);
            doc.setTextColor(...text);
            doc.text(term, marginX, y);
            y += 20;

            // Definition in DM Sans (matches site .word-def)
            doc.setFont('DMSans', 'normal');
            doc.setFontSize(10.5);
            doc.setTextColor(...muted);
            doc.text(defLines, marginX, y);
            y += defLines.length * 14 + 16;
          }
        }

        // ─── Closing block: avatar + sign-off + contact CTA ───
        const closingHeight = 30 + 14 + 16 + 14 + 32;
        ensureRoom(closingHeight + 24);
        y += 24;

        // Hairline rule above the closing block
        doc.setDrawColor(220, 195, 155);
        doc.setLineWidth(0.5);
        doc.line(marginX, y, marginX + contentW, y);
        y += 28;

        const closeAvatarSize = 32;
        doc.addImage(assets.avatar, 'PNG', marginX, y, closeAvatarSize, closeAvatarSize);
        doc.setFont('InstrumentSerif', 'italic');
        doc.setFontSize(16);
        doc.setTextColor(...text);
        doc.text('Devin Alexander', marginX + closeAvatarSize + 12, y + closeAvatarSize / 2 + 5, { baseline: 'middle' });
        y += closeAvatarSize + 14;

        // Sign-off message
        doc.setFont('DMSans', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(...text);
        const signoffLines = doc.splitTextToSize('This document was written by Devin Alexander.', wrapW);
        doc.text(signoffLines, marginX, y);
        y += signoffLines.length * 16 + 4;

        doc.setTextColor(...muted);
        const ctaPrefix = 'If you need more in-depth marketing advice or help, feel free to reach out ';
        const ctaWord = 'here';
        const ctaSuffix = '.';
        // Print the static prefix, then "here" in gold + underlined as a real link
        const prefixLines = doc.splitTextToSize(ctaPrefix + ctaWord + ctaSuffix, wrapW);
        // Render the prefix lines normally first to position them
        // Then we overlay a clickable link on the rendered "here" position.
        doc.text(prefixLines, marginX, y);

        // To get the link to align with the rendered "here", compute the
        // width of the last line's content up to (and including) "here".
        const lastLine = prefixLines[prefixLines.length - 1] as string;
        const hereIdx = lastLine.lastIndexOf(ctaWord);
        if (hereIdx >= 0) {
          const beforeHere = lastLine.slice(0, hereIdx);
          const beforeWidth = doc.getTextWidth(beforeHere);
          const hereWidth = doc.getTextWidth(ctaWord);
          const linkX = marginX + beforeWidth;
          const linkY = y + (prefixLines.length - 1) * 16;

          // Cover original "here" with a gold accented version and underline
          doc.setTextColor(...accent);
          doc.text(ctaWord, linkX, linkY);
          // Underline
          doc.setDrawColor(...accent);
          doc.setLineWidth(0.6);
          doc.line(linkX, linkY + 1.5, linkX + hereWidth, linkY + 1.5);
          // Clickable link region
          doc.link(linkX, linkY - 10, hereWidth, 14, { url: contactUrl });
        }

        // ─── Footer on every page ───
        const pageCount = doc.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
          doc.setPage(i);
          doc.setFont('DMSans', 'normal');
          doc.setFontSize(8);
          doc.setTextColor(...dim);
          doc.text(
            `${title}  ·  ${assetUrl}  ·  Page ${i} of ${pageCount}`,
            pageW / 2,
            pageH - 36,
            { align: 'center' }
          );
        }

        const safeName = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        doc.save(`${safeName}.pdf`);
      } catch (err) {
        console.error('[words] PDF generation failed:', err);
        alert('Sorry, the PDF could not be generated. Please try again.');
      } finally {
        (pdfBtn as HTMLButtonElement).disabled = false;
        if (labelEl && originalLabel) labelEl.textContent = originalLabel;
        else if (originalLabel) pdfBtn.textContent = originalLabel;
      }
    });
  }

  // Bind on initial load and on every view-transition navigation
  bindWordsActions();
  document.addEventListener('astro:page-load', bindWordsActions);
</script>

<style>
  .words-page {
    --words-accent: var(--color-accent);
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }
  .words-page.accent-gold { --words-accent: var(--color-accent); }
  .words-page.accent-teal { --words-accent: var(--color-accent-teal); }
  .words-page.accent-amber { --words-accent: var(--color-accent-amber); }
  .words-page.accent-rust { --words-accent: var(--color-accent-rust); }

  .words-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .words-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-accent); }
  .back-link svg { transition: transform 0.2s; }
  .back-link:hover svg { transform: translateX(-2px); }

  .meta-divider { opacity: 0.5; }
  .meta-cat { color: var(--words-accent); font-weight: var(--weight-medium); }

  .words-title {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .words-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
  }

  .words-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 25%, transparent);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .action-btn:hover {
    border-color: var(--words-accent);
    color: var(--words-accent);
    transform: translateY(-1px);
  }

  .action-btn.primary {
    color: var(--color-bg);
    background: var(--words-accent);
    border-color: var(--words-accent);
  }
  .action-btn.primary:hover {
    color: var(--color-bg);
    background: color-mix(in oklab, var(--words-accent) 90%, white);
  }

  .action-meta {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-left: auto;
  }

  .action-num {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: var(--text-md);
    color: var(--words-accent);
    text-transform: none;
    letter-spacing: 0;
  }

  .word-group + .word-group {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .group-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--words-accent);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .group-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--words-accent), transparent);
    max-width: 64px;
  }

  .word-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .word-entry {
    padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
  }

  .word-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .word-term {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 0.45rem;
  }

  .word-def {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-text);
    margin: 0;
    max-width: 64ch;
  }

  .words-footer {
    margin-top: clamp(3rem, 6vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .footer-text {
    font-family: 'DM Sans', sans-serif;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-link {
    color: var(--words-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--words-accent) 40%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .footer-link:hover { text-decoration-color: var(--words-accent); }

  /* ─── Print stylesheet — gives a clean PDF from browser "Save as PDF" ─── */
  @media print {
    .no-print { display: none !important; }
    body { background: white !important; color: black !important; }
    .words-page { padding: 0; background: white; }
    .words-inner { max-width: none; }
    .words-title { color: #14110e !important; font-size: 32pt !important; }
    .words-tagline { color: #5a5048 !important; font-size: 13pt !important; }
    .group-heading { color: #b59059 !important; font-size: 10pt !important; }
    .group-rule { background: #b59059 !important; }
    .word-term { color: #14110e !important; font-size: 14pt !important; }
    .word-def { color: #2a2520 !important; font-size: 11pt !important; }
    .word-entry { border-bottom-color: #d8cfc1 !important; page-break-inside: avoid; }
    .word-group { page-break-inside: auto; }
  }
</style>

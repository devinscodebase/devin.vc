---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';
import { isTrainingAssetEnabled } from '../../lib/training-leads';

export const prerender = false;

const allAssets = await sanityClient.fetch(`
  *[_type == "trainingAsset"] | order(order asc) {
    title,
    "slug": slug.current,
    category,
    tagline,
    description,
    accent,
    featured,
    publishedAt
  }
`);

// Only show live assets — see ENABLED_TRAINING_SLUGS in training-leads.ts.
const assets = allAssets.filter((a: any) => isTrainingAssetEnabled(a.slug));

const categoryLabels: Record<string, string> = {
  'word-list': 'Word List',
  playbook: 'Playbook',
  checklist: 'Checklist',
  template: 'Template',
  guide: 'Guide',
};
---

<Layout
  title="Training, Devin Alexander"
  description="Free training assets for marketing operators, founders, and teams. Word lists, playbooks, and references built from real work."
  image="/og/training.png"
>
  <main>
    <section class="training-page">
      <div class="training-inner">
        <header class="page-header reveal">
          <div class="section-tag"><span class="tag-label">Training</span></div>
          <h1 class="page-title">Training</h1>
          <p class="page-subtitle">Free word lists, playbooks, and references built from <em>real</em> work. Grab what you need.</p>
        </header>

        {assets.length === 0 ? (
          <p class="empty reveal" style="--reveal-i: 1">More assets are on the way. Check back soon.</p>
        ) : (
          <div class="asset-cards">
            {assets.map((asset: any, i: number) => (
              <a href={`/training/${asset.slug}`} class={`asset-card accent-${asset.accent || 'gold'} reveal`} style={`--reveal-i: ${i + 1}`}>
                <div class="card-bar" aria-hidden="true" />
                <span class="card-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="card-content">
                  <span class="card-tag">{categoryLabels[asset.category] || asset.category}</span>
                  <h2 class="card-name">{asset.title}</h2>
                  {asset.tagline && <p class="card-description">{asset.tagline}</p>}
                  {asset.description && <p class="card-detail">{asset.description}</p>}
                </div>
                <div class="card-action">
                  <span class="action-label">Get it</span>
                  <svg class="action-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 7h12M8 2l5 5-5 5" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Entrance fades handled by the global .reveal utility. Script owns
  // only the cursor-following spotlight; hover lift/shift are CSS.
  document.querySelectorAll<HTMLElement>('.asset-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--glow-x', `${(e as MouseEvent).clientX - rect.left}px`);
      card.style.setProperty('--glow-y', `${(e as MouseEvent).clientY - rect.top}px`);
    });
  });
</script>

<style>
  .training-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .training-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* Entrance fades handled by the global .reveal utility.
     Hover lift + name shift are pure CSS transitions. */
  .asset-card {
    transition:
      background var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-spring);
  }
  .asset-card:hover { transform: translateY(-5px); }
  .asset-card .card-name {
    transition: transform var(--duration-fast) var(--ease-spring);
  }
  .asset-card:hover .card-name { transform: translateX(4px); }

  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .page-header { margin-bottom: var(--space-block-lg); }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0;
  }

  .page-subtitle em {
    font-style: normal;
    color: var(--color-accent);
  }

  .empty {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    padding: 3rem 0;
    text-align: center;
  }

  .asset-cards {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .asset-card {
    --card-accent: var(--color-accent);
    display: flex;
    align-items: stretch;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-text-muted) 3%, transparent);
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    transition: background var(--duration-normal) var(--ease-out-expo);
  }

  .asset-card.accent-gold { --card-accent: var(--color-accent); }
  .asset-card.accent-teal { --card-accent: var(--color-accent-teal); }
  .asset-card.accent-amber { --card-accent: var(--color-accent-amber); }
  .asset-card.accent-rust { --card-accent: var(--color-accent-rust); }

  .asset-card:hover {
    background: color-mix(in oklab, var(--card-accent) 4%, transparent);
  }

  .asset-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--glow-x, 50%) var(--glow-y, 50%),
      color-mix(in oklab, var(--card-accent) 6%, transparent),
      transparent 45%
    );
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
    pointer-events: none;
  }

  .asset-card:hover::before { opacity: 1; }

  .card-bar {
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--card-accent);
    transform-origin: center;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .asset-card:hover .card-bar { transform: scaleY(1.1); }

  .card-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 6rem);
    line-height: 1;
    color: var(--card-accent);
    opacity: 0.04;
    flex-shrink: 0;
    pointer-events: none;
    position: relative;
    z-index: 1;
    align-self: center;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .asset-card:hover .card-number { opacity: 0.1; }

  .card-content {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--card-accent);
    margin-bottom: 0.6rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .card-description {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-text);
    margin: 0 0 0.6rem;
  }

  .card-detail {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 56ch;
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    align-self: center;
    color: var(--card-accent);
    position: relative;
    z-index: 1;
  }

  .action-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .action-arrow {
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .asset-card:hover .action-arrow {
    transform: translateX(4px);
  }

  .page-footer {
    margin-top: var(--space-block-lg);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover { color: var(--color-accent); }

  .back-link svg {
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover svg { transform: translateX(-3px); }

  @media (max-width: 640px) {
    .asset-card {
      flex-direction: column;
      gap: 1.25rem;
    }
    .card-number { display: none; }
    .card-action { align-self: flex-start; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { db } from '../lib/db';
import { subscribers } from '../db/schema';
import { eq } from 'drizzle-orm';
import { resend } from '../lib/resend';

export const prerender = false;

const token = Astro.url.searchParams.get('token');
let status: 'success' | 'already' | 'invalid' = 'invalid';

if (token) {
  const subscriber = await db
    .select()
    .from(subscribers)
    .where(eq(subscribers.token, token))
    .get();

  if (subscriber) {
    if (subscriber.status === 'unsubscribed') {
      status = 'already';
    } else {
      await db
        .update(subscribers)
        .set({
          status: 'unsubscribed',
          unsubscribedAt: new Date().toISOString(),
        })
        .where(eq(subscribers.id, subscriber.id));

      // Sync to Resend
      if (subscriber.resendContactId && import.meta.env.RESEND_AUDIENCE_ID) {
        try {
          await resend.contacts.update({
            id: subscriber.resendContactId,
            audienceId: import.meta.env.RESEND_AUDIENCE_ID,
            unsubscribed: true,
          });
        } catch {
          // Non-critical
        }
      }

      status = 'success';
    }
  }
}

const titles = {
  success: "You've been unsubscribed",
  already: 'Already unsubscribed',
  invalid: 'Invalid link',
};

const messages = {
  success: "You won't receive any more emails. Sorry to see you go.",
  already: "You're already unsubscribed — no further action needed.",
  invalid: "This unsubscribe link isn't valid.",
};
---

<Layout title={`${titles[status]} — Devin Alexander`} noIndex>
  <main>
    <section class="unsub-page">
      <div class="unsub-inner">
        <div class="status-icon" data-status={status}>
          {status === 'invalid' ? (
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="10" />
              <path d="m15 9-6 6M9 9l6 6" />
            </svg>
          ) : (
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          )}
        </div>
        <h1 class="unsub-title">{titles[status]}</h1>
        <p class="unsub-message">{messages[status]}</p>
        <a href="/" class="back-link">Back to site</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .unsub-page {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-page-x);
  }

  .unsub-inner {
    text-align: center;
    max-width: 28rem;
  }

  .status-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    margin-bottom: 1.5rem;
    background: color-mix(in oklab, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .status-icon[data-status="invalid"] {
    background: color-mix(in oklab, var(--color-error) 12%, transparent);
    color: var(--color-error);
  }

  .unsub-title {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--color-text);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .unsub-message {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .back-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const roles = [
  {
    year: '2026',
    range: 'Present',
    status: 'active',
    statusLabel: 'Current',
    role: 'Fractional CMO (contract)',
    company: 'Jensen Business Advisory',
    description: 'Leading marketing and growth for David Lee Jensen\'s advisory firm and The 728 Network, an exclusive mastermind for entrepreneurs scaling past $1M. Building the GTM engine across consulting, community, and course products.',
    wins: [
      'Driving go-to-market strategy across advisory, mastermind, and course verticals',
      'Building growth systems for The 728 Network exclusive membership community',
      'Marketing to growth-stage founders doing $1M–$25M in revenue',
    ],
  },
  {
    year: '2025',
    range: '2026',
    status: 'past',
    statusLabel: '2025 – 2026',
    role: 'Chief Operating Officer',
    company: 'Andreou Enterprises',
    description: 'Joined as CMO of Bitmern Mining, promoted within a month to COO. Led a team of 9, ran marketing across the brand portfolio, and served as second-in-command in the Web3 and crypto space.',
    wins: [
      'Promoted from CMO to COO within 30 days of starting',
      'Built and led a cross-functional team of 9',
      'Ran marketing operations across the full Andreou brand portfolio',
    ],
  },
  {
    year: '2024',
    range: '2025',
    status: 'past',
    statusLabel: '2024 – 2025',
    role: 'Freelance Marketing Consultant',
    company: 'Independent',
    description: 'Relocated to South Africa and built bespoke growth systems across industries. Abandoned cookie-cutter funnels. Started treating each client like a custom suit.',
    wins: [
      'Built growth systems across 5+ industries simultaneously',
      'Designed full-stack GTM strategies tailored per client',
      'Developed a repeatable discovery process that cut onboarding time in half',
    ],
  },
  {
    year: '2022',
    range: '2024',
    status: 'past',
    statusLabel: '2022 – 2024',
    role: 'Head of Marketing',
    company: 'B2B Business Experts → Revenx',
    description: 'Took a leap on a two-person startup and helped scale it from $30K/month to $300K/month in revenue. Named and designed the rebrand to Revenx as we pivoted to insurance marketing.',
    wins: [
      'Scaled revenue from $30K/mo to $300K/mo, a 10× increase',
      'Led full company rebrand: naming, identity, and website rebuild',
      'Built a customer training platform and grew the team from 2 to 8',
    ],
  },
  {
    year: '2021',
    range: '2022',
    status: 'past',
    statusLabel: '2021 – 2022',
    role: 'VP Marketing & Operations',
    company: 'ContentOne (Richter)',
    description: 'Led promotion and production for a B2B SMB subsidiary. Transformed scattered processes into streamlined production systems using automation across Dropbox, DocuSign, Monday.com, and Zapier.',
    wins: [
      'Built automation workflows that eliminated 20+ hours of manual work weekly',
      'Streamlined production pipeline across 4 major platforms',
      'Drove measurable efficiency gains across the marketing operation',
    ],
  },
  {
    year: '2019',
    range: '2021',
    status: 'past',
    statusLabel: '2019 – 2021',
    role: 'VP of Marketing',
    company: 'Richter',
    description: 'Pitched myself for the role and got it. Richter had 40+ Fortune 500 clients on their roster. Launched thought leadership forums, podcasts, and more, touching nearly every part of the marketing lifecycle.',
    wins: [
      'Marketing lead for a firm serving 40+ Fortune 500 clients',
      'Launched thought leadership forums and podcast series',
      'Orchestrated campaigns spanning the full marketing lifecycle',
    ],
  },
  {
    year: '2019',
    range: '2019',
    status: 'past',
    statusLabel: '2019',
    role: 'VP',
    company: 'The Customer Factory',
    description: 'Promoted to lead the company\'s own marketing to chiropractors. Built lead magnets attracting hundreds of doctors weekly and activated consulting partners.',
    wins: [
      'Drove the highest new business and growth in company history',
      'Built lead magnets attracting hundreds of doctors weekly',
      'Cultivated referral relationships that became a revenue engine',
    ],
  },
  {
    year: '2018',
    range: '2019',
    status: 'past',
    statusLabel: '2018 – 2019',
    role: 'Creative Director',
    company: 'The Customer Factory',
    description: 'Chiropractic marketing for 100+ practices. Moved to Atlanta and learned that marketing isn\'t just "if this, then that." There are far more variables in the equation.',
    wins: [
      'Managed marketing for 100+ chiropractic practices simultaneously',
      'Developed strategic customer acquisition frameworks beyond template funnels',
    ],
  },
  {
    year: '2016',
    range: '2018',
    status: 'past',
    statusLabel: '2016 – 2018',
    role: 'Junior Advertiser',
    company: 'Flood Media',
    description: 'Where it all began. Learned the fundamentals of Google Ads and digital advertising, then worked remotely from England. Discovered the systematic logic of advertising, a foundation that still guides my thinking.',
    wins: [
      'Mastered Google Ads fundamentals and digital campaign management',
      'Transitioned to remote work across international time zones',
    ],
  },
];
---

<Layout title="Work — Devin Alexander" description="A decade of building at the intersections of marketing, operations, and design." image="/og/work.png">
  <main>
    <section class="work-page">
      <div class="work-inner">
        <header class="page-header">
          <div class="section-tag"><span class="tag-number">01</span><span class="tag-dash" aria-hidden="true"></span><span class="tag-label">Career</span></div>
          <h1 class="page-title">Work</h1>
          <p class="page-subtitle">A decade of building at the intersections of <span class="sub-accent teal">marketing</span>, <span class="sub-accent amber">operations</span>, and <span class="sub-accent rust">design</span>.</p>
        </header>

        <ol class="roles">
          {roles.map((r, i) => (
            <li class:list={['role-card', { featured: i === 0 }]} style={`--delay: ${i * 0.1}s`}>
              <span class="card-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

              <div class="role-top">
                <div class="role-year">
                  <span class="year-big" aria-hidden="true">{r.year}</span>
                  <span class="year-range">{r.range}</span>
                </div>
                <div class="role-status">
                  <span class:list={['status-dot', r.status]} aria-hidden="true" />
                  <span class="status-label">{r.statusLabel}</span>
                </div>
              </div>

              <h2 class="role-title">{r.role}</h2>
              <span class="role-company">{r.company}</span>
              <p class="role-description">{r.description}</p>

              <div class="role-wins">
                <span class="wins-label">Key wins</span>
                <ul class="wins-list">
                  {r.wins.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>

        <div class="page-footer">
          <a href="/" class="back-link">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 7H1M6 2L1 7l5 5" />
            </svg>
            Back home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { animate, inView } from 'motion';

  const isVtNav = window.__vtNav;

  // Header reveal
  const header = document.querySelector('.page-header');
  const cards = document.querySelectorAll('.role-card');

  if (!isVtNav) {
    // Initial opacity:0 is set via CSS (html.js-ready selector). Motion's
    // keyframe arrays carry the entrance transform.
    if (header) {
      inView(header, () => {
        animate(header, { opacity: [0, 1], y: [12, 0] }, {
          duration: 0.4,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.3 });
    }

    cards.forEach(card => {
      inView(card, () => {
        animate(card, { opacity: [0, 1], y: [15, 0] }, {
          duration: 0.4,
          easing: [0.25, 1, 0.5, 1],
        });
      }, { amount: 0.15 });
    });
  }

  // Spring hover — lift card + shift title
  cards.forEach(card => {

    // Spring hover — lift card + shift title
    card.addEventListener('mouseenter', () => {
      const title = card.querySelector('.role-title');
      animate(card, { y: -4 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
      if (title) animate(title, { x: 4 }, { duration: 0.15, easing: [0.34, 1.56, 0.64, 1] });
    });
    card.addEventListener('mouseleave', () => {
      const title = card.querySelector('.role-title');
      animate(card, { y: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
      if (title) animate(title, { x: 0 }, { duration: 0.25, easing: [0.16, 1, 0.3, 1] });
    });
  });
</script>

<style>
  /* Pre-hide elements JS will fade in (Layout.astro adds .js-ready before paint). */
  html.js-ready .page-header,
  html.js-ready .role-card {
    opacity: 0;
  }

  .work-page {
    min-height: 100dvh;
    padding: var(--space-page-top) var(--space-page-x) var(--space-page-bottom);
    background: var(--color-bg);
  }

  .work-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Section tag ---- */
  .section-tag {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .tag-number {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-accent-teal);
  }

  .tag-dash {
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-teal), transparent);
  }

  .tag-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Header ---- */
  .page-header {
    margin-bottom: var(--space-block-lg);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  .page-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0;
  }

  .sub-accent.teal { color: var(--color-accent-teal); font-style: normal; }
  .sub-accent.amber { color: var(--color-accent-amber); font-style: normal; }
  .sub-accent.rust { color: var(--color-accent-rust); font-style: normal; }

  /* ---- Roles list ---- */
  .roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ---- Role card base ---- */
  .role-card {
    position: relative;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 2px solid transparent;
    overflow: hidden;
    transition: background-color var(--duration-fast) var(--ease-out-expo),
                border-left-color var(--duration-fast) var(--ease-out-expo);
  }

  .role-card:hover {
    background-color: color-mix(in oklab, var(--color-text-muted) 3%, transparent);
  }

  .role-card:nth-child(1):hover { border-left-color: var(--color-accent-teal); }
  .role-card:nth-child(2):hover { border-left-color: var(--color-accent-amber); }
  .role-card:nth-child(3):hover { border-left-color: var(--color-accent-rust); }
  .role-card:nth-child(4):hover { border-left-color: var(--color-accent-teal); }
  .role-card:nth-child(5):hover { border-left-color: var(--color-accent-amber); }
  .role-card:nth-child(6):hover { border-left-color: var(--color-accent-rust); }
  .role-card:nth-child(7):hover { border-left-color: var(--color-accent-teal); }
  .role-card:nth-child(8):hover { border-left-color: var(--color-accent-amber); }

  .role-card + .role-card {
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
  }

  /* ---- Featured card (first role) ---- */
  .role-card.featured {
    padding: clamp(2.5rem, 5vw, 3.5rem);
    padding-left: clamp(2.5rem, 5vw, 3.5rem);
    border-left: none;
    border: 1px solid color-mix(in oklab, var(--color-text-muted) 12%, transparent);
    border-top: 2px solid var(--color-accent-teal);
    margin-bottom: var(--space-block);
    transition: border-color var(--duration-fast) var(--ease-out-expo),
                background-color var(--duration-fast) var(--ease-out-expo);
  }

  .role-card.featured:hover {
    border-top-color: var(--color-accent-teal);
  }

  .role-card.featured + .role-card {
    border-top: none;
  }

  .role-card.featured .role-title {
    font-size: var(--text-2xl);
  }

  .role-card.featured .year-big {
    font-size: var(--text-3xl);
  }

  /* ---- Ghost index number ---- */
  .card-index {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
    opacity: 0.04;
    pointer-events: none;
    color: var(--color-text);
  }

  .role-card.featured .card-index {
    font-size: var(--text-4xl);
    color: var(--color-accent-teal);
    opacity: 0.06;
  }

  /* ---- Year + status ---- */
  .role-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-card);
    position: relative;
    z-index: 1;
  }

  .role-year {
    display: flex;
    flex-direction: column;
  }

  .year-big {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent-teal);
    opacity: 0.25;
  }

  .role-card:nth-child(2) .year-big { color: var(--color-accent-amber); }
  .role-card:nth-child(3) .year-big { color: var(--color-accent-rust); }
  .role-card:nth-child(4) .year-big { color: var(--color-accent-teal); }
  .role-card:nth-child(5) .year-big { color: var(--color-accent-amber); }
  .role-card:nth-child(6) .year-big { color: var(--color-accent-rust); }
  .role-card:nth-child(7) .year-big { color: var(--color-accent-teal); }
  .role-card:nth-child(8) .year-big { color: var(--color-accent-amber); }

  .year-range {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 0.35rem;
  }

  .role-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-muted);
    opacity: 0.4;
  }

  .status-dot.active {
    background: var(--color-accent-teal);
    opacity: 1;
  }

  .status-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---- Role content ---- */
  .role-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 0.5rem;
    position: relative;
    z-index: 1;
  }

  .role-company {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    position: relative;
    z-index: 1;
  }

  .role-description {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 1rem 0 0;
    position: relative;
    z-index: 1;
  }

  /* ---- Wins ---- */
  .role-wins {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    position: relative;
    z-index: 1;
  }

  .wins-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wins-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wins-list li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text);
    padding-left: 1rem;
    position: relative;
  }

  .wins-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-teal);
    opacity: 0.7;
  }

  .role-card:nth-child(2) .wins-list li::before { background: var(--color-accent-amber); }
  .role-card:nth-child(3) .wins-list li::before { background: var(--color-accent-rust); }
  .role-card:nth-child(4) .wins-list li::before { background: var(--color-accent-teal); }
  .role-card:nth-child(5) .wins-list li::before { background: var(--color-accent-amber); }
  .role-card:nth-child(6) .wins-list li::before { background: var(--color-accent-rust); }
  .role-card:nth-child(7) .wins-list li::before { background: var(--color-accent-teal); }
  .role-card:nth-child(8) .wins-list li::before { background: var(--color-accent-amber); }

  /* ---- Footer ---- */
  .page-footer {
    margin-top: var(--space-block-lg);
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-text-muted) 15%, transparent);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link svg {
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }
</style>
